/-! # Modulated groups and their canonical Haar measures -/

@[expose] public noncomputable section

namespace RiemannMasullo

open Filter Function MeasureTheory NumberField Set
open scoped NNReal

section Modulation

variable {G : Type*} [CommGroup G] [TopologicalSpace G]
  [IsTopologicalGroup G] [T2Space G] [LocallyCompactSpace G] [SecondCountableTopology G]

/-- Paper: Definition D.2.1.1, p. 793. A modulation of a second-countable locally
compact Hausdorff abelian group is a nontrivial proper continuous homomorphism
to the positive reals. Its norm-one group and image are the kernel and range. -/
def IsModulation (m : G →ₜ* ℝ≥0ˣ) : Prop :=
  IsProperMap m ∧ ∃ g, m g ≠ 1

/-- Paper: Definition D.2.1.1, p. 793. A modulation satisfies the properness
and nontriviality hypotheses of the norm-twist constructions in §3.1. -/
theorem IsModulation.normTwistHypotheses {m : G →ₜ* ℝ≥0ˣ} (hm : IsModulation m) :
    IsProperMap m.toMonoidHom ∧ ∃ g, m.toMonoidHom g ≠ 1 :=
  hm

/-- Paper: Remark D.2.1.2, p. 793. The idele class norm is a surjective
modulation of the global idele class group. -/
theorem exists_ideleClassModulation (F : Type*) [Field F] [NumberField F] :
    ∃ m : IdeleClassGroup (𝓞 F) F →ₜ* ℝ≥0ˣ,
      m.toMonoidHom = ideleClassNorm F ∧ IsModulation m ∧ Surjective m := by
  have hproper := isProperMap_ideleClassNorm F
  let m : IdeleClassGroup (𝓞 F) F →ₜ* ℝ≥0ˣ := ⟨ideleClassNorm F, hproper.continuous⟩
  obtain ⟨_, _, _, _, _, _, _, _, _, hsurj, _⟩ := ideleGroup_quotient.{_, 0} F
  obtain ⟨t, ht⟩ := exists_ne (1 : ℝ≥0ˣ)
  obtain ⟨g, hg⟩ := hsurj t
  exact ⟨m, rfl, ⟨hproper, ⟨g, fun h ↦ ht (hg.symm.trans h)⟩⟩, hsurj⟩

/-- Paper: Definition D.2.1.1(1), p. 793. The norm-one subgroup is compact. -/
theorem IsModulation.isCompact_ker {m : G →ₜ* ℝ≥0ˣ} (hm : IsModulation m) :
    IsCompact (m.toMonoidHom.ker : Set G) := by
  exact hm.1.isCompact_preimage (isCompact_singleton (x := 1))

/-- Paper: Definition D.2.1.1, p. 793. The image of the module is closed. -/
theorem IsModulation.isClosed_range {m : G →ₜ* ℝ≥0ˣ} (hm : IsModulation m) :
    IsClosed (m.toMonoidHom.range : Set ℝ≥0ˣ) := by
  exact hm.1.isClosed_range

open LinearOrderedCommGroup in
/-- Paper: Remark D.2.1.2, p. 793. A nonsurjective module has infinite cyclic
image generated by a unique positive real greater than one. -/
theorem IsModulation.range_eq_zpowers {m : G →ₜ* ℝ≥0ˣ}
    (hm : IsModulation m) (hns : ¬ Surjective m) :
    ∃! t : ℝ≥0ˣ, 1 < (t.val : ℝ) ∧ m.toMonoidHom.range = Subgroup.zpowers t := by
  let e : ℝ≥0ˣ ≃ₜ Set.Ioi (0 : ℝ) := Nonneg.unitsHomeomorphPos ℝ
  have : OrderTopology ℝ≥0ˣ := ⟨e.isInducing.eq_induced.trans
    ((show StrictMono e from fun _ _ h ↦ h).induced_topology_eq_preorder
      (e.surjective.range_eq ▸ Set.ordConnected_univ))⟩
  let H := m.toMonoidHom.range
  have hclosed : IsClosed (H : Set ℝ≥0ˣ) := hm.1.isClosed_range
  have hnd : ¬ Dense (H : Set ℝ≥0ˣ) := by
    intro hd
    exact hns (Set.range_eq_univ.mp (hclosed.closure_eq.symm.trans hd.closure_eq))
  have : IsCyclic H := H.dense_or_isCyclic.resolve_left hnd
  have : Nontrivial H := by
    obtain ⟨g, hg⟩ := hm.2
    exact ⟨m.toMonoidHom.rangeRestrict g, 1, fun h ↦ hg (congrArg Subtype.val h)⟩
  -- Mathlib chooses the generator below one. Its inverse is the generator above one.
  let a := H.genLTOne
  have ha : a < 1 := H.genLTOne_lt_one
  have heq : Subgroup.zpowers a = H := H.genLTOne_zpowers_eq_top
  refine ⟨a⁻¹, ⟨show (1 : ℝ≥0ˣ) < a⁻¹ from one_lt_inv'.mpr ha, ?_⟩, ?_⟩
  · rw [Subgroup.zpowers_inv, heq]
  · rintro t ⟨ht, he⟩
    have ht' : t⁻¹ < 1 := inv_lt_one'.mpr (show 1 < t from ht)
    have hgen : t⁻¹ = a := H.genLTOne_unique ht'
      (by simpa only [Subgroup.zpowers_inv] using he.symm)
    exact inv_injective (by simpa using hgen)

/-- Paper: Remark D.2.1.2, p. 793. A module has a continuous homomorphic section
on its image. -/
theorem IsModulation.exists_section {m : G →ₜ* ℝ≥0ˣ} (hm : IsModulation m) :
    ∃ τ : m.toMonoidHom.range →ₜ* G, ∀ t, m (τ t) = (t : ℝ≥0ˣ) := by sorry

/-- Paper: Remark D.2.1.2, p. 793. Each section identifies the product of the
norm-one subgroup and the image of the module with the original group. -/
theorem IsModulation.exists_prod_equiv {m : G →ₜ* ℝ≥0ˣ} (hm : IsModulation m)
    (τ : m.toMonoidHom.range →ₜ* G) (hτ : ∀ t, m (τ t) = (t : ℝ≥0ˣ)) :
    ∃ e : (m.toMonoidHom.ker × m.toMonoidHom.range) ≃ₜ* G,
      ∀ k t, e (k, t) = (k : G) * τ t := by
  let r := m.toMonoidHom.rangeRestrict
  have hr : Continuous r := m.continuous.subtype_mk _
  have hsplit (k : m.toMonoidHom.ker) (t : m.toMonoidHom.range) : r ((k : G) * τ t) = t := by
    apply Subtype.ext
    change m ((k : G) * τ t) = (t : ℝ≥0ˣ)
    rw [map_mul, hτ, show m k = 1 from k.property, one_mul]
  refine ⟨{ toFun := fun p ↦ (p.1 : G) * τ p.2
            invFun := fun g ↦ (⟨g / τ (r g), ?_⟩, r g)
            left_inv := ?_
            right_inv := ?_
            map_mul' := ?_
            continuous_toFun := ?_
            continuous_invFun := ?_ }, fun _ _ ↦ rfl⟩
  · change m (g / τ (r g)) = 1
    rw [map_div, hτ]
    exact div_self' (m g)
  · rintro ⟨k, t⟩
    apply Prod.ext
    · apply Subtype.ext
      change (k : G) * τ t / τ (r ((k : G) * τ t)) = k
      rw [hsplit, mul_div_cancel_right]
    · exact hsplit k t
  · intro g
    exact div_mul_cancel _ _
  · rintro ⟨k, t⟩ ⟨l, u⟩
    change ((k : G) * l) * τ (t * u) = ((k : G) * τ t) * ((l : G) * τ u)
    rw [map_mul]
    ac_rfl
  · fun_prop
  · exact (continuous_id.div' (τ.continuous.comp hr)).subtype_mk _ |>.prodMk hr

end Modulation

section CanonicalHaar

variable {G : Type*} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G]
  [T2Space G] [LocallyCompactSpace G] [SecondCountableTopology G]
  [MeasurableSpace G] [BorelSpace G]

/-- Paper: Definition D.2.1.1(2), p. 793. Exactly one Haar measure has mass
`2 log Λ + O(1)` on the inverse image of the closed interval from `Λ⁻¹` to `Λ`. -/
theorem existsUnique_canonicalModulatedHaar (m : G →ₜ* ℝ≥0ˣ) (hm : IsModulation m) :
    ∃! μ : Measure G, μ.IsHaarMeasure ∧
      (fun Λ : ℝ ↦ (μ {g | ((m g).val : ℝ) ∈ Icc Λ⁻¹ Λ}).toReal - 2 * Real.log Λ)
        =O[atTop] (fun _ ↦ (1 : ℝ)) := by sorry

/-- Paper: Definition D.2.1.1(2), p. 793. The canonical Haar measure is selected
by the logarithmic growth condition on symmetric module intervals. -/
def canonicalModulatedHaar (m : G →ₜ* ℝ≥0ˣ) (hm : IsModulation m) : Measure G :=
  Classical.choose (existsUnique_canonicalModulatedHaar m hm).exists

/-- Paper: Remark D.2.1.3, p. 793. Under a section of a surjective module,
the canonical measure is the pushforward of probability Haar measure on the
kernel times `dt/t`. -/
theorem canonicalModulatedHaar_eq_map_prod (m : G →ₜ* ℝ≥0ˣ) (hm : IsModulation m)
    (τ : ℝ≥0ˣ →ₜ* G) (hτ : RightInverse τ m)
    (μ₁ : Measure m.toMonoidHom.ker) [μ₁.IsHaarMeasure] (hμ₁ : μ₁ univ = 1) :
    canonicalModulatedHaar m hm =
      (μ₁.prod positiveRealHaar).map
        (fun z : m.toMonoidHom.ker × ℝ≥0ˣ ↦ (z.1 : G) * τ z.2) := by sorry

end CanonicalHaar

end RiemannMasullo
