/-! # Structure Theorem V: isotypic exhaustiveness

Masullo, §6.2, pp. 295–302. Finite sets of places index only the finite factors.
Every S-adelic space includes all archimedean places.
-/

@[expose] public noncomputable section

open Filter Function IsDedekindDomain MeasureTheory NumberField Topology
open scoped DirectSum NNReal NumberField.AdeleRing TensorProduct

namespace RiemannMasullo

set_option quotPrecheck false

variable {F : Type*} [Field F] [NumberField F]
variable {S T : Finset (HeightOneSpectrum (𝓞 F))}

local notation "V" => HeightOneSpectrum (𝓞 F)
local notation "Iₛ(" S ")" => (SAdeleRing F S)ˣ
local notation "Nₛ(" S ")" => (sIdeleNorm F S).ker
local notation "Jₛ(" S ")" => SIdeleQuotient F S
local notation "J₁(" S ")" => (sIdeleQuotientNorm F S).ker
local notation "C₁" => (ideleClassNorm F).ker
local notation "Picₛ(" S ")" => CommRing.Pic ((S : Set V).integer F)
local notation "ℬ(" R ")" => SchwartzBruhat (Multiplicative R)
local notation "ℬₛ(" S ")" => ℬ(SAdeleRing F S)
local notation "ℬ∞" => ℬ(InfiniteAdeleRing F)
local notation "Θₛ(" S ")" => SLocalAdelicThetaSpace F S
local notation "Θ𝔽" => GlobalAdelicThetaSpace F
local notation "Θₛω(" S ", " χ ")" => SLocalHomogeneousThetaSpace F S χ
local notation "Θ𝔽ω(" ω ")" => GlobalHomogeneousThetaSpace F ω
local notation "Kₛω(" S ", " χ ")" => LinearMap.ker (sLocalHomogeneousAdelicThetaLinearMap F S χ)
local notation "ρₛ(" S ")" => (existsUnique_sLocalThetaAction (F := F) (S := S)).exists.choose
local notation "ρ𝔽" => (existsUnique_globalThetaAction (F := F)).exists.choose

section Exhaustiveness

/-- Every additional place is generated by a single element over the S-integers:
the trivial Picard group makes the local presentation of the localization sequence trivial. -/
private theorem existsUnique_sLocalNormOneQuotientTransition_gen (hST : S ⊆ T)
    (hPic : Subsingleton Picₛ(S)) (v : V) (hvT : v ∈ T) (hvS : v ∉ S) :
    ∃ b : Fˣ, v.valuation F (b : F) = WithZero.exp 1 ∧
      ∀ w : V, w ∉ S → w ≠ v → w.valuation F (b : F) = 1 := by
  classical
  obtain ⟨j, hinj, -, -, hj⟩ := picard_localization_exact F S T hST
  obtain ⟨π, hπ⟩ := v.valuation_exists_uniformizer F
  have hπ0 : π ≠ 0 := by
    intro h; rw [h, map_zero] at hπ; exact WithZero.coe_ne_zero hπ.symm
  let p : V → Fˣ := fun w ↦ if w = v then (Units.mk0 π hπ0)⁻¹ else 1
  let x : (w : ↥(T \ S)) → (w.val.adicCompletion F)ˣ :=
    fun w ↦ Units.map (algebraMap F (w.val.adicCompletion F)).toMonoidHom (p w.val)
  have h1 := hj x
  have h2 : (QuotientGroup.mk (fun w ↦ QuotientGroup.mk (x w)) :
      _ ⧸ MonoidHom.range (sUnitLocalClasses F T (T \ S))) = 1 :=
    hinj ((hPic.elim _ _).trans (map_one j).symm)
  rw [QuotientGroup.eq_one_iff] at h2
  obtain ⟨u, hu⟩ := h2
  have hval (w : ↥(T \ S)) : w.val.valuation F ((u.val : Fˣ) : F) = w.val.valuation F (p w.val : F) := by
    have h3 := congrFun hu w
    change (QuotientGroup.mk _ : _ ⧸ _) = QuotientGroup.mk _ at h3
    rw [QuotientGroup.eq] at h3
    have h4 := (HeightOneSpectrum.adicCompletionIntegers.mem_units_iff_valued_eq_one).mp h3
    rw [Units.val_mul, Units.val_inv_eq_inv_val, map_mul, map_inv₀] at h4
    have h5 := (inv_mul_eq_one₀ ?_).mp h4
    · change Valued.v ((((u.val : Fˣ) : F)) : w.val.adicCompletion F) =
        Valued.v (((p w.val : F)) : w.val.adicCompletion F) at h5
      rwa [HeightOneSpectrum.valuedAdicCompletion_eq_valuation',
        HeightOneSpectrum.valuedAdicCompletion_eq_valuation'] at h5
    · simp
  refine ⟨u.val, ?_, fun w hwS hwv ↦ ?_⟩
  · have := hval ⟨v, Finset.mem_sdiff.mpr ⟨hvT, hvS⟩⟩
    rw [this]
    simp [p, hπ]
  · by_cases hwT : w ∈ T
    · have := hval ⟨w, Finset.mem_sdiff.mpr ⟨hwT, hwS⟩⟩
      rw [this]; simp [p, hwv]
    · exact u.property w hwT

/-- Restriction from T-adeles to S-adeles. -/
private theorem existsUnique_sLocalNormOneQuotientTransition_res (hST : S ⊆ T) :
    ∃ ρ : SAdeleRing F T →+* SAdeleRing F S, Continuous ρ ∧
      (∀ x, (ρ x).1 = x.1) ∧ (∀ x (v : S), (ρ x).2 v = x.2 ⟨v.val, hST v.property⟩) :=
  ⟨(RingHom.fst _ _).prod (RingHom.pi fun v : S ↦
      (Pi.evalRingHom (fun w : T ↦ w.val.adicCompletion F) ⟨v.val, hST v.property⟩).comp
        (RingHom.snd _ _)),
    show Continuous fun x : SAdeleRing F T ↦ (x.1, fun v : S ↦ x.2 ⟨v.val, hST v.property⟩) by
      fun_prop,
    fun _ ↦ rfl, fun _ _ ↦ rfl⟩

/-- The valuation of a unit of a local field is locally constant. -/
private theorem existsUnique_sLocalNormOneQuotientTransition_locconst {X : Type*}
    [TopologicalSpace X] (v : V) (f : X → (v.adicCompletion F)ˣ) (hf : Continuous f) (x : X) :
    ∀ᶠ y in 𝓝 x, Valued.v (f y : v.adicCompletion F) = Valued.v (f x : v.adicCompletion F) :=
  ((Units.continuous_val.comp hf).tendsto x).eventually
    (Valued.locally_const (by simp))

/-- A diagonal S-unit represents the identity S-idele class. -/
private theorem existsUnique_sLocalNormOneQuotientTransition_diag (a : Fˣ)
    (ha : a ∈ (S : Set V).unit F) :
    (QuotientGroup.mk (Units.map (algebraMap F (SAdeleRing F S)).toMonoidHom a) : Jₛ(S)) = 1 :=
  (sIdeleQuotient_mk_eq_one F S _).mpr ⟨Set.unitEquivUnitsInteger _ _ ⟨a, ha⟩, Units.ext rfl⟩

/-- Every representative of the identity S-idele class is a diagonal S-unit. -/
private theorem existsUnique_sLocalNormOneQuotientTransition_diag_inv (g : Iₛ(S))
    (hg : (QuotientGroup.mk g : Jₛ(S)) = 1) :
    ∃ a : Fˣ, a ∈ (S : Set V).unit F ∧
      g = Units.map (algebraMap F (SAdeleRing F S)).toMonoidHom a := by
  obtain ⟨u, rfl⟩ := (sIdeleQuotient_mk_eq_one F S g).mp hg
  exact ⟨((Set.unitEquivUnitsInteger _ _).symm u).val,
    ((Set.unitEquivUnitsInteger _ _).symm u).property, Units.ext rfl⟩

/-- Diagonal S-units have S-idelic norm one. -/
private theorem existsUnique_sLocalNormOneQuotientTransition_norm_diag (a : Fˣ)
    (ha : a ∈ (S : Set V).unit F) :
    sIdeleNorm F S (Units.map (algebraMap F (SAdeleRing F S)).toMonoidHom a) = 1 :=
  (sIdeleNorm_spec F S).2 (MonoidHom.mem_range.mpr ⟨Set.unitEquivUnitsInteger _ _ ⟨a, ha⟩, rfl⟩)

/-- Restricting a T-idele that is a unit at the places of T outside S keeps its norm. -/
private theorem existsUnique_sLocalNormOneQuotientTransition_norm_res (hST : S ⊆ T)
    (ρ : SAdeleRing F T →+* SAdeleRing F S)
    (hρ1 : ∀ x, (ρ x).1 = x.1) (hρ2 : ∀ x (v : S), (ρ x).2 v = x.2 ⟨v.val, hST v.property⟩)
    (h : Iₛ(T)) (hh : ∀ w : T, w.val ∉ S → Valued.v (h.val.2 w) = 1) :
    sIdeleNorm F S (Units.map ρ.toMonoidHom h) = sIdeleNorm F T h := by
  let H := sIdeleInsertion F T h
  have hH := sIdeleInsertion_apply F T h
  have hHi := sIdeleInsertion_apply F T h⁻¹
  have hinv : H⁻¹ = sIdeleInsertion F T h⁻¹ := (map_inv _ _).symm
  have hu : H ∈ Set.range (integralIdeleInsertion F S) := by
    rw [mem_range_integralIdeleInsertion]
    intro v hv
    by_cases hvT : v ∈ T
    · have h1 := hh ⟨v, hvT⟩ hv
      have h2 : Valued.v ((h⁻¹).val.2 ⟨v, hvT⟩) = 1 := by
        have := congrArg (fun x : SAdeleRing F T ↦ Valued.v (x.2 ⟨v, hvT⟩)) h.val_inv
        simp only [Prod.snd_mul, Pi.mul_apply, map_mul, h1, one_mul, Prod.snd_one,
          Pi.one_apply, map_one] at this
        exact this
      refine ⟨?_, ?_⟩
      · change Valued.v (H.val.2 v) ≤ 1
        rw [hH.2.1 ⟨v, hvT⟩, h1]
      · change Valued.v ((H⁻¹).val.2 v) ≤ 1
        rw [hinv, hHi.2.1 ⟨v, hvT⟩, h2]
    · refine ⟨?_, ?_⟩
      · rw [hH.2.2 v hvT]; exact one_mem _
      · change (H⁻¹).val.2 v ∈ _
        rw [hinv, hHi.2.2 v hvT]; exact one_mem _
  obtain ⟨u, hu⟩ := hu
  have hn := (sIdeleNorm_spec F S).1 u
  have hp : Units.map ((adeleProjection F S).comp (integralAdelesOutside F S).subtype).toMonoidHom u =
      Units.map ρ.toMonoidHom h := by
    apply Units.ext
    refine Prod.ext ?_ (funext fun v ↦ ?_)
    · change (integralIdeleInsertion F S u).val.1 = (ρ h.val).1
      rw [hu, hρ1, hH.1]
    · change (integralIdeleInsertion F S u).val.2 v.val = (ρ h.val).2 v
      rw [hu, hρ2, hH.2.1 ⟨v.val, hST v.property⟩]
  rw [← hp, ← hn]
  change ideleNorm F (integralIdeleInsertion F S u) = _
  rw [hu, ideleNorm_sIdeleInsertion]

/-- The transition homomorphism on ideles: divide by a global T-unit with the same
valuations at the places of T outside S, then restrict to S. -/
private theorem existsUnique_sLocalNormOneQuotientTransition_phi (hST : S ⊆ T)
    (hPic : Subsingleton Picₛ(S)) :
    ∃ φ : Iₛ(T) →* Iₛ(S), Continuous φ ∧
      (∀ g, sIdeleNorm F S (φ g) = sIdeleNorm F T g) ∧
      (∀ a : Fˣ, a ∈ (T : Set V).unit F →
        (QuotientGroup.mk (φ (Units.map (algebraMap F (SAdeleRing F T)).toMonoidHom a)) :
          Jₛ(S)) = 1) ∧
      (∀ g, (QuotientGroup.mk (φ g) : Jₛ(S)) = 1 →
        ∃ u ∈ relativeIntegralIdeleUnits F S T,
          (QuotientGroup.mk g : Jₛ(T)) = QuotientGroup.mk u) ∧
      (∀ u ∈ relativeIntegralIdeleUnits F S T, φ u = 1) ∧
      ∀ g : Iₛ(S), φ (Units.map (adeleProjection F T).toMonoidHom (sIdeleInsertion F S g)) = g := by
  classical
  obtain ⟨ρ, hρc, hρ1, hρ2⟩ := existsUnique_sLocalNormOneQuotientTransition_res (F := F) hST
  have hb : ∀ w : {w : T // w.val ∉ S}, ∃ b : Fˣ, w.1.val.valuation F (b : F) = WithZero.exp 1 ∧
      ∀ v : V, v ∉ S → v ≠ w.1.val → v.valuation F (b : F) = 1 := fun w ↦
    existsUnique_sLocalNormOneQuotientTransition_gen hST hPic w.1.val w.1.property w.2
  choose b hb1 hb2 using hb
  let ιT : Fˣ →* Iₛ(T) := Units.map (algebraMap F (SAdeleRing F T)).toMonoidHom
  let ιS : Fˣ →* Iₛ(S) := Units.map (algebraMap F (SAdeleRing F S)).toMonoidHom
  let ρU : Iₛ(T) →* Iₛ(S) := Units.map ρ.toMonoidHom
  have hρι (x : Fˣ) : ρU (ιT x) = ιS x :=
    Units.ext (Prod.ext (hρ1 _) (funext fun v ↦ hρ2 _ v))
  let ev (w : {w : T // w.val ∉ S}) : Iₛ(T) →* (w.1.val.adicCompletion F)ˣ :=
    Units.map ((Pi.evalRingHom (fun w : T ↦ w.val.adicCompletion F) w.1).comp
      (RingHom.snd _ _)).toMonoidHom
  let val (w : {w : T // w.val ∉ S}) : Iₛ(T) →* Multiplicative ℤ :=
    WithZero.unitsWithZeroEquiv.toMonoidHom.comp
      ((Units.map (Valued.v : Valuation (w.1.val.adicCompletion F) (WithZero (Multiplicative ℤ))).toMonoidWithZeroHom.toMonoidHom).comp
        (ev w))
  have K1 (w : {w : T // w.val ∉ S}) (g : Iₛ(T)) :
      ((val w g : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) = Valued.v (g.val.2 w.1) :=
    WithZero.coe_unitsWithZeroEquiv_eq_units_val _
  have K2 (w : {w : T // w.val ∉ S}) (x : Fˣ) :
      ((val w (ιT x) : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) = w.1.val.valuation F (x : F) := by
    rw [K1]
    exact HeightOneSpectrum.valuedAdicCompletion_eq_valuation' _ _
  let α : ({w : T // w.val ∉ S} → Multiplicative ℤ) →* Fˣ :=
    { toFun := fun n ↦ ∏ w, b w ^ (n w).toAdd
      map_one' := by simp
      map_mul' := fun m n ↦ by
        simp only [Pi.mul_apply, toAdd_mul, zpow_add, Finset.prod_mul_distrib] }
  let ν : Iₛ(T) →* ({w : T // w.val ∉ S} → Multiplicative ℤ) :=
    { toFun := fun g w ↦ val w g
      map_one' := funext fun w ↦ map_one (val w)
      map_mul' := fun x y ↦ funext fun w ↦ map_mul (val w) x y }
  have hαval (n : {w : T // w.val ∉ S} → Multiplicative ℤ) (v : V) :
      v.valuation F ((α n : Fˣ) : F) =
        ∏ w, v.valuation F (b w : F) ^ (n w).toAdd := by
    change v.valuation F (((∏ w, b w ^ (n w).toAdd : Fˣ)) : F) = _
    rw [Units.coe_prod, map_prod]
    refine Finset.prod_congr rfl fun w _ ↦ ?_
    rw [Units.val_zpow_eq_zpow_val, map_zpow₀]
  have K3a (n : {w : T // w.val ∉ S} → Multiplicative ℤ) (w : {w : T // w.val ∉ S}) :
      w.1.val.valuation F ((α n : Fˣ) : F) = ((n w : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
    rw [hαval, Finset.prod_eq_single w]
    · rw [hb1, ← WithZero.exp_zsmul, smul_eq_mul, mul_one]; rfl
    · intro w' _ hw'
      rw [hb2 w' _ w.2 (fun h ↦ hw' (Subtype.ext (Subtype.ext h.symm))), one_zpow]
    · simp
  have K3b (n : {w : T // w.val ∉ S} → Multiplicative ℤ) (v : V) (hv : v ∉ T) :
      v.valuation F ((α n : Fˣ) : F) = 1 := by
    rw [hαval]
    refine Finset.prod_eq_one fun w _ ↦ ?_
    rw [hb2 w v (fun h ↦ hv (hST h)) (fun h ↦ hv (h ▸ w.1.property)), one_zpow]
  have K5 (n : {w : T // w.val ∉ S} → Multiplicative ℤ) : α n ∈ (T : Set V).unit F :=
    fun v hv ↦ K3b n v hv
  have hvalα (g : Iₛ(T)) (w : {w : T // w.val ∉ S}) : val w (ιT (α (ν g))) = val w g := by
    apply WithZero.coe_injective
    rw [K2, K3a]
    rfl
  have hvalS (s : Fˣ) (hs : s ∈ (S : Set V).unit F) (w : {w : T // w.val ∉ S}) :
      val w (ιT s) = 1 := by
    apply WithZero.coe_injective
    rw [K2]
    exact hs w.1.val w.2
  have hval1 (g : Iₛ(T)) (w : {w : T // w.val ∉ S}) (h : Valued.v (g.val.2 w.1) = 1) :
      val w g = 1 := by
    apply WithZero.coe_injective
    rw [K1, h]
    rfl
  have hν1 (g : Iₛ(T)) (h : ∀ w : {w : T // w.val ∉ S}, Valued.v (g.val.2 w.1) = 1) :
      ν g = 1 := funext fun w ↦ hval1 g w (h w)
  have hSunit (y : Fˣ) (hy : y ∈ (T : Set V).unit F)
      (h : ∀ w : {w : T // w.val ∉ S}, val w (ιT y) = 1) : y ∈ (S : Set V).unit F := by
    intro v hv
    by_cases hvT : v ∈ T
    · have := K2 ⟨⟨v, hvT⟩, hv⟩ y
      rw [h] at this
      exact this.symm
    · exact hy v hvT
  let φ : Iₛ(T) →* Iₛ(S) := ρU * (ιS.comp (α.comp ν))⁻¹
  have hφ (g : Iₛ(T)) : φ g = ρU (g * (ιT (α (ν g)))⁻¹) := by
    rw [map_mul, map_inv, hρι]; rfl
  have hval_ψ (g : Iₛ(T)) (w : {w : T // w.val ∉ S}) :
      val w (g * (ιT (α (ν g)))⁻¹) = 1 := by
    rw [map_mul, map_inv, hvalα, mul_inv_cancel]
  have hTunit (g : Iₛ(T)) (w : {w : T // w.val ∉ S}) :
      Valued.v ((g * (ιT (α (ν g)))⁻¹).val.2 w.1) = 1 := by
    rw [← K1, hval_ψ]; rfl
  refine ⟨φ, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- continuity: the correction factor is locally constant
    have hev (w : {w : T // w.val ∉ S}) : Continuous (ev w) :=
      Units.continuous_map (show Continuous fun x : SAdeleRing F T ↦ x.2 w.1 by fun_prop)
    have hlc : IsLocallyConstant ν := by
      rw [IsLocallyConstant.iff_eventually_eq]
      intro x
      have hall : ∀ᶠ y in 𝓝 x, ∀ w, val w y = val w x := by
        rw [Filter.eventually_all]
        intro w
        filter_upwards [existsUnique_sLocalNormOneQuotientTransition_locconst w.1.val (ev w)
          (hev w) x] with y hy
        apply WithZero.coe_injective
        rw [K1, K1]
        exact hy
      filter_upwards [hall] with y hy
      exact funext hy
    have h2 : Continuous fun g ↦ (ιS.comp (α.comp ν))⁻¹ g :=
      (hlc.comp fun n ↦ (ιS (α n))⁻¹).continuous
    exact (Units.continuous_map hρc).mul h2
  · intro g
    rw [hφ, existsUnique_sLocalNormOneQuotientTransition_norm_res hST ρ hρ1 hρ2 _
      (fun w hw ↦ hTunit g ⟨w, hw⟩), map_mul, map_inv,
      existsUnique_sLocalNormOneQuotientTransition_norm_diag _ (K5 _), inv_one, mul_one]
  · intro a ha
    rw [hφ, ← map_inv, ← map_mul, hρι]
    apply existsUnique_sLocalNormOneQuotientTransition_diag
    refine hSunit _ (mul_mem ha (inv_mem (K5 _))) fun w ↦ ?_
    rw [map_mul, map_inv]
    exact hval_ψ _ w
  · intro g hg
    obtain ⟨s, hs, hgs⟩ := existsUnique_sLocalNormOneQuotientTransition_diag_inv _ hg
    have hsT : s ∈ (T : Set V).unit F := fun v hv ↦ hs v (fun h ↦ hv (hST h))
    let u := g * (ιT (α (ν g) * s))⁻¹
    have hρu : ρU u = 1 := by
      have h1 : ρU g = ιS (α (ν g) * s) := by
        have := hgs
        change ρU g * (ιS (α (ν g)))⁻¹ = ιS s at this
        rw [map_mul, ← this, mul_comm, inv_mul_cancel_right]
      simp only [u, map_mul, map_inv, hρι, h1, mul_inv_cancel]
    have hvu (w : {w : T // w.val ∉ S}) : val w u = 1 := by
      simp only [u, map_mul, map_inv, hvalα, hvalS s hs, mul_one, mul_inv_cancel]
    have hvu' (w : {w : T // w.val ∉ S}) : Valued.v (u.val.2 w.1) = 1 := by
      rw [← K1, hvu]; rfl
    have hvui (w : {w : T // w.val ∉ S}) : Valued.v ((u⁻¹).val.2 w.1) = 1 := by
      rw [← K1, map_inv, hvu, inv_one]; rfl
    refine ⟨u, (mem_relativeIntegralIdeleUnits_iff u).mpr ⟨?_, ?_, ?_⟩, ?_⟩
    · exact (hρ1 u.val).symm.trans (congrArg (fun z : Iₛ(S) ↦ z.val.1) hρu)
    · intro w hw
      exact (hρ2 u.val ⟨w.val, hw⟩).symm.trans (congrArg (fun z : Iₛ(S) ↦ z.val.2 ⟨w.val, hw⟩) hρu)
    · intro w hw
      exact ⟨show Valued.v (u.val.2 w) ≤ 1 from (hvu' ⟨w, hw⟩).le,
        show Valued.v ((u⁻¹).val.2 w) ≤ 1 from (hvui ⟨w, hw⟩).le⟩
    · have hd := existsUnique_sLocalNormOneQuotientTransition_diag (S := T) _
        (mul_mem (K5 (ν g)) hsT)
      change (QuotientGroup.mk g : Jₛ(T)) = QuotientGroup.mk (g * (ιT (α (ν g) * s))⁻¹)
      rw [QuotientGroup.mk_mul, QuotientGroup.mk_inv]
      change _ = _ * (QuotientGroup.mk (ιT (α (ν g) * s)) : Jₛ(T))⁻¹
      rw [hd, inv_one, mul_one]
  · intro u hu
    obtain ⟨h1, h2, h3⟩ := (mem_relativeIntegralIdeleUnits_iff u).mp hu
    have hν : ν u = 1 := hν1 u fun w ↦
      (HeightOneSpectrum.adicCompletionIntegers.mem_units_iff_valued_eq_one
        (a := ev w u)).mp ⟨(h3 w.1 w.2).1, (h3 w.1 w.2).2⟩
    change ρU u * (ιS (α (ν u)))⁻¹ = 1
    rw [hν, map_one, map_one, inv_one, mul_one]
    exact Units.ext (Prod.ext ((hρ1 _).trans h1) (funext fun v ↦ (hρ2 _ v).trans (h2 _ v.property)))
  · intro g
    have hH := sIdeleInsertion_apply F S g
    have hν : ν (Units.map (adeleProjection F T).toMonoidHom (sIdeleInsertion F S g)) = 1 :=
      hν1 _ fun w ↦ by
        change Valued.v ((sIdeleInsertion F S g).val.2 w.1.val) = 1
        rw [hH.2.2 _ w.2, map_one]
    change ρU _ * (ιS (α (ν _)))⁻¹ = g
    rw [hν, map_one, map_one, inv_one, mul_one]
    exact Units.ext (Prod.ext ((hρ1 _).trans hH.1) (funext fun v ↦ (hρ2 _ v).trans (hH.2.1 v)))

/-- Two homomorphisms agreeing along a map onto representatives and having the same
kernel elements agree. -/
private theorem existsUnique_sLocalNormOneQuotientTransition_uniq {A B N : Type*}
    [Group A] [Group B] (q q' : A →* B) (t : N → A) (π : N → B)
    (hs : ∀ x, ∃ n, q x = π n) (hqt : ∀ n, q (t n) = π n) (hq't : ∀ n, q' (t n) = π n)
    (hk : ∀ x, q x = 1 → q' x = 1) (x : A) : q' x = q x := by
  obtain ⟨n, hn⟩ := hs x
  have h1 : q (x * (t n)⁻¹) = 1 := by rw [map_mul, map_inv, hn, hqt, mul_inv_cancel]
  have h4 : q' x = q' (x * (t n)⁻¹) * q' (t n) := by rw [← map_mul, inv_mul_cancel_right]
  rw [h4, hk _ h1, hq't, one_mul, hn]

open scoped Pointwise in
/-- A homomorphism through which an open surjection factors, along a continuous map,
is open. -/
private theorem existsUnique_sLocalNormOneQuotientTransition_isOpenMap {A B N : Type*}
    [Group A] [Group B] [TopologicalSpace A] [IsTopologicalGroup A] [TopologicalSpace B]
    [TopologicalSpace N] (q : A →* B) (t : N → A) (π : N → B) (ht : Continuous t)
    (hπ : IsOpenMap π) (hπs : Surjective π) (h : ∀ n, q (t n) = π n) : IsOpenMap q := by
  intro U hU
  have he : q '' U = π '' (t ⁻¹' (U * (q.ker : Set A))) := by
    ext y
    constructor
    · rintro ⟨u, hu, rfl⟩
      obtain ⟨n, hn⟩ := hπs (q u)
      refine ⟨n, ⟨u, hu, u⁻¹ * t n, ?_, by group⟩, hn⟩
      change q (u⁻¹ * t n) = 1
      rw [map_mul, map_inv, h, hn, inv_mul_cancel]
    · rintro ⟨n, ⟨a, ha, k, hk, he⟩, rfl⟩
      refine ⟨a, ha, ?_⟩
      have hk' : q k = 1 := hk
      rw [← h, ← he, map_mul, hk', mul_one]
  rw [he]
  exact hπ _ (hU.mul_right.preimage ht)

/-- Paper: (6.2.1.1), p. 297.
The norm-one quotient at T maps openly onto the norm-one quotient at S when the
S-integer Picard group is trivial. Its kernel is the image of the integral units at
the additional places, and the map reverses insertion on representatives at S. -/
theorem existsUnique_sLocalNormOneQuotientTransition (hST : S ⊂ T)
    (_hPic : Subsingleton Picₛ(S)) :
    ∃! q : J₁(T) →ₜ* J₁(S), Surjective q ∧ IsOpenMap q ∧
      (∀ x : J₁(T), q x = 1 ↔
        ∃ u : relativeIntegralIdeleUnits F S T, x.val = QuotientGroup.mk u.val) ∧
      ∀ (g : Nₛ(S)) (x : J₁(T)) (y : J₁(S)),
        x.val = QuotientGroup.mk (Units.map (adeleProjection F T).toMonoidHom
          (sIdeleInsertion F S g.val)) →
        y.val = QuotientGroup.mk g.val → q x = y := by
  classical
  obtain ⟨φ, hc, hn, hdiag, hker, hrel, hins⟩ :=
    existsUnique_sLocalNormOneQuotientTransition_phi hST.le _hPic
  let Φ : Jₛ(T) →* Jₛ(S) := QuotientGroup.lift _ ((QuotientGroup.mk' _).comp φ) (fun g hg ↦ by
    have h1 : (QuotientGroup.mk g : Jₛ(T)) = 1 := (QuotientGroup.eq_one_iff g).mpr hg
    obtain ⟨a, ha, rfl⟩ := existsUnique_sLocalNormOneQuotientTransition_diag_inv g h1
    exact (MonoidHom.mem_ker).mpr (hdiag a ha))
  have hΦ (g : Iₛ(T)) : Φ (QuotientGroup.mk g) = QuotientGroup.mk (φ g) := rfl
  have hΦc : Continuous Φ :=
    (QuotientGroup.isQuotientMap_mk _).continuous_iff.mpr (continuous_coinduced_rng.comp hc)
  have hΦn (x : Jₛ(T)) : sIdeleQuotientNorm F S (Φ x) = sIdeleQuotientNorm F T x := by
    induction x using QuotientGroup.induction_on with
    | H g => rw [hΦ, sIdeleQuotientNorm_mk, sIdeleQuotientNorm_mk, hn]
  let q0 : J₁(T) →* J₁(S) := (Φ.comp J₁(T).subtype).codRestrict J₁(S) (fun x ↦ by
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, hΦn]
    exact x.property)
  let q : J₁(T) →ₜ* J₁(S) := ⟨q0, by exact (hΦc.comp continuous_subtype_val).subtype_mk _⟩
  have hq (x : J₁(T)) : (q x).val = Φ x.val := rfl
  -- the insertion at the level of S-ideles, as a continuous map
  let ε0 : SAdeleRing F S →* SAdeleRing F T :=
    { toFun := fun x ↦ (x.1, fun w ↦ if h : w.val ∈ S then x.2 ⟨w.val, h⟩ else 1)
      map_one' := Prod.ext rfl (funext fun w ↦ by by_cases h : w.val ∈ S <;> simp [h])
      map_mul' := fun x y ↦ Prod.ext rfl (funext fun w ↦ by
        by_cases h : w.val ∈ S <;> simp [h]) }
  have hε0c : Continuous ε0 := by
    refine continuous_fst.prodMk (continuous_pi fun w ↦ ?_)
    by_cases h : w.val ∈ S
    · simp only [h, dite_true]
      exact (continuous_apply _).comp continuous_snd
    · simp only [h, dite_false]
      exact continuous_const
  have hε (g : Iₛ(S)) : Units.map ε0 g =
      Units.map (adeleProjection F T).toMonoidHom (sIdeleInsertion F S g) := by
    have hH := sIdeleInsertion_apply F S g
    apply Units.ext
    refine Prod.ext hH.1.symm (funext fun w ↦ ?_)
    change (if h : w.val ∈ S then g.val.2 ⟨w.val, h⟩ else 1) = (sIdeleInsertion F S g).val.2 w.val
    by_cases h : w.val ∈ S
    · simp only [h, ↓reduceDIte]; rw [hH.2.1 ⟨w.val, h⟩]
    · simp only [h, ↓reduceDIte]; rw [hH.2.2 w.val h]
  have hεn (g : Iₛ(S)) : sIdeleNorm F T (Units.map ε0 g) = sIdeleNorm F S g := by
    rw [← hn, hε, hins]
  let t : Nₛ(S) → J₁(T) := fun g ↦ ⟨QuotientGroup.mk (Units.map ε0 g.val), by
    rw [MonoidHom.mem_ker, sIdeleQuotientNorm_mk, hεn]; exact g.property⟩
  let π : Nₛ(S) → J₁(S) := fun g ↦ ⟨QuotientGroup.mk g.val, by
    rw [MonoidHom.mem_ker, sIdeleQuotientNorm_mk]; exact g.property⟩
  have hins' : ∀ (g : Nₛ(S)) (x : J₁(T)) (y : J₁(S)),
      x.val = QuotientGroup.mk (Units.map (adeleProjection F T).toMonoidHom
        (sIdeleInsertion F S g.val)) →
      y.val = QuotientGroup.mk g.val → q x = y := by
    intro g x y hx hy
    apply Subtype.ext
    rw [hq, hx, hy, hΦ, hins]
  have hqt (g : Nₛ(S)) : q (t g) = π g := hins' g _ _ (by
    change QuotientGroup.mk _ = _; rw [hε]) rfl
  have hπs : Surjective π := by
    intro y
    obtain ⟨g, hg⟩ := QuotientGroup.mk_surjective y.val
    have hgn : g ∈ Nₛ(S) := by
      rw [MonoidHom.mem_ker, ← sIdeleQuotientNorm_mk]
      change sIdeleQuotientNorm F S (QuotientGroup.mk g) = 1
      rw [hg]; exact y.property
    exact ⟨⟨g, hgn⟩, Subtype.ext hg⟩
  have hπo : IsOpenMap π := by
    intro O hO
    obtain ⟨W, hW, rfl⟩ : ∃ W : Set Iₛ(S), IsOpen W ∧ Subtype.val ⁻¹' W = O :=
      isOpen_induced_iff.mp hO
    have he : π '' (Subtype.val ⁻¹' W) =
        Subtype.val ⁻¹' ((QuotientGroup.mk : Iₛ(S) → Jₛ(S)) '' W) := by
      ext y
      constructor
      · rintro ⟨g, hg, rfl⟩
        exact ⟨g.val, hg, rfl⟩
      · rintro ⟨w, hw, hwy⟩
        have hwn : w ∈ Nₛ(S) := by
          rw [MonoidHom.mem_ker, ← sIdeleQuotientNorm_mk]
          change sIdeleQuotientNorm F S (QuotientGroup.mk w) = 1
          rw [hwy]; exact y.property
        exact ⟨⟨w, hwn⟩, hw, Subtype.ext hwy⟩
    rw [he]
    exact (QuotientGroup.isOpenMap_coe W hW).preimage continuous_subtype_val
  have htc : Continuous t :=
    (continuous_coinduced_rng.comp ((Units.continuous_map hε0c).comp
      continuous_subtype_val)).subtype_mk _
  have hkerq (x : J₁(T)) : q x = 1 ↔
      ∃ u : relativeIntegralIdeleUnits F S T, x.val = QuotientGroup.mk u.val := by
    obtain ⟨g, hg⟩ := QuotientGroup.mk_surjective x.val
    constructor
    · intro h
      have h1 : (QuotientGroup.mk (φ g) : Jₛ(S)) = 1 := by
        rw [← hΦ, hg, ← hq, h]; rfl
      obtain ⟨u, hu, hgu⟩ := hker g h1
      exact ⟨⟨u, hu⟩, hg.symm.trans hgu⟩
    · rintro ⟨u, hu⟩
      apply Subtype.ext
      rw [hq, hu, hΦ, hrel u.val u.property]
      rfl
  refine ⟨q, ⟨fun y ↦ (hπs y).elim fun g hg ↦ ⟨t g, (hqt g).trans hg⟩,
    existsUnique_sLocalNormOneQuotientTransition_isOpenMap q.toMonoidHom t π htc hπo hπs hqt,
    hkerq, hins'⟩, ?_⟩
  rintro q' ⟨-, -, hk', hi'⟩
  have hs (x : J₁(T)) : ∃ n, q x = π n := by
    obtain ⟨g, hg⟩ := QuotientGroup.mk_surjective x.val
    have hgn : φ g ∈ Nₛ(S) := by
      rw [MonoidHom.mem_ker, hn, ← sIdeleQuotientNorm_mk]
      change sIdeleQuotientNorm F T (QuotientGroup.mk g) = 1
      rw [hg]; exact x.property
    exact ⟨⟨φ g, hgn⟩, Subtype.ext (by rw [hq, ← hg, hΦ])⟩
  have hq't (n : Nₛ(S)) : q' (t n) = π n := hi' n (t n) (π n) (by
    change QuotientGroup.mk _ = _; rw [hε]) rfl
  have hk (x : J₁(T)) (h : q x = 1) : q' x = 1 := (hk' x).mpr ((hkerq x).mp h)
  clear_value q t π
  ext1 x
  exact existsUnique_sLocalNormOneQuotientTransition_uniq q.toMonoidHom q'.toMonoidHom t π
    hs hqt hq't hk x

/-- Paper: Theorem 6.2.1.1(1), p. 295.
For a T-local character trivial on the additional integer units, adjoining integer
indicators gives a surjective topological linear isomorphism on homogeneous classes.
The source character is the unique descent of the target character. -/
theorem sLocalHomogeneousThetaTransition_equiv_of_unramified
    (hST : S ⊂ T) (hPic : Subsingleton Picₛ(S)) (χ : PontryaginDual J₁(T))
    (_hχ : ∀ (x : J₁(T)) (u : relativeIntegralIdeleUnits F S T),
      x.val = QuotientGroup.mk u.val → χ x = 1) :
    let q := (existsUnique_sLocalNormOneQuotientTransition hST hPic).exists.choose
    ∃ (χS : PontryaginDual J₁(S)) (e : Θₛω(S, χS) ≃L[ℂ] Θₛω(T, χ)),
      (∀ x, χS (q x) = χ x) ∧
      ∀ f : ℬₛ(S), e ((Kₛω(S, χS)).mkQ f) =
        (Kₛω(T, χ)).mkQ (sAdeleSchwartzTransition F hST.le f) := by sorry

/-- The descended character at a larger stage kills the additional integral units:
use the same global lift to evaluate the descent identity at both stages. -/
private theorem sLocalHomogeneousThetaToGlobal_equiv_of_unramified_units
    (hST : S ⊆ T) {ω : PontryaginDual C₁} (hω : NormOneCharacterUnramifiedOutside ω S)
    (x : J₁(T)) (u : relativeIntegralIdeleUnits F S T) (hx : x.val = QuotientGroup.mk u.val) :
    sLocalNormOneCharacter T ω (hω.mono hST) x = 1 := by
  obtain ⟨g, hg, hgu⟩ := u.property
  obtain ⟨a, ha⟩ := hg.1
  have hp : Units.map (adeleProjection F S).toMonoidHom g = 1 := hg.2
  have hn : ideleNorm F g = 1 := by
    have h := (sIdeleNorm_spec F S).1 a
    change ideleNorm F (integralIdeleInsertion F S a) =
      sIdeleNorm F S (Units.map (adeleProjection F S).toMonoidHom (integralIdeleInsertion F S a)) at h
    rwa [ha, hp, map_one] at h
  let z : C₁ := ⟨QuotientGroup.mk g, hn⟩
  have hz := sLocalNormOneCharacter_apply ω hω a z 1 (congrArg QuotientGroup.mk ha.symm)
    (by rw [ha, hp]; rfl)
  have hb : g ∈ Set.range (integralIdeleInsertion F T) :=
    (mem_range_integralIdeleInsertion F T g).mpr (fun v hv ↦
      (mem_range_integralIdeleInsertion F S g).mp ⟨a, ha⟩ v (fun hs ↦ hv (hST hs)))
  obtain ⟨b, hb⟩ := hb
  exact (sLocalNormOneCharacter_apply ω (hω.mono hST) b z x (congrArg QuotientGroup.mk hb.symm)
    (by rw [hb, hgu]; exact hx)).trans (hz.symm.trans (map_one _))

/-- Surjectivity on homogeneous classes can be checked on test representatives, so no
identification of the two descriptions of the descended source character is needed. -/
private theorem sLocalHomogeneousThetaToGlobal_equiv_of_unramified_stage
    (hST : S ⊂ T) (hPic : Subsingleton Picₛ(S)) {ω : PontryaginDual C₁}
    (hω : NormOneCharacterUnramifiedOutside ω S) :
    Surjective (sLocalHomogeneousThetaTransition (ω := ω) hω hST.le) := by
  let χT := sLocalNormOneCharacter T ω (hω.mono hST.le)
  have hex := sLocalHomogeneousThetaTransition_equiv_of_unramified hST hPic χT
    (sLocalHomogeneousThetaToGlobal_equiv_of_unramified_units hST.le hω)
  with_reducible refine hex.elim fun χS hS ↦ ?_
  with_reducible refine hS.elim fun e he ↦ ?_
  intro y
  have hrep := (Kₛω(S, χS)).mkQ_surjective (e.symm y)
  with_reducible refine hrep.elim fun f hf ↦ ?_
  refine ⟨(Kₛω(S, sLocalNormOneCharacter S ω hω)).mkQ f, ?_⟩
  change (Kₛω(T, χT)).mkQ (sAdeleSchwartzTransition F hST.le f) = y
  with_reducible exact (he.2 f).symm.trans ((congrArg e hf).trans (e.apply_symm_apply y))

/-- A stage in an exhaustive family of closed embeddings exhausts the limit if its
transition to every strictly larger stage is surjective. -/
private theorem sLocalHomogeneousThetaToGlobal_equiv_of_unramified_of_limit
    {ι : Type*} [PartialOrder ι] {P : ι → Prop} (s : ι) (p : P s)
    (m : ∀ {t u}, P t → t ≤ u → P u) (X : (t : ι) → P t → Type*)
    [∀ t h, AddCommGroup (X t h)] [∀ t h, Module ℂ (X t h)] [∀ t h, TopologicalSpace (X t h)]
    {Y : Type*} [AddCommGroup Y] [Module ℂ Y] [TopologicalSpace Y]
    (i : ∀ t (q : P t), X t q →ₗ[ℂ] Y)
    (j : ∀ t u (q : P t) (h : t ≤ u), X t q →ₗ[ℂ] X u (m q h))
    (hs : ∀ t (h : s < t), Surjective (j s t p h.le))
    (hc : let I := {t : ι // s ≤ t}
      let q := fun t : I ↦ m p t.property
      let f := fun t : I ↦ i t.val (q t)
      (∀ t, IsClosedEmbedding (f t)) ∧
      (∀ (t u : I) (htu : t.val ≤ u.val), (f u).comp (j t u (q t) htu) = f t) ∧
      (∀ y, ∃ t x, f t x = y)) :
    ∃ e : X s p ≃L[ℂ] Y, e.toLinearMap = i s p := by
  have he := hc.1 ⟨s, le_rfl⟩
  have hi : Surjective (i s p) := by
    intro y
    obtain ⟨⟨t, ht⟩, x, rfl⟩ := hc.2.2 y
    rcases eq_or_lt_of_le ht with rfl | hlt
    · exact ⟨x, rfl⟩
    obtain ⟨z, rfl⟩ := hs t hlt x
    exact ⟨z, (LinearMap.congr_fun (hc.2.1 ⟨s, le_rfl⟩ ⟨t, ht⟩ ht) z).symm⟩
  let e := LinearEquiv.ofBijective (i s p) ⟨he.injective, hi⟩
  exact ⟨⟨e, he.continuous, (e.toEquiv.toHomeomorphOfIsInducing he.isInducing).symm.continuous⟩, rfl⟩

/-- Paper: Theorem 6.2.1.1(2), p. 295.
If the S-integer Picard group is trivial and the global character is unramified
outside S, the existing homogeneous insertion is a topological linear isomorphism. -/
theorem sLocalHomogeneousThetaToGlobal_equiv_of_unramified
    (_hPic : Subsingleton Picₛ(S)) {ω : PontryaginDual C₁}
    (hω : NormOneCharacterUnramifiedOutside ω S) :
    ∃ e : Θₛω(S, sLocalNormOneCharacter S ω hω) ≃L[ℂ] Θ𝔽ω(ω),
      e.toLinearMap = sLocalHomogeneousThetaToGlobal hω := by
  let X (T : Finset V) (q : NormOneCharacterUnramifiedOutside ω T) :=
    Θₛω(T, sLocalNormOneCharacter T ω q)
  have h := sLocalHomogeneousTheta_inductiveLimit (F := F) (S := S) (ω := ω) hω
  with_reducible
    exact sLocalHomogeneousThetaToGlobal_equiv_of_unramified_of_limit (Y := Θ𝔽ω(ω)) S hω
      (fun q h ↦ NormOneCharacterUnramifiedOutside.mono q h) X
      (fun T ↦ sLocalHomogeneousThetaToGlobal (F := F) (S := T) (ω := ω))
      (fun T U ↦ sLocalHomogeneousThetaTransition (F := F) (S := T) (T := U) (ω := ω))
      (fun t hst ↦ sLocalHomogeneousThetaToGlobal_equiv_of_unramified_stage
        (F := F) (S := S) (T := t) (ω := ω) hst _hPic hω) ⟨h.1, h.2.1, h.2.2.1⟩

/-- Paper: Corollary 6.2.1.2, p. 295.
Each global homogeneous theta quotient is a nuclear Fréchet space. -/
theorem globalHomogeneousThetaSpace_nuclearFrechet (ω : PontryaginDual C₁) :
    IsFrechetTVS Θ𝔽ω(ω) ∧ IsNuclearTVS Θ𝔽ω(ω) := by sorry

-- TODO(paper-gap): The proof of Lemma 6.2.1.3 repeats the componentwise-seminorm
-- error in ERRATA I125. Joint continuity of the action and compactness apply.

/-- Paper: Lemma 6.2.1.3(1), p. 296.
Convergence of a net of local theta classes implies uniform convergence of its orbit
maps over the compact norm-one quotient. -/
theorem sLocalThetaAction_tendstoUniformly {ι : Type*} (l : Filter ι)
    (f : ι → Θₛ(S)) (x : Θₛ(S)) (hf : Tendsto f l (𝓝 x)) :
    ∀ U ∈ 𝓝 (0 : Θₛ(S)), ∀ᶠ i in l, ∀ g : J₁(S),
      ρₛ(S) g.val (f i) - ρₛ(S) g.val x ∈ U := by
  have uniform {G X : Type _} [TopologicalSpace G] [AddCommGroup X] [TopologicalSpace X]
      [IsTopologicalAddGroup X] {K : Set G} (hK : IsCompact K)
      (A : G → X → X) (hA : Continuous (fun p : G × X ↦ A p.1 p.2))
      (u : ι → X) (v : X) (hu : Tendsto u l (𝓝 v)) (U : Set X) (hU : U ∈ 𝓝 0) :
      ∀ᶠ i in l, ∀ g ∈ K, A g (u i) - A g v ∈ U := by
    have hd : Continuous (fun p : X × G ↦ A p.2 p.1 - A p.2 v) :=
      (hA.comp (continuous_snd.prodMk continuous_fst)).sub
        (hA.comp (continuous_snd.prodMk continuous_const))
    exact hu.eventually (hK.eventually_forall_of_forall_eventually (P := fun y g ↦ A g y - A g v ∈ U)
      fun g _ ↦
        hd.continuousAt (x := (v, g)) (by simpa only [sub_self] using hU))
  let : PolynormableSpace ℂ (Θₛ(S)) := sLocalAdelicThetaSpace_polynormable
  let : IsTopologicalAddGroup (Θₛ(S)) := PolynormableSpace.isTopologicalAddGroup ℂ _
  have hc := (isProperMap_sIdeleQuotientNorm F S).isCompact_preimage
    (isCompact_singleton (x := (1 : ℝ≥0ˣ)))
  have hA := (existsUnique_sLocalThetaAction (F := F) (S := S)).exists.choose_spec.1
  intro U hU
  have h := uniform (G := Jₛ(S)) (X := Θₛ(S)) hc (fun g y ↦ ρₛ(S) g y) hA f x hf U hU
  exact h.mono fun i hi g ↦ hi g.val g.property

/-- Multiplication by scalars of norm at most one keeps uniform convergence of differences. -/
private theorem smul_sub_eventually_mem_of_norm_le_one {E ι κ : Type*} [AddCommGroup E]
    [Module ℂ E] [TopologicalSpace E] [ContinuousSMul ℂ E] (l : Filter ι) (u : ι → κ → E)
    (w : κ → E) (c : κ → ℂ) (hc : ∀ k, ‖c k‖ ≤ 1)
    (h : ∀ U ∈ 𝓝 (0 : E), ∀ᶠ i in l, ∀ k, u i k - w k ∈ U) :
    ∀ U ∈ 𝓝 (0 : E), ∀ᶠ i in l, ∀ k, c k • u i k - c k • w k ∈ U := by
  intro U hU
  obtain ⟨W, ⟨hW, hWb⟩, hWU⟩ := (nhds_basis_balanced ℂ E).mem_iff.mp hU
  filter_upwards [h W hW] with i hi k
  rw [← smul_sub]
  exact hWU (hWb.smul_mem (hc k) (hi k))

/-- Paper: Lemma 6.2.1.3(2), p. 296.
Uniform convergence over the norm-one quotient also holds after twisting the action
by a unitary character. -/
theorem sLocalThetaAction_twist_tendstoUniformly {ι : Type*} (l : Filter ι)
    (f : ι → Θₛ(S)) (x : Θₛ(S)) (hf : Tendsto f l (𝓝 x)) (χ : PontryaginDual J₁(S)) :
    ∀ U ∈ 𝓝 (0 : Θₛ(S)), ∀ᶠ i in l, ∀ g : J₁(S),
      (χ g : ℂ) • ρₛ(S) g.val (f i) - (χ g : ℂ) • ρₛ(S) g.val x ∈ U :=
  smul_sub_eventually_mem_of_norm_le_one l _ _ (fun g ↦ (χ g : ℂ))
    (fun g ↦ (Circle.norm_coe (χ g)).le) (sLocalThetaAction_tendstoUniformly l f x hf)

end Exhaustiveness

section IsotypicSums

local notation "ρₛ₁(" S ")" => (ρₛ(S)).comp (MonoidHom.ker (sIdeleQuotientNorm F S)).subtype
local notation "ρ𝔽₁" => (ρ𝔽).comp (MonoidHom.ker (ideleClassNorm F)).subtype
local notation "Eₛ(" χ ")" => actionIsotype (ρₛ₁(S)) χ
local notation "E𝔽(" ω ")" => actionIsotype ρ𝔽₁ ω

-- TODO(paper-gap): In Remark 6.2.1.4(1)–(2), neither local topology comparison is
-- strict for F = ℚ and the archimedean stage. Its norm-one quotient is trivial,
-- so both comparisons reduce to the topology on the sole isotype.
-- The global comparison can also be equality over ℚ: each finite test stage
-- factors through a finite quotient of the norm-one unit action.
-- The proof of strictness also assumes infinitely many everywhere unramified
-- characters, which fails over ℚ.

/-- A separating functional for the closed sum would give a nonzero continuous
matrix coefficient on the compact group with all Fourier coefficients zero. -/
private theorem sLocalThetaIsotypeSum_dense_aux {H E : Type*} [CommGroup H]
    [TopologicalSpace H] [IsTopologicalGroup H] (N : Subgroup H) [T2Space N] [CompactSpace N]
    [AddCommGroup E] [Module ℂ E] [TopologicalSpace E] [PolynormableSpace ℂ E] [T2Space E]
    [IsTopologicalAddGroup E] [ContinuousSMul ℂ E]
    (hc : @CompleteSpace E (IsTopologicalAddGroup.rightUniformSpace E))
    (σ : H →* (E →L[ℂ] E)) (hσ : Continuous fun p : H × E ↦ σ p.1 p.2) :
    let X := fun χ : PontryaginDual N ↦ ↥(actionIsotype (σ.comp N.subtype) χ)
    letI := Classical.decEq (PontryaginDual N)
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ _ X)
    let i := DirectSum.toModule ℂ _ E (fun χ ↦ (actionIsotype (σ.comp N.subtype) χ).subtype)
    Continuous i ∧ Injective i ∧ DenseRange i := by
  classical
  let ρ := σ.comp N.subtype
  have hρ : Continuous fun p : N × E ↦ ρ p.1 p.2 :=
    hσ.comp ((continuous_subtype_val.comp continuous_fst).prodMk continuous_snd)
  let X := actionIsotype ρ
  let := locallyConvexFinalTopology (DirectSum.lof ℂ _ (fun χ ↦ ↥(X χ)))
  change Continuous (DirectSum.coeLinearMap X) ∧ Injective _ ∧ DenseRange _
  refine ⟨?_, ?_, ?_⟩
  · apply continuous_of_locallyConvexFinalTopology (DirectSum.lof ℂ _ (fun χ ↦ ↥(X χ)))
    intro χ
    simpa only [Function.comp_def, DirectSum.coeLinearMap_lof] using
      (continuous_subtype_val : Continuous (fun x : X χ ↦ (x : E)))
  · let f (g : N) : Module.End ℂ E := (ρ g).toLinearMap
    let v (χ : PontryaginDual N) (g : N) : ℂ := χ g
    have hv : Injective v := fun χ ψ h ↦ DFunLike.ext _ _ fun g ↦ Subtype.ext (congrFun h g)
    have hi := iSupIndep.iInf (fun g ↦ (f g).eigenspace) (fun g ↦ (f g).eigenspaces_iSupIndep)
    apply iSupIndep.dfinsupp_lsum_injective (p := X)
    refine (hi.comp hv).mono fun χ x hx ↦ (Submodule.mem_iInf _).mpr fun g ↦ ?_
    exact Module.End.mem_eigenspace_iff.mpr ((mem_actionIsotype ρ χ x).mp hx g)
  · let : UniformSpace E := IsTopologicalAddGroup.rightUniformSpace E
    let : IsUniformAddGroup E := isUniformAddGroup_of_addCommGroup
    let : CompleteSpace E := hc
    let : Module ℝ E := Module.restrictScalars ℝ ℂ E
    let : IsScalarTower ℝ ℂ E := IsScalarTower.restrictScalars ℝ ℂ E
    let : LocallyConvexSpace ℝ E := (PolynormableSpace.withSeminorms ℂ E).toLocallyConvexSpace
    let : SeparatingDual ℂ E := locallyConvexSpace_separatingDual ℂ E
    let : MeasurableSpace N := borel N
    let : BorelSpace N := ⟨rfl⟩
    let μ : Measure N := Measure.haar
    intro x
    let D := (LinearMap.range (DirectSum.coeLinearMap X)).topologicalClosure
    change x ∈ D
    by_contra hn
    obtain ⟨φ, hne, hz⟩ := exists_dual_eq_zero_on_submodule_of_notMem D
      (Submodule.isClosed_topologicalClosure _) hn
    let u : N → ℂ := fun g ↦ φ (ρ g x)
    have hu : Continuous u := φ.continuous.comp (hρ.comp (continuous_id.prodMk continuous_const))
    have hcoeff (χ : PontryaginDual N) : ∫ g, star (χ g : ℂ) * u g ∂μ = 0 := by
      let A (g : N) := star (χ g : ℂ) • ρ g
      have hA : Continuous fun p : N × E ↦ A p.1 p.2 :=
        (show Continuous (fun p : N × E ↦ star (χ p.1 : ℂ)) from by fun_prop).smul hρ
      obtain ⟨P, hP, _⟩ := existsUnique_pettisIntegral_continuousFamily μ isCompact_univ
        (ae_of_all _ fun _ ↦ Set.mem_univ _) A hA
      have hav : IsPettisIsotypicAverageOn μ Set.univ ρ χ P := by
        simpa [IsPettisIsotypicAverageOn, A] using hP
      rw [← compactActionAverage_dual_apply μ ρ χ P hav x φ]
      apply hz _ (Submodule.le_topologicalClosure _ ?_)
      rw [DirectSum.range_coeLinearMap]
      exact le_iSup X χ (compactActionAverage_mem_isotype μ ρ χ P hav x)
    have hae := ae_eq_zero_of_character_integral_eq_zero μ
      (hu.memLp_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)) hcoeff
    have heq := Measure.eq_of_ae_eq hae hu continuous_const
    exact hne (by simpa [u] using congrFun heq 1)

/-- Paper: Remark 6.2.1.4(1), pp. 297–298.
The direct sum of the S-local isotypes maps continuously and injectively to the
theta quotient with dense range.
Deviation: The topology of the direct sum is the locally convex final topology.
The strict comparison in the remark fails in general. -/
theorem sLocalThetaIsotypeSum_dense :
    let X := fun χ : PontryaginDual J₁(S) ↦ ↥(Eₛ(χ))
    letI := Classical.decEq (PontryaginDual J₁(S))
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ _ X)
    let i := DirectSum.toModule ℂ _ Θₛ(S) (fun χ ↦ (Eₛ(χ)).subtype)
    Continuous i ∧ Injective i ∧ DenseRange i := by
  have hclosed := isClosed_sProjectedDiagonal (F := F) (S := S)
  let : T2Space (Jₛ(S)) := inferInstanceAs (T2Space (_ ⧸ _))
  let : T2Space (J₁(S)) := inferInstanceAs (T2Space ((sIdeleQuotientNorm F S).ker : Set (Jₛ(S))))
  let : CompactSpace (J₁(S)) := isCompact_iff_compactSpace.mp
    ((isProperMap_sIdeleQuotientNorm F S).isCompact_preimage (isCompact_singleton (x := 1)))
  let : T2Space (Θₛ(S)) := sLocalAdelicThetaSpace_t2_of_isClosed
    (sLocalAdelicTheta_ker_isClosed (F := F) (S := S))
  let : PolynormableSpace ℂ (Θₛ(S)) := sLocalAdelicThetaSpace_polynormable
  let : IsTopologicalAddGroup (Θₛ(S)) := PolynormableSpace.isTopologicalAddGroup ℂ _
  let : ContinuousSMul ℂ (Θₛ(S)) := PolynormableSpace.continuousSMul ℂ _
  with_reducible_and_instances
    exact sLocalThetaIsotypeSum_dense_aux (H := Jₛ(S)) (E := Θₛ(S)) (sIdeleQuotientNorm F S).ker
      (sLocalAdelicThetaSpace_complete (F := F) (S := S)) ρₛ(S)
      (existsUnique_sLocalThetaAction (F := F) (S := S)).exists.choose_spec.1

/-- Paper: Remark 6.2.1.4(1), pp. 297–298.
The direct sum of the global isotypes maps continuously and injectively to the
global theta quotient with dense range.
Deviation: The topology of the direct sum is the locally convex final topology.
The strict comparison is omitted. -/
theorem globalThetaIsotypeSum_dense :
    let X := fun ω : PontryaginDual C₁ ↦ ↥(E𝔽(ω))
    letI := Classical.decEq (PontryaginDual C₁)
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ _ X)
    let i := DirectSum.toModule ℂ _ Θ𝔽 (fun ω ↦ (E𝔽(ω)).subtype)
    Continuous i ∧ Injective i ∧ DenseRange i := by sorry

/-- The generating seminorms for the final locally convex topology are tested on each stage. -/
private theorem globalThetaIsotypeSum_finalTopology_withSeminorms {K Z : Type*} {Y : K → Type*}
    [AddCommGroup Z] [Module ℂ Z] [∀ k, AddCommGroup (Y k)] [∀ k, Module ℂ (Y k)]
    [∀ k, TopologicalSpace (Y k)] (j : ∀ k, Y k →ₗ[ℂ] Z) :
    letI := locallyConvexFinalTopology j
    WithSeminorms (E := Z) (Subtype.val : {p : Seminorm ℂ Z // ∀ k, Continuous (p ∘ j k)} → _) := by
  let := locallyConvexFinalTopology j
  exact ⟨rfl⟩

/-- Each stage map into the final locally convex topology is continuous. -/
private theorem globalThetaIsotypeSum_continuous_finalTopology_stage {K Z : Type*} {Y : K → Type*}
    [AddCommGroup Z] [Module ℂ Z] [∀ k, AddCommGroup (Y k)] [∀ k, Module ℂ (Y k)]
    [∀ k, TopologicalSpace (Y k)] [∀ k, IsTopologicalAddGroup (Y k)]
    (j : ∀ k, Y k →ₗ[ℂ] Z) (k : K) :
    letI := locallyConvexFinalTopology j
    Continuous (j k) := by
  let := locallyConvexFinalTopology j
  exact (globalThetaIsotypeSum_finalTopology_withSeminorms j).continuous_of_continuous_comp _ fun p ↦ p.property k

/-- A linear map on a space with the final locally convex topology is continuous if all
its restrictions to the defining stages are continuous. -/
private theorem globalThetaIsotypeSum_continuous_finalTopology_lift {K Z W : Type*} {Y : K → Type*}
    [AddCommGroup Z] [Module ℂ Z] [∀ i, AddCommGroup (Y i)] [∀ i, Module ℂ (Y i)]
    [∀ i, TopologicalSpace (Y i)] [AddCommGroup W] [Module ℂ W] [TopologicalSpace W]
    [PolynormableSpace ℂ W] (u : ∀ i, Y i →ₗ[ℂ] Z) (T : Z →ₗ[ℂ] W)
    (h : ∀ i, Continuous (T ∘ u i)) :
    letI := locallyConvexFinalTopology u
    Continuous T := by
  let := locallyConvexFinalTopology u
  have hs := globalThetaIsotypeSum_finalTopology_withSeminorms u
  have := hs.isTopologicalAddGroup
  exact (PolynormableSpace.withSeminorms ℂ W).continuous_of_continuous_comp T fun p ↦
    hs.continuous_seminorm ⟨p.val.comp T, fun i ↦ p.property.comp (h i)⟩

/-- Coordinate projections are continuous on the locally convex direct sum. -/
private theorem globalThetaIsotypeSum_continuous_lcDirectSum_component {K : Type*} [DecidableEq K] (Y : K → Type*)
    [∀ i, AddCommGroup (Y i)] [∀ i, Module ℂ (Y i)] [∀ i, TopologicalSpace (Y i)]
    [∀ i, PolynormableSpace ℂ (Y i)] (i : K) :
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ K Y)
    Continuous (DirectSum.component ℂ K Y i) := by
  let lof := DirectSum.lof ℂ K Y
  let := locallyConvexFinalTopology lof
  apply globalThetaIsotypeSum_continuous_finalTopology_lift lof
  intro k
  change Continuous ((DirectSum.component ℂ K Y i).comp (DirectSum.lof ℂ K Y k))
  by_cases h : k = i
  · subst k
    simp only [DirectSum.component_comp_lof_same, LinearMap.id_coe, continuous_id]
  · rw [DirectSum.component_comp_lof, dite_eq_right h]
    exact continuous_const

/-- A Cauchy filter in a locally convex direct sum of complete spaces converges.
Its coordinate limits have finite support, as seen by testing a seminorm that takes
value one on each nonzero limit coordinate. -/
private theorem globalThetaIsotypeSum_completeSpace_lcDirectSum {K : Type*} [DecidableEq K] (Y : K → Type*)
    [∀ i, AddCommGroup (Y i)] [∀ i, Module ℂ (Y i)] [∀ i, UniformSpace (Y i)]
    [∀ i, IsUniformAddGroup (Y i)] [∀ i, PolynormableSpace ℂ (Y i)]
    [∀ i, T2Space (Y i)] [∀ i, CompleteSpace (Y i)] :
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ K Y)
    letI := (globalThetaIsotypeSum_finalTopology_withSeminorms (DirectSum.lof ℂ K Y)).isTopologicalAddGroup
    @CompleteSpace (⨁ i, Y i) (IsTopologicalAddGroup.rightUniformSpace _) := by
  classical
  let D := ⨁ i, Y i
  let lof := DirectSum.lof ℂ K Y
  let := locallyConvexFinalTopology lof
  have hD := globalThetaIsotypeSum_finalTopology_withSeminorms lof
  have : IsTopologicalAddGroup D := hD.isTopologicalAddGroup
  let := IsTopologicalAddGroup.rightUniformSpace D
  have : IsUniformAddGroup D := isUniformAddGroup_of_addCommGroup
  have : PolynormableSpace ℂ D := hD.toPolynormableSpace
  let pr := DirectSum.component ℂ K Y
  have hpr := globalThetaIsotypeSum_continuous_lcDirectSum_component Y
  constructor
  intro l hl
  have : l.NeBot := hl.1
  obtain ⟨v, hv⟩ : ∃ v : ∀ i, Y i, ∀ i, Tendsto (pr i) l (𝓝 (v i)) := by
    choose v hv using fun i ↦ CompleteSpace.complete (hl.map
      ((pr i).toAddMonoidHom.uniformContinuous_of_continuousAt_zero (hpr i).continuousAt))
    exact ⟨v, hv⟩
  -- Finite sums of coordinate seminorms stay close to the coordinatewise limit.
  have approx (q : ∀ i, Seminorm ℂ (Y i)) (hq : ∀ i, Continuous (q i)) :
      ∀ᶠ x : D in l, ∀ s : Finset K, (∑ i ∈ s, q i (x i - v i)) ≤ 1/2 := by
    let p := directSumSeminorm q
    have hp : Continuous p := hD.continuous_seminorm ⟨p, fun i ↦ by
      change Continuous (fun a ↦ directSumSeminorm q (DirectSum.lof ℂ K Y i a))
      simpa only [directSumSeminorm_lof] using hq i⟩
    have ht := (IsUniformAddGroup.cauchy_iff_tendsto l).mp hl
    obtain ⟨S, hS, hSS⟩ := l.basis_sets.prod_self.mem_iff.mp
      (ht.2 (p.ball_mem_nhds hp (show (0 : ℝ) < 1/2 by norm_num)))
    filter_upwards [hS] with x hx
    intro s
    have htend : Tendsto (fun y : D ↦ ∑ i ∈ s, q i (x i - y i)) l
        (𝓝 (∑ i ∈ s, q i (x i - v i))) :=
      tendsto_finsetSum _ fun i _ ↦ (hq i).continuousAt.tendsto.comp ((hv i).const_sub (x i))
    apply le_of_tendsto htend
    filter_upwards [hS] with y hy
    exact (sum_le_directSumSeminorm q (x-y) s).trans (p.mem_ball_zero.mp (hSS (a := (x,y)) ⟨hx,hy⟩)).le
  have hsep (i : K) : ∃ q : Seminorm ℂ (Y i), Continuous q ∧ (v i ≠ 0 → q (v i) = 1) := by
    by_cases h : v i = 0
    · exact ⟨0, continuous_zero, fun hn ↦ (hn h).elim⟩
    have := polynormableSpace_separatingDual ℂ (Y i)
    obtain ⟨φ, hφ⟩ := SeparatingDual.exists_eq_one (R := ℂ) h
    exact ⟨(normSeminorm ℂ ℂ).comp φ.toLinearMap, φ.continuous.norm, fun _ ↦ by
      change ‖φ (v i)‖ = 1
      simp [hφ]⟩
  choose q hq hsep using hsep
  obtain ⟨a, ha⟩ := (approx q hq).exists
  let z : D := DFinsupp.mk a.support fun i ↦ v i
  have hz (i : K) : z i = v i := by
    rw [show z i = _ from DFinsupp.mk_apply]
    split_ifs with hi
    · rfl
    · by_contra h
      have := ha {i}
      have hai : a i = 0 := DFinsupp.notMem_support_iff.mp hi
      simp [hai, hsep i (Ne.symm h)] at this
      linarith
  refine ⟨z, (Filter.tendsto_sub_const_iff z).mp ?_⟩
  rw [sub_self]
  apply (PolynormableSpace.hasBasis_zero_ball ℂ D).tendsto_right_iff.mpr
  intro p hp
  let r (i : K) := p.comp (lof i)
  have hr i : Continuous (r i) := hp.comp (globalThetaIsotypeSum_continuous_finalTopology_stage lof i)
  filter_upwards [approx r hr] with x hx
  let d := x - z
  have hsum := Finset.le_sum_of_subadditive p (map_zero p).le (map_add_le_add p)
    d.support (fun i ↦ lof i (d i))
  rw [show (∑ i ∈ d.support, lof i (d i)) = d from DirectSum.sum_support_of d] at hsum
  apply p.mem_ball_zero.mpr
  refine hsum.trans_lt ((le_trans ?_ (hx d.support)).trans_lt (by norm_num))
  apply Finset.sum_le_sum
  intro i _
  change p (lof i (x i - z i)) ≤ p (lof i (x i - v i))
  rw [hz]

/-- A compatible uniform additive group structure is determined by its topology. -/
private theorem globalThetaIsotypeSum_uniform_eq {A : Type*} [AddCommGroup A] (t : TopologicalSpace A)
    (h : @IsTopologicalAddGroup A t _) (u : UniformSpace A) (hu : u.toTopologicalSpace = t)
    (hg : @IsUniformAddGroup A u _) : u = @IsTopologicalAddGroup.rightUniformSpace A _ t h := by
  subst t
  exact (@IsUniformAddGroup.rightUniformSpace_eq A u _ hg).symm

/-- Paper: Remark 6.2.1.4(1), p. 297.
The locally convex direct sum of the S-local isotypes is Hausdorff and complete. -/
theorem sLocalThetaIsotypeSum_complete :
    let X := fun χ : PontryaginDual J₁(S) ↦ ↥(Eₛ(χ))
    letI := Classical.decEq (PontryaginDual J₁(S))
    let D := ⨁ χ, X χ
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ _ X)
    T2Space D ∧ PolynormableSpace ℂ D ∧
      ∀ (u : UniformSpace D), u.toTopologicalSpace = (inferInstance : TopologicalSpace D) →
        @IsUniformAddGroup D u _ → @CompleteSpace D u := by
  classical
  let : T2Space (Θₛ(S)) := sLocalAdelicThetaSpace_t2_of_isClosed
    (sLocalAdelicTheta_ker_isClosed (F := F) (S := S))
  let : PolynormableSpace ℂ (Θₛ(S)) := sLocalAdelicThetaSpace_polynormable
  let : IsTopologicalAddGroup (Θₛ(S)) := PolynormableSpace.isTopologicalAddGroup ℂ _
  let : UniformSpace (Θₛ(S)) := IsTopologicalAddGroup.rightUniformSpace _
  let : IsUniformAddGroup (Θₛ(S)) := isUniformAddGroup_of_addCommGroup
  let : CompleteSpace (Θₛ(S)) := sLocalAdelicThetaSpace_complete
  let X := fun χ : PontryaginDual J₁(S) ↦ ↥(Eₛ(χ))
  let D := ⨁ χ, X χ
  let lof := DirectSum.lof ℂ (PontryaginDual J₁(S)) X
  let : ∀ χ, UniformSpace (X χ) := fun χ ↦ UniformSpace.comap Subtype.val inferInstance
  let : ∀ χ, IsUniformAddGroup (X χ) := fun χ ↦
    IsUniformAddGroup.comap (f := (Eₛ(χ)).subtype.toAddMonoidHom)
  let : ∀ χ, CompleteSpace (X χ) := fun χ ↦
    (sLocalThetaIsotypicAverage_equiv (F := F) (S := S) χ).1.completeSpace_coe
  let : TopologicalSpace D := locallyConvexFinalTopology lof
  have hD := globalThetaIsotypeSum_finalTopology_withSeminorms lof
  let : IsTopologicalAddGroup D := hD.isTopologicalAddGroup
  let : PolynormableSpace ℂ D := hD.toPolynormableSpace
  refine ⟨T2Space.of_injective_continuous (f := fun x : D ↦ fun i ↦ x i)
    (fun _ _ h ↦ DFinsupp.ext (congrFun h))
    (continuous_pi (globalThetaIsotypeSum_continuous_lcDirectSum_component X)), inferInstance, ?_⟩
  intro u hu hg
  have ht : u.toTopologicalSpace = locallyConvexFinalTopology lof := hu
  let : UniformSpace D := u
  let : IsUniformAddGroup D := hg
  have heq : u = @IsTopologicalAddGroup.rightUniformSpace D _
      (locallyConvexFinalTopology lof) hD.isTopologicalAddGroup :=
    globalThetaIsotypeSum_uniform_eq _ hD.isTopologicalAddGroup u ht hg
  rw [heq]
  exact globalThetaIsotypeSum_completeSpace_lcDirectSum X

/-- Paper: Remark 6.2.1.4(1), p. 297.
The locally convex direct sum of the global isotypes is Hausdorff and complete. -/
theorem globalThetaIsotypeSum_complete :
    let X := fun ω : PontryaginDual C₁ ↦ ↥(E𝔽(ω))
    letI := Classical.decEq (PontryaginDual C₁)
    let D := ⨁ ω, X ω
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ _ X)
    T2Space D ∧ PolynormableSpace ℂ D ∧
      ∀ (u : UniformSpace D), u.toTopologicalSpace = (inferInstance : TopologicalSpace D) →
        @IsUniformAddGroup D u _ → @CompleteSpace D u := by
  classical
  let : T2Space Θ𝔽 := globalAdelicThetaSpace_t2_of_isClosed (adelicTheta_ker_isClosed (F := F))
  let : PolynormableSpace ℂ Θ𝔽 := globalAdelicThetaSpace_polynormable
  let : IsTopologicalAddGroup Θ𝔽 := PolynormableSpace.isTopologicalAddGroup ℂ _
  let : UniformSpace Θ𝔽 := IsTopologicalAddGroup.rightUniformSpace _
  let : IsUniformAddGroup Θ𝔽 := isUniformAddGroup_of_addCommGroup
  let : CompleteSpace Θ𝔽 := globalAdelicThetaSpace_complete
  let X := fun ω : PontryaginDual C₁ ↦ ↥(E𝔽(ω))
  let D := ⨁ ω, X ω
  let lof := DirectSum.lof ℂ (PontryaginDual C₁) X
  let : ∀ ω, UniformSpace (X ω) := fun ω ↦ UniformSpace.comap Subtype.val inferInstance
  let : ∀ ω, IsUniformAddGroup (X ω) := fun ω ↦
    IsUniformAddGroup.comap (f := (E𝔽(ω)).subtype.toAddMonoidHom)
  let : ∀ ω, CompleteSpace (X ω) := fun ω ↦ (globalThetaIsotypicAverage_equiv ω).1.completeSpace_coe
  let : TopologicalSpace D := locallyConvexFinalTopology lof
  have hD := globalThetaIsotypeSum_finalTopology_withSeminorms lof
  let : IsTopologicalAddGroup D := hD.isTopologicalAddGroup
  let : PolynormableSpace ℂ D := hD.toPolynormableSpace
  refine ⟨T2Space.of_injective_continuous (f := fun x : D ↦ fun i ↦ x i)
    (fun _ _ h ↦ DFinsupp.ext (congrFun h))
    (continuous_pi (globalThetaIsotypeSum_continuous_lcDirectSum_component X)), inferInstance, ?_⟩
  intro u hu hg
  have ht : u.toTopologicalSpace = locallyConvexFinalTopology lof := hu
  let : UniformSpace D := u
  let : IsUniformAddGroup D := hg
  have heq : u = @IsTopologicalAddGroup.rightUniformSpace D _
      (locallyConvexFinalTopology lof) hD.isTopologicalAddGroup :=
    globalThetaIsotypeSum_uniform_eq _ hD.isTopologicalAddGroup u ht hg
  rw [heq]
  exact globalThetaIsotypeSum_completeSpace_lcDirectSum X

-- The properties referred to in Remark 6.2.1.4(1) are listed in Theorem 5.2.3.1(2).
local notation "sumProperties(" D ")" =>
  IsLFSpace D ∧ IsNuclearTVS D ∧ BarrelledSpace ℂ D ∧ MontelSpace ℂ D ∧
    CompleteSpace (StrongDual ℂ D) ∧ IsNuclearTVS (StrongDual ℂ D) ∧
    BarrelledSpace ℂ (StrongDual ℂ D) ∧ MontelSpace ℂ (StrongDual ℂ D)

/-- Paper: Remark 6.2.1.4(1), p. 297.
The locally convex sum of the S-local isotypes is an LF-space and is nuclear. This is the
first half of the space part of Theorem 5.2.3.1(2) for that sum. -/
theorem sLocalThetaIsotypeSum_isLFSpace_nuclear :
    let X := fun χ : PontryaginDual J₁(S) ↦ ↥(Eₛ(χ))
    letI := Classical.decEq (PontryaginDual J₁(S))
    let D := ⨁ χ, X χ
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ _ X)
    IsLFSpace D ∧ IsNuclearTVS D := by sorry

/-- Paper: Remark 6.2.1.4(1), p. 297.
The locally convex sum of the S-local isotypes is barrelled and Montel. This is the second
half of the space part of Theorem 5.2.3.1(2) for that sum; together with the completeness
and polynormability of `sLocalThetaIsotypeSum_complete` it is the full space half. -/
theorem sLocalThetaIsotypeSum_barrelled_montel :
    let X := fun χ : PontryaginDual J₁(S) ↦ ↥(Eₛ(χ))
    letI := Classical.decEq (PontryaginDual J₁(S))
    let D := ⨁ χ, X χ
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ _ X)
    BarrelledSpace ℂ D ∧ MontelSpace ℂ D := by sorry

/-- Paper: Remark 6.2.1.4(1), p. 297.
The strong dual of the locally convex sum of the S-local isotypes is complete, nuclear,
barrelled and Montel: its strong dual identifies with the product of the strong duals of
the summands, and a product of nuclear spaces is nuclear. -/
theorem sLocalThetaIsotypeSum_strongDual_properties :
    let X := fun χ : PontryaginDual J₁(S) ↦ ↥(Eₛ(χ))
    letI := Classical.decEq (PontryaginDual J₁(S))
    let D := ⨁ χ, X χ
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ _ X)
    CompleteSpace (StrongDual ℂ D) ∧ IsNuclearTVS (StrongDual ℂ D) ∧
      BarrelledSpace ℂ (StrongDual ℂ D) ∧ MontelSpace ℂ (StrongDual ℂ D) := by sorry

/-- Paper: Remark 6.2.1.4(1), p. 297.
The locally convex sum of the local isotypes inherits the space and strong-dual properties
listed in Theorem 5.2.3.1(2). -/
theorem sLocalThetaIsotypeSum_inherited_properties :
    let X := fun χ : PontryaginDual J₁(S) ↦ ↥(Eₛ(χ))
    letI := Classical.decEq (PontryaginDual J₁(S))
    let D := ⨁ χ, X χ
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ _ X)
    sumProperties(D) := by
  have h₁ := sLocalThetaIsotypeSum_isLFSpace_nuclear (F := F) (S := S)
  have h₂ := sLocalThetaIsotypeSum_barrelled_montel (F := F) (S := S)
  have h₃ := sLocalThetaIsotypeSum_strongDual_properties (F := F) (S := S)
  exact ⟨h₁.1, h₁.2, h₂.1, h₂.2, h₃.1, h₃.2.1, h₃.2.2.1, h₃.2.2.2⟩

/-- Paper: Remark 6.2.1.4(1), p. 297.
The locally convex sum of the global isotypes is an LF-space and is nuclear. This is the
first half of the space part of Theorem 5.2.3.1(2) for that sum. -/
theorem globalThetaIsotypeSum_isLFSpace_nuclear :
    let X := fun ω : PontryaginDual C₁ ↦ ↥(E𝔽(ω))
    letI := Classical.decEq (PontryaginDual C₁)
    let D := ⨁ ω, X ω
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ _ X)
    IsLFSpace D ∧ IsNuclearTVS D := by sorry

/-- Paper: Remark 6.2.1.4(1), p. 297.
The locally convex sum of the global isotypes is barrelled and Montel. This is the second
half of the space part of Theorem 5.2.3.1(2) for that sum; together with the completeness
and polynormability of `globalThetaIsotypeSum_complete` it is the full space half. -/
theorem globalThetaIsotypeSum_barrelled_montel :
    let X := fun ω : PontryaginDual C₁ ↦ ↥(E𝔽(ω))
    letI := Classical.decEq (PontryaginDual C₁)
    let D := ⨁ ω, X ω
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ _ X)
    BarrelledSpace ℂ D ∧ MontelSpace ℂ D := by sorry

/-- Paper: Remark 6.2.1.4(1), p. 297.
The strong dual of the locally convex sum of the global isotypes is complete, nuclear,
barrelled and Montel: its strong dual identifies with the product of the strong duals of
the summands, and a product of nuclear spaces is nuclear. -/
theorem globalThetaIsotypeSum_strongDual_properties :
    let X := fun ω : PontryaginDual C₁ ↦ ↥(E𝔽(ω))
    letI := Classical.decEq (PontryaginDual C₁)
    let D := ⨁ ω, X ω
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ _ X)
    CompleteSpace (StrongDual ℂ D) ∧ IsNuclearTVS (StrongDual ℂ D) ∧
      BarrelledSpace ℂ (StrongDual ℂ D) ∧ MontelSpace ℂ (StrongDual ℂ D) := by sorry

/-- Paper: Remark 6.2.1.4(1), p. 297.
The locally convex sum of the global isotypes inherits the space and strong-dual properties
listed in Theorem 5.2.3.1(2). -/
theorem globalThetaIsotypeSum_inherited_properties :
    let X := fun ω : PontryaginDual C₁ ↦ ↥(E𝔽(ω))
    letI := Classical.decEq (PontryaginDual C₁)
    let D := ⨁ ω, X ω
    letI := locallyConvexFinalTopology (DirectSum.lof ℂ _ X)
    sumProperties(D) := by
  have h₁ := globalThetaIsotypeSum_isLFSpace_nuclear (F := F)
  have h₂ := globalThetaIsotypeSum_barrelled_montel (F := F)
  have h₃ := globalThetaIsotypeSum_strongDual_properties (F := F)
  exact ⟨h₁.1, h₁.2, h₂.1, h₂.2, h₃.1, h₃.2.1, h₃.2.2.1, h₃.2.2.2⟩

-- TODO(paper-gap): Remark 6.2.1.4(2) also asserts nonclosed product images.
-- At the rational archimedean stage the image in the product of homogeneous
-- theta quotients is the whole product. The remark conflates that product
-- with the product of the meromorphic Mellin target spaces.

section GlobalThetaProduct

open scoped RestrictedProduct NumberField.AdeleRing

/-- A number field has infinitely many finite places. -/
private theorem infinite_heightOneSpectrum_ringOfIntegers :
    Infinite (HeightOneSpectrum (𝓞 F)) := by
  refine Infinite.of_not_fintype fun _ ↦ ?_
  let B := ∏ v : HeightOneSpectrum (𝓞 F), v.asIdeal.absNorm
  obtain ⟨p, hpB, hp⟩ := Nat.exists_infinite_primes (B + 1)
  let I : Ideal (𝓞 F) := Ideal.span {(p : 𝓞 F)}
  have hp0 : (p : 𝓞 F) ≠ 0 := Nat.cast_ne_zero.mpr hp.ne_zero
  have hI0 : I ≠ ⊥ := mt Ideal.span_singleton_eq_bot.mp hp0
  have hnorm : Algebra.norm ℤ (p : 𝓞 F) = (p : ℤ) ^ Module.finrank ℚ F := by
    rw [← map_natCast (algebraMap ℤ (𝓞 F)) p, Algebra.norm_algebraMap]
    simp [NumberField.RingOfIntegers.rank]
  have hI_abs : I.absNorm = p ^ Module.finrank ℚ F := by
    rw [Ideal.absNorm_span_singleton, hnorm, Int.natAbs_pow, Int.natAbs_natCast]
  have hI1 : 1 < I.absNorm := by
    rw [hI_abs]
    exact one_lt_pow₀ hp.one_lt (Module.finrank_pos (R := ℚ) (M := F)).ne'
  have hItop : I ≠ ⊤ := fun h ↦ by simp [h] at hI1
  obtain ⟨M, hMmax, hIM⟩ := Ideal.exists_le_maximal I hItop
  have hMbot : M ≠ ⊥ := ne_bot_of_le_ne_bot hI0 hIM
  let v : HeightOneSpectrum (𝓞 F) := ⟨M, hMmax.isPrime, hMbot⟩
  have hdvd : v.asIdeal.absNorm ∣ p ^ Module.finrank ℚ F := by
    rw [← hI_abs]
    exact Ideal.absNorm_dvd_absNorm_of_le hIM
  obtain ⟨k, _, hk⟩ := (Nat.dvd_prime_pow hp).mp hdvd
  have hk_ne : k ≠ 0 := by
    rintro rfl
    simp only [pow_zero] at hk
    exact (HeightOneSpectrum.one_lt_absNorm v).ne' hk
  have hle : p ≤ v.asIdeal.absNorm := by
    rw [hk]
    exact Nat.le_self_pow hk_ne p
  have hleB : v.asIdeal.absNorm ≤ B :=
    Finset.single_le_prod (fun w _ ↦ (HeightOneSpectrum.one_lt_absNorm w).le)
      (Finset.mem_univ v)
  omega

/-- The norm-one idele class group of any number field is infinite. -/
private theorem infinite_normOneIdeleClassGroup : Infinite C₁ := by
  classical
  have hinf := infinite_heightOneSpectrum_ringOfIntegers (F := F)
  have hpt : ∀ v : V, ∃ u : (v.adicCompletion F)ˣ, Valued.v (u : v.adicCompletion F) = 1 ∧ u ≠ 1 := by
    intro v
    obtain ⟨π, hπ⟩ :=
      (Valued.v : Valuation (v.adicCompletion F) (WithZero (Multiplicative ℤ))).exists_isUniformizer_of_isCyclic_of_nontrivial
    have hπlt : Valued.v (π : v.adicCompletion F) < 1 := hπ.val_lt_one
    have hπne : (π : v.adicCompletion F) ≠ 0 := hπ.ne_zero
    have huval : Valued.v (1 + (π : v.adicCompletion F)) = 1 := by
      have hdiff : Valued.v (1 : v.adicCompletion F) ≠ Valued.v (π : v.adicCompletion F) := by
        rw [map_one]
        exact hπlt.ne'
      rw [Valuation.map_add_of_distinct_val Valued.v hdiff, map_one, max_eq_left hπlt.le]
    have hu0 : (1 + (π : v.adicCompletion F)) ≠ 0 := by
      intro h
      rw [h, map_zero] at huval
      exact zero_ne_one huval
    refine ⟨Units.mk0 _ hu0, huval, fun h ↦ hπne ?_⟩
    have hval := congrArg Units.val h
    change 1 + (π : v.adicCompletion F) = 1 at hval
    exact add_left_cancel (hval.trans (add_zero 1).symm)
  choose u huval hune using hpt
  let g (v : V) : IdeleGroup (𝓞 F) F := IdeleGroup.ofAdicCompletion (𝓞 F) F v (u v)
  have hgnorm (v : V) : ideleNorm F (g v) = 1 := by
    apply Units.ext
    apply NNReal.coe_injective
    change ((ideleNorm F (g v) : ℝ≥0) : ℝ) = 1
    rw [(ideleNorm_spec F).1 (g v) |>.2]
    have hinf_one : ∀ w : InfinitePlace F, ‖(g v).val.1 w‖ ^ w.mult = 1 := fun w ↦ by
      change ‖(1 : w.Completion)‖ ^ w.mult = 1
      simp
    have hfin_one : (∏ᶠ w : V, ‖(g v).val.2 w‖) = 1 := by
      rw [finprod_eq_single _ v]
      · have hnorm1 : ‖((u v : (v.adicCompletion F)ˣ) : v.adicCompletion F)‖ = 1 :=
          Valued.toNormedField.norm_eq_one_iff.mpr (huval v)
        have heq : (g v).val.2 v = (u v : v.adicCompletion F) :=
          Pi.mulSingle_eq_same (M := fun x : V ↦ x.adicCompletion F) v _
        rw [heq, hnorm1]
      · intro w hw
        have h1 : (g v).val.2 w = 1 := by
          change Pi.mulSingle (M := fun x : V ↦ x.adicCompletion F) v (u v : v.adicCompletion F) w = 1
          exact Pi.mulSingle_eq_of_ne hw _
        rw [h1, norm_one]
    rw [Finset.prod_eq_one (fun w _ ↦ hinf_one w), hfin_one, one_mul]
  let c (v : V) : C₁ := ⟨QuotientGroup.mk (g v), hgnorm v⟩
  refine Infinite.of_injective c fun v₁ v₂ hc ↦ ?_
  by_contra hvne
  have hmk : (QuotientGroup.mk (g v₁) : IdeleClassGroup (𝓞 F) F) = QuotientGroup.mk (g v₂) :=
    congrArg Subtype.val hc
  rw [QuotientGroup.eq] at hmk
  obtain ⟨a, ha⟩ := hmk
  have ha' : (g v₁)⁻¹ * g v₂ = IdeleGroup.unitEmbedding (𝓞 F) F a := ha.symm
  obtain ⟨w₀⟩ := (inferInstance : Nonempty (InfinitePlace F))
  have hw₀ := congrArg (fun z : IdeleGroup (𝓞 F) F ↦ z.val.1 w₀) ha'
  have hv₁_w₀ : (g v₁).val.1 w₀ = 1 := rfl
  have hv₂_w₀ : (g v₂).val.1 w₀ = 1 := rfl
  have hinv_w₀ : ((g v₁)⁻¹).val.1 w₀ = 1 := by
    have hm := congrArg (fun z : IdeleGroup (𝓞 F) F ↦ z.val.1 w₀) (inv_mul_cancel (g v₁))
    change ((g v₁)⁻¹).val.1 w₀ * (g v₁).val.1 w₀ = 1 at hm
    rwa [hv₁_w₀, mul_one] at hm
  have hleft_w₀ : ((g v₁)⁻¹ * g v₂).val.1 w₀ = 1 := by
    change ((g v₁)⁻¹).val.1 w₀ * (g v₂).val.1 w₀ = 1
    rw [hinv_w₀, hv₂_w₀, mul_one]
  have hright_w₀ : (IdeleGroup.unitEmbedding (𝓞 F) F a).val.1 w₀ =
      algebraMap F w₀.Completion (a : F) := rfl
  rw [hleft_w₀, hright_w₀] at hw₀
  have ha1 : (a : F) = 1 := (algebraMap F w₀.Completion).injective (hw₀.symm.trans (map_one _).symm)
  have hv₁ := congrArg (fun z : IdeleGroup (𝓞 F) F ↦ z.val.2 v₁) ha'
  have hright_v₁ : (IdeleGroup.unitEmbedding (𝓞 F) F a).val.2 v₁ = 1 := by
    change algebraMap F (v₁.adicCompletion F) (a : F) = 1
    rw [ha1, map_one]
  have hv₂1 : (g v₂).val.2 v₁ = 1 := by
    change Pi.mulSingle (M := fun x : V ↦ x.adicCompletion F) v₂ (u v₂ : v₂.adicCompletion F) v₁ = 1
    exact Pi.mulSingle_eq_of_ne hvne _
  have hv₁1 : (g v₁).val.2 v₁ = (u v₁ : v₁.adicCompletion F) :=
    Pi.mulSingle_eq_same (M := fun x : V ↦ x.adicCompletion F) v₁ _
  have hinv_v₁ : ((g v₁)⁻¹).val.2 v₁ = ((u v₁ : v₁.adicCompletion F))⁻¹ := by
    have hm := congrArg (fun z : IdeleGroup (𝓞 F) F ↦ z.val.2 v₁) (inv_mul_cancel (g v₁))
    change ((g v₁)⁻¹).val.2 v₁ * (g v₁).val.2 v₁ = 1 at hm
    rw [hv₁1] at hm
    exact mul_right_cancel₀ (u v₁).ne_zero (hm.trans (inv_mul_cancel₀ (u v₁).ne_zero).symm)
  change ((g v₁)⁻¹).val.2 v₁ * (g v₂).val.2 v₁ = (IdeleGroup.unitEmbedding (𝓞 F) F a).val.2 v₁ at hv₁
  rw [hinv_v₁, hv₂1, mul_one, hright_v₁, inv_eq_one] at hv₁
  exact hune v₁ (Units.ext hv₁)

/-- The Pontryagin dual of the norm-one idele class group is infinite. -/
private theorem infinite_pontryaginDual_normOneIdeleClassGroup :
    Infinite (PontryaginDual C₁) := by
  let : Infinite C₁ := infinite_normOneIdeleClassGroup
  let : T2Space C₁ := (ideleClassGroup_finiteness F).2.2.1
  let : CompactSpace C₁ := (ideleClassGroup_finiteness F).2.1
  refine Infinite.of_not_fintype fun _ ↦ ?_
  let toCont (χ : PontryaginDual C₁) : C(C₁, ℂ) :=
    { toFun := fun g ↦ (χ g : ℂ)
      continuous_toFun := continuous_subtype_val.comp χ.continuous }
  let S : Submodule ℂ C(C₁, ℂ) := Submodule.span ℂ (Set.range toCont)
  have h1mem : (1 : C(C₁, ℂ)) ∈ S :=
    Submodule.subset_span ⟨1, ContinuousMap.ext fun _ ↦ rfl⟩
  have hmul : ∀ {f g}, f ∈ S → g ∈ S → f * g ∈ S := by
    intro f g hf hg
    induction hf using Submodule.span_induction with
    | mem x hx =>
      rcases hx with ⟨χ, rfl⟩
      induction hg using Submodule.span_induction with
      | mem y hy =>
        rcases hy with ⟨ψ, rfl⟩
        refine Submodule.subset_span ⟨χ * ψ, ContinuousMap.ext fun z ↦ ?_⟩
        change ((χ z * ψ z : Circle) : ℂ) = (χ z : ℂ) * (ψ z : ℂ)
        rw [Circle.coe_mul]
      | zero => simp
      | add a b _ _ ha hb => rw [mul_add]; exact S.add_mem ha hb
      | smul c a _ ha => rw [mul_smul_comm]; exact S.smul_mem c ha
    | zero => simp
    | add a b _ _ ha hb => rw [add_mul]; exact S.add_mem ha hb
    | smul c a _ ha => rw [smul_mul_assoc]; exact S.smul_mem c ha
  have hstar : ∀ {f}, f ∈ S → star f ∈ S := by
    intro f hf
    induction hf using Submodule.span_induction with
    | mem x hx =>
      rcases hx with ⟨χ, rfl⟩
      refine Submodule.subset_span ⟨χ⁻¹, ContinuousMap.ext fun z ↦ ?_⟩
      change ((χ⁻¹ z : Circle) : ℂ) = star (χ z : ℂ)
      change (((χ z)⁻¹ : Circle) : ℂ) = star (χ z : ℂ)
      rw [Circle.coe_inv_eq_conj, Complex.star_def]
    | zero => simp
    | add a b _ _ ha hb => rw [star_add]; exact S.add_mem ha hb
    | smul c a _ ha => rw [star_smul]; exact S.smul_mem (star c) ha
  let A : StarSubalgebra ℂ C(C₁, ℂ) :=
    { S with
      mul_mem' := hmul
      one_mem' := h1mem
      algebraMap_mem' := fun c ↦ by simpa [Algebra.algebraMap_eq_smul_one] using S.smul_mem c h1mem
      star_mem' := hstar }
  have hsep : A.SeparatesPoints := by
    intro x y hxy
    by_contra hne
    have hpair : ∀ χ : PontryaginDual C₁, χ x = χ y := fun χ ↦ Subtype.ext <| by
      by_contra hneq
      exact hne ⟨toCont χ, ⟨toCont χ, Submodule.subset_span ⟨χ, rfl⟩, rfl⟩, hneq⟩
    exact hxy (pontryaginDual_pairing_separates.1 (funext hpair))
  have hdense := ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints A hsep
  have hfinS : FiniteDimensional ℂ S := Module.Finite.span_of_finite ℂ (Set.finite_range toCont)
  have hclosedS : IsClosed (S : Set C(C₁, ℂ)) := Submodule.isClosed_of_finiteDimensional S
  have hStop : S = ⊤ := by
    apply Submodule.ext
    intro f
    simp only [Submodule.mem_top, iff_true]
    have hmem : f ∈ (A.topologicalClosure : Set C(C₁, ℂ)) := by rw [hdense]; trivial
    rw [StarSubalgebra.topologicalClosure_coe] at hmem
    change f ∈ closure (S : Set C(C₁, ℂ)) at hmem
    rwa [hclosedS.closure_eq] at hmem
  have hS_le : Module.finrank ℂ S ≤ Fintype.card (PontryaginDual C₁) :=
    finrank_range_le_card toCont
  let n := Fintype.card (PontryaginDual C₁)
  let pts : Fin (n + 1) → C₁ := fun i ↦ Infinite.natEmbedding C₁ i
  have hpts : Injective pts := (Infinite.natEmbedding C₁).injective.comp Fin.val_injective
  have hpick_ex (i : Fin (n + 1)) : ∃ f₀ : C(C₁, ℝ),
      Set.EqOn f₀ 0 (pts '' ({j : Fin (n + 1) | j ≠ i} : Set (Fin (n + 1)))) ∧
      Set.EqOn f₀ 1 ({pts i} : Set C₁) ∧
      ∀ x, f₀ x ∈ Set.Icc (0 : ℝ) 1 := by
    refine exists_continuous_zero_one_of_isClosed
      ((Set.Finite.image pts ((Set.finite_univ).subset (Set.subset_univ _))).isClosed)
      isClosed_singleton ?_
    rw [Set.disjoint_singleton_right]
    rintro ⟨j, hj, hij⟩
    exact hj (hpts hij)
  let pick (i : Fin (n + 1)) : C(C₁, ℂ) :=
    ⟨fun x ↦ ((hpick_ex i).choose x : ℂ), Complex.continuous_ofReal.comp (hpick_ex i).choose.continuous⟩
  have hpick_self (i : Fin (n + 1)) : pick i (pts i) = 1 := by
    change ((hpick_ex i).choose (pts i) : ℂ) = 1
    simpa using congrArg (fun r : ℝ ↦ (r : ℂ)) ((hpick_ex i).choose_spec.2.1 (Set.mem_singleton _))
  have hpick_ne {i j : Fin (n + 1)} (hne : j ≠ i) : pick i (pts j) = 0 := by
    change ((hpick_ex i).choose (pts j) : ℂ) = 0
    simpa using congrArg (fun r : ℝ ↦ (r : ℂ)) ((hpick_ex i).choose_spec.1 ⟨j, hne, rfl⟩)
  let pickS (i : Fin (n + 1)) : S := ⟨pick i, hStop ▸ Submodule.mem_top⟩
  have hindS : LinearIndependent ℂ pickS := by
    refine Fintype.linearIndependent_iff.mpr fun c hc i ↦ ?_
    have hc' : ∑ j, c j • pick j = 0 := by
      have h0 := congrArg (fun u : S ↦ (u : C(C₁, ℂ))) hc
      simpa [pickS] using h0
    have hval := congrArg (fun f : C(C₁, ℂ) ↦ f (pts i)) hc'
    simp only [ContinuousMap.coe_sum, ContinuousMap.coe_smul, Finset.sum_apply, Pi.smul_apply,
      smul_eq_mul, ContinuousMap.zero_apply] at hval
    rw [Finset.sum_eq_single i] at hval
    · simpa [hpick_self i] using hval
    · intro j _ hj
      simp [hpick_ne hj.symm]
    · intro hi
      exact absurd (Finset.mem_univ i) hi
  have hbig := hindS.fintype_card_le_finrank
  rw [Fintype.card_fin] at hbig
  omega

/-- Given a unitary character `ω` of `C₁`, construct a nonnegative real-valued Schwartz-Bruhat
function equal to `1` at `1` whose support on norm-one ideles maps into `{Re(ω) > 0}`. -/
private theorem exists_idele_test_re_pos (ω : PontryaginDual C₁) :
    ∃ f : SchwartzBruhat (Multiplicative 𝔸[F]),
      f (Multiplicative.ofAdd (1 : 𝔸[F])) = 1 ∧
      (∀ x : 𝔸[F], 0 ≤ (f (Multiplicative.ofAdd x)).re ∧
        (f (Multiplicative.ofAdd x)).im = 0) ∧
      (∀ h : (ideleNorm F).ker, f (Multiplicative.ofAdd h.val.val) ≠ 0 →
        0 < (ω ⟨QuotientGroup.mk h.val, h.property⟩ : ℂ).re) := by
  classical
  let : T2Space C₁ := (ideleClassGroup_finiteness F).2.2.1
  let : CompactSpace C₁ := (ideleClassGroup_finiteness F).2.1
  let : T2Space (IdeleGroup (𝓞 F) F) := (ideleGroup_topology F).1
  let p : (ideleNorm F).ker →* C₁ :=
    { toFun := fun x ↦ ⟨QuotientGroup.mk x.val, x.property⟩
      map_one' := rfl
      map_mul' := fun _ _ ↦ rfl }
  have hp : Continuous p :=
    (QuotientGroup.continuous_mk.comp continuous_subtype_val).subtype_mk _
  let U : Set C₁ := {h : C₁ | (0 : ℝ) < (ω h : ℂ).re}
  have hUopen : IsOpen U := isOpen_lt continuous_const (Complex.continuous_re.comp
    (continuous_subtype_val.comp ω.continuous))
  have h1U : (1 : C₁) ∈ U := by simp [U]
  let W_N : Set (ideleNorm F).ker := p ⁻¹' U
  have hWN_open : IsOpen W_N := hUopen.preimage hp
  obtain ⟨W_I, hWI_open, hWI_eq⟩ := isOpen_induced_iff.mp hWN_open
  have h1WI : (1 : IdeleGroup (𝓞 F) F) ∈ W_I := by
    change ((1 : (ideleNorm F).ker) : IdeleGroup (𝓞 F) F) ∈ W_I
    rw [← Set.mem_preimage, hWI_eq]
    exact h1U
  obtain ⟨e, he⟩ := (ideleGroup_topology F).2.2.2.1
  let W_prod := e.symm ⁻¹' W_I
  have hWprod_nhds : W_prod ∈ 𝓝 (1 : ((w : InfinitePlace F) → w.Completionˣ) ×
      (Πʳ v : V, [(v.adicCompletion F)ˣ, (v.adicCompletionIntegers F).units])) :=
    (hWI_open.preimage e.symm.continuous).mem_nhds (by simp [h1WI])
  rw [nhds_prod_eq, Filter.mem_prod_iff] at hWprod_nhds
  obtain ⟨U_inf, hUinf, U_fin, hUfin, hsub_prod⟩ := hWprod_nhds
  -- Extract a small radius around 1 in each infinite completion.
  rw [nhds_pi, Filter.mem_pi'] at hUinf
  obtain ⟨S_inf, t_inf, ht_inf, hSinf_sub⟩ := hUinf
  have hδw : ∀ w : InfinitePlace F, ∃ δ : ℝ, 0 < δ ∧
      ∀ z : w.Completionˣ, dist (z : w.Completion) 1 < δ → w ∈ S_inf → z ∈ t_inf w := by
    intro w
    by_cases hw : w ∈ S_inf
    · have htw : t_inf w ∈ 𝓝 (1 : w.Completionˣ) := ht_inf w
      rw [Units.isInducing_embedProduct.nhds_eq_comap, Filter.mem_comap] at htw
      obtain ⟨V_prod, hV_prod, hV_sub⟩ := htw
      rw [map_one, nhds_prod_eq, Filter.mem_prod_iff] at hV_prod
      obtain ⟨A, hA, B, hB, hAB⟩ := hV_prod
      obtain ⟨r₁, hr₁, hAball⟩ := Metric.mem_nhds_iff.mp hA
      obtain ⟨r₂, hr₂, hBball⟩ := Metric.mem_nhds_iff.mp hB
      have hinv_cont : ContinuousAt (Inv.inv : w.Completion → w.Completion) 1 :=
        continuousAt_inv₀ one_ne_zero
      obtain ⟨r₃, hr₃, hinv_ball⟩ := Metric.mem_nhds_iff.mp (hinv_cont.preimage_mem_nhds
        (by simpa using Metric.ball_mem_nhds (1 : w.Completion) hr₂))
      refine ⟨min r₁ r₃, lt_min hr₁ hr₃, fun z hz _ ↦ hV_sub ?_⟩
      apply hAB
      refine ⟨hAball (hz.trans_le (min_le_left _ _)), ?_⟩
      apply hBball
      change dist (z.inv) (MulOpposite.unop (1 : w.Completionᵐᵒᵖ)) < r₂
      have hinv_eq : z.inv = (z.val)⁻¹ := (inv_eq_of_mul_eq_one_right z.val_inv).symm
      rw [hinv_eq, MulOpposite.unop_one]
      exact hinv_ball (hz.trans_le (min_le_right _ _))
    · exact ⟨1, one_pos, fun _ _ hmem ↦ absurd hmem hw⟩
  choose δw hδw_pos hδw_mem using hδw
  -- Shrink finite-place neighborhood using structureMap.
  have hOpenUnits : ∀ v : V, IsOpen
      ((v.adicCompletionIntegers F).units : Set (v.adicCompletion F)ˣ) := fun v ↦
    Submonoid.isOpen_units (Valued.isOpen_valuationSubring _)
  have hUfin_pull : RestrictedProduct.structureMap (fun v : V ↦ (v.adicCompletion F)ˣ)
      (fun v : V ↦ (v.adicCompletionIntegers F).units) (Filter.cofinite) ⁻¹' U_fin ∈
      𝓝 (1 : Π v : V, (v.adicCompletionIntegers F).units) :=
    (RestrictedProduct.isEmbedding_structureMap).continuous.continuousAt.preimage_mem_nhds
      (by convert hUfin; ext v; rfl)
  rw [nhds_pi, Filter.mem_pi'] at hUfin_pull
  obtain ⟨S₀, t_fin, ht_fin, hS₀_sub⟩ := hUfin_pull
  -- For each v ∈ S₀, choose a congruence neighborhood 1 + π^N 𝒪_v inside t_fin v.
  have hKv : ∀ v : V, ∃ N : ℕ, ∃ π : v.adicCompletion F,
      Valued.v.IsUniformizer π ∧
      ∀ z : (v.adicCompletion F)ˣ, (∃ r ∈ v.adicCompletionIntegers F, (z : v.adicCompletion F) = 1 + π ^ N * r) →
        ∃ hz : z ∈ (v.adicCompletionIntegers F).units,
          (v ∈ S₀ → ⟨z, hz⟩ ∈ t_fin v) := by
    intro v
    obtain ⟨π, hπ⟩ :=
      (Valued.v : Valuation (v.adicCompletion F) (WithZero (Multiplicative ℤ))).exists_isUniformizer_of_isCyclic_of_nontrivial
    have hπlt : Valued.v (π : v.adicCompletion F) < 1 := hπ.val_lt_one
    have hπnorm : ‖(π : v.adicCompletion F)‖ = (v.asIdeal.absNorm : ℝ)⁻¹ :=
      norm_uniformizer_adicCompletion v _ hπ
    have hq : (1 : ℝ) < v.asIdeal.absNorm := by exact_mod_cast HeightOneSpectrum.one_lt_absNorm v
    have hnorm_lt : ‖(π : v.adicCompletion F)‖ < 1 := by
      rw [hπnorm]
      exact inv_lt_one_of_one_lt₀ hq
    have hmem_units (N : ℕ) (hN : 1 ≤ N) (z : (v.adicCompletion F)ˣ)
        (hz : ∃ r ∈ v.adicCompletionIntegers F, (z : v.adicCompletion F) = 1 + (π : v.adicCompletion F) ^ N * r) :
        z ∈ (v.adicCompletionIntegers F).units := by
      obtain ⟨r, hr, hzr⟩ := hz
      apply HeightOneSpectrum.adicCompletionIntegers.mem_units_iff_valued_eq_one.mpr
      have hsub_lt : Valued.v ((π : v.adicCompletion F) ^ N * r) < 1 := by
        rw [← Valued.toNormedField.norm_lt_one_iff, norm_mul, norm_pow]
        have hrnorm : ‖r‖ ≤ 1 := Valued.toNormedField.norm_le_one_iff.mpr hr
        calc
          ‖(π : v.adicCompletion F)‖ ^ N * ‖r‖ ≤ ‖(π : v.adicCompletion F)‖ ^ N * 1 :=
            mul_le_mul_of_nonneg_left hrnorm (by positivity)
          _ = ‖(π : v.adicCompletion F)‖ ^ N := mul_one _
          _ < 1 := pow_lt_one₀ (norm_nonneg _) hnorm_lt (by omega)
      have hdiff : Valued.v (1 : v.adicCompletion F) ≠ Valued.v ((π : v.adicCompletion F) ^ N * r) := by
        rw [map_one]
        exact hsub_lt.ne'
      rw [hzr, Valuation.map_add_of_distinct_val Valued.v hdiff, map_one, max_eq_left hsub_lt.le]
    by_cases hv : v ∈ S₀
    · have hopen : IsOpen ((v.adicCompletionIntegers F).units : Set (v.adicCompletion F)ˣ) :=
        hOpenUnits v
      have htv : Subtype.val '' t_fin v ∈ 𝓝 (1 : (v.adicCompletion F)ˣ) :=
        (hopen.isOpenEmbedding_subtypeVal.map_nhds_eq 1) ▸ Filter.image_mem_map (ht_fin v)
      rw [Units.isInducing_embedProduct.nhds_eq_comap, Filter.mem_comap] at htv
      obtain ⟨V_p, hV_p, hV_sub⟩ := htv
      rw [map_one, nhds_prod_eq, Filter.mem_prod_iff] at hV_p
      obtain ⟨A, hA, B, hB, hAB⟩ := hV_p
      obtain ⟨r₁, hr₁, hAball⟩ := Metric.mem_nhds_iff.mp hA
      obtain ⟨r₂, hr₂, hBball⟩ := Metric.mem_nhds_iff.mp hB
      have hinv_cont : ContinuousAt (Inv.inv : v.adicCompletion F → v.adicCompletion F) 1 :=
        continuousAt_inv₀ one_ne_zero
      obtain ⟨r₃, hr₃, hinv_ball⟩ := Metric.mem_nhds_iff.mp (hinv_cont.preimage_mem_nhds
        (by simpa using Metric.ball_mem_nhds (1 : v.adicCompletion F) hr₂))
      obtain ⟨N, hNpow⟩ := exists_pow_lt_of_lt_one (lt_min hr₁ hr₃) hnorm_lt
      refine ⟨max 1 N, π, hπ, fun z hz ↦ ⟨hmem_units (max 1 N) (le_max_left _ _) z hz, fun _ ↦ ?_⟩⟩
      obtain ⟨r, hr, hzr⟩ := hz
      have hdist : dist (z : v.adicCompletion F) 1 < min r₁ r₃ := by
        rw [dist_eq_norm, hzr, add_sub_cancel_left, norm_mul, norm_pow]
        have hrnorm : ‖r‖ ≤ 1 := Valued.toNormedField.norm_le_one_iff.mpr hr
        calc
          ‖(π : v.adicCompletion F)‖ ^ max 1 N * ‖r‖
              ≤ ‖(π : v.adicCompletion F)‖ ^ max 1 N * 1 := mul_le_mul_of_nonneg_left hrnorm (by positivity)
          _ = ‖(π : v.adicCompletion F)‖ ^ max 1 N := mul_one _
          _ ≤ ‖(π : v.adicCompletion F)‖ ^ N := pow_le_pow_of_le_one (norm_nonneg _) hnorm_lt.le (le_max_right _ _)
          _ < min r₁ r₃ := hNpow
      have hmem_tv : z ∈ Subtype.val '' t_fin v := by
        apply hV_sub
        apply hAB
        refine ⟨hAball (hdist.trans_le (min_le_left _ _)), ?_⟩
        apply hBball
        change dist (z.inv) (MulOpposite.unop (1 : (v.adicCompletion F)ᵐᵒᵖ)) < r₂
        have hinv_eq : z.inv = (z.val)⁻¹ := (inv_eq_of_mul_eq_one_right z.val_inv).symm
        rw [hinv_eq, MulOpposite.unop_one]
        exact hinv_ball (hdist.trans_le (min_le_right _ _))
      obtain ⟨y, hy_mem, hy_eq⟩ := hmem_tv
      have hsub_eq : ⟨z, hmem_units (max 1 N) (le_max_left _ _) z ⟨r, hr, hzr⟩⟩ = y :=
        Subtype.ext hy_eq.symm
      rwa [hsub_eq]
    · refine ⟨1, π, hπ, fun z hz ↦ ⟨hmem_units 1 le_rfl z hz, fun hmem ↦ absurd hmem hv⟩⟩
  choose Nv πv hπv_unif hKv_spec using hKv
  -- Build compact open subsets K v = (1 + π_v^{N_v} 𝒪_v) for v ∈ S₀ and 𝒪_v for v ∉ S₀.
  let K (v : V) : Set (v.adicCompletion F) :=
    if v ∈ S₀ then
      (fun z : v.adicCompletion F ↦ 1 + (πv v) ^ (Nv v) * z) '' (v.adicCompletionIntegers F : Set _)
    else (v.adicCompletionIntegers F : Set _)
  have hK_co (v : V) : IsCompact (K v) ∧ IsOpen (K v) := by
    by_cases hv : v ∈ S₀
    · simp only [K, hv, ↓reduceIte]
      have hpow0 : (πv v) ^ (Nv v) ≠ 0 := pow_ne_zero _ (hπv_unif v).ne_zero
      let φ : v.adicCompletion F ≃ₜ v.adicCompletion F :=
        (Homeomorph.mulLeft₀ _ hpow0).trans (Homeomorph.addLeft 1)
      have hc : IsCompact (v.adicCompletionIntegers F : Set (v.adicCompletion F)) :=
        isCompact_iff_compactSpace.mpr (compactSpace_adicCompletionIntegers v)
      have ho : IsOpen (v.adicCompletionIntegers F : Set (v.adicCompletion F)) :=
        Valued.isOpen_valuationSubring _
      exact ⟨hc.image φ.continuous, φ.isOpenMap _ ho⟩
    · simp only [K, hv, ↓reduceIte]
      exact ⟨isCompact_iff_compactSpace.mpr (compactSpace_adicCompletionIntegers v),
        Valued.isOpen_valuationSubring _⟩
  have hK_1 (v : V) : (1 : v.adicCompletion F) ∈ K v := by
    by_cases hv : v ∈ S₀
    · simp only [K, hv, ↓reduceIte]
      exact ⟨0, (v.adicCompletionIntegers F).zero_mem, by simp⟩
    · simp only [K, hv, ↓reduceIte]
      exact (v.adicCompletionIntegers F).one_mem
  -- Construct an archimedean Schwartz-Bruhat bump supported near 1 with ∏ ‖x_w‖^{mult} < 2.
  let V_inf := mixedEmbedding.mixedSpace F
  let E_inf := EuclideanSpace ℝ (Fin (Module.finrank ℝ V_inf))
  let L_inf : V_inf ≃L[ℝ] E_inf :=
    ContinuousLinearEquiv.ofFinrankEq finrank_euclideanSpace_fin.symm
  let m_inf := InfiniteAdeleRing.ringEquiv_mixedSpace F
  have harch (y : InfiniteAdeleRing F) (w : InfinitePlace F) : ‖y w‖ ≤ ‖m_inf y‖ := by
    rw [mixedEmbedding.norm_eq_sup'_normAtPlace]
    apply Finset.le_sup'_of_le _ (Finset.mem_univ w)
    by_cases hw : w.IsReal
    · rw [mixedEmbedding.normAtPlace_apply_of_isReal hw, InfiniteAdeleRing.ringEquiv_mixedSpace_apply]
      exact ((InfinitePlace.Completion.isometry_extensionEmbeddingOfIsReal hw).norm_map_of_map_zero
        (map_zero _) _).symm.le
    · have hc := InfinitePlace.not_isReal_iff_isComplex.mp hw
      rw [mixedEmbedding.normAtPlace_apply_of_isComplex hc, InfiniteAdeleRing.ringEquiv_mixedSpace_apply]
      exact ((InfinitePlace.Completion.isometry_extensionEmbedding w).norm_map_of_map_zero
        (map_zero _) _).symm.le
  let expSum : ℕ := ∑ w : InfinitePlace F, w.mult
  have hpow_cont : ContinuousAt (fun t : ℝ ↦ (1 + t) ^ expSum) 0 :=
    ((continuous_const.add continuous_id).pow expSum).continuousAt
  obtain ⟨r_pow, hr_pow, hr_pow_lt⟩ := Metric.mem_nhds_iff.mp
    (hpow_cont.preimage_mem_nhds (by simpa using Iio_mem_nhds (by norm_num : (1 : ℝ) < 2)))
  let δmin : ℝ := Finset.univ.inf' Finset.univ_nonempty δw
  have hδmin : 0 < δmin := (Finset.lt_inf'_iff Finset.univ_nonempty).mpr fun w _ ↦ hδw_pos w
  let ε₀ : ℝ := min δmin r_pow
  have hε₀ : 0 < ε₀ := lt_min hδmin hr_pow
  let c₀ : E_inf := L_inf (m_inf 1)
  let r₀ : ℝ := ε₀ / (‖(L_inf.symm : E_inf →L[ℝ] V_inf)‖ + 1)
  have hr₀ : 0 < r₀ := div_pos hε₀ (by positivity)
  have hr₀_sub (y : InfiniteAdeleRing F) (hy : L_inf (m_inf y) ∈ Metric.ball c₀ r₀) :
      (∀ w : InfinitePlace F, dist (y w) 1 < δw w) ∧
        ∏ w : InfinitePlace F, ‖y w‖ ^ w.mult < 2 := by
    have hmy : ‖m_inf (y - 1)‖ < ε₀ := by
      calc
        ‖m_inf (y - 1)‖ = ‖m_inf y - m_inf 1‖ := by rw [map_sub]
        _ = ‖L_inf.symm (L_inf (m_inf y) - c₀)‖ := by simp [c₀]
        _ ≤ ‖(L_inf.symm : E_inf →L[ℝ] V_inf)‖ * ‖L_inf (m_inf y) - c₀‖ :=
          (L_inf.symm : E_inf →L[ℝ] V_inf).le_opNorm _
        _ ≤ ‖(L_inf.symm : E_inf →L[ℝ] V_inf)‖ * r₀ := by
          rw [← dist_eq_norm]
          exact mul_le_mul_of_nonneg_left hy.out.le (norm_nonneg _)
        _ < (‖(L_inf.symm : E_inf →L[ℝ] V_inf)‖ + 1) * r₀ :=
          mul_lt_mul_of_pos_right (lt_add_one _) hr₀
        _ = ε₀ := mul_div_cancel₀ _ (by positivity)
    refine ⟨fun w ↦ ?_, ?_⟩
    · have hdw : dist (y w) 1 < ε₀ := by
        rw [dist_eq_norm]
        exact (harch (y - 1) w).trans_lt hmy
      exact hdw.trans_le ((min_le_left _ _).trans (Finset.inf'_le _ (Finset.mem_univ w)))
    · let d : ℝ := ‖m_inf (y - 1)‖
      have hd0 : 0 ≤ d := norm_nonneg _
      have hdr : d < r_pow := hmy.trans_le (min_le_right _ _)
      have hpow2 : (1 + d) ^ expSum < 2 := by
        have hball : d ∈ Metric.ball (0 : ℝ) r_pow := by
          simpa [Real.dist_eq, abs_of_nonneg hd0] using hdr
        simpa using hr_pow_lt hball
      have hterm (w : InfinitePlace F) : ‖y w‖ ^ w.mult ≤ (1 + d) ^ w.mult := by
        refine pow_le_pow_left₀ (norm_nonneg _) ?_ _
        calc
          ‖y w‖ = ‖(1 : w.Completion) + (y - 1) w‖ := by
            rw [show (1 : w.Completion) + (y - 1) w = y w from add_sub_cancel _ _]
          _ ≤ ‖(1 : w.Completion)‖ + ‖(y - 1) w‖ := norm_add_le _ _
          _ ≤ 1 + d := by rw [norm_one]; exact add_le_add_right (harch (y - 1) w) 1
      calc
        ∏ w : InfinitePlace F, ‖y w‖ ^ w.mult
            ≤ ∏ w : InfinitePlace F, (1 + d) ^ w.mult :=
          Finset.prod_le_prod₀ (fun _ _ ↦ pow_nonneg (norm_nonneg _) _) fun w _ ↦ hterm w
        _ = (1 + d) ^ expSum := by rw [Finset.prod_pow_eq_pow_sum]
        _ < 2 := hpow2
  let b : ContDiffBump c₀ := ⟨r₀ / 2, r₀, half_pos hr₀, half_lt_self hr₀⟩
  let S_inf : SchwartzMap E_inf ℂ :=
    (b.hasCompactSupport.comp_left Complex.ofReal_zero).toSchwartzMap
      (Complex.ofRealCLM.contDiff.comp b.contDiff)
  let A_inf := SchwartzMap.compCLMOfContinuousLinearEquiv ℂ L_inf S_inf
  let arch (y : InfiniteAdeleRing F) : ℂ := A_inf (m_inf y)
  let a_inf : SchwartzBruhat (Multiplicative (InfiniteAdeleRing F)) :=
    ⟨arch ∘ Multiplicative.toAdd, (mem_archimedeanSchwartzBruhat_iff arch).mpr ⟨A_inf, fun _ ↦ rfl⟩⟩
  have ha_apply (y : InfiniteAdeleRing F) :
      a_inf (Multiplicative.ofAdd y) = (b (L_inf (m_inf y)) : ℂ) := rfl
  -- Combine archimedean bump with finite-place indicator via sAdeleSchwartz_inductiveTensor_equiv.
  let g_fin (w : S₀) :=
    (finitePlaceSchwartz_compactOpen_indicator F w.val (K w.val) (hK_co w.val).1 (hK_co w.val).2).choose
  have hg_fin (w : S₀) (x : w.val.adicCompletion F) :
      g_fin w (Multiplicative.ofAdd x) = (K w.val).indicator (1 : w.val.adicCompletion F → ℂ) x :=
    (finitePlaceSchwartz_compactOpen_indicator F w.val (K w.val) (hK_co w.val).1 (hK_co w.val).2).choose_spec x
  let h_tens := sAdeleSchwartz_inductiveTensor_equiv F S₀
  let φ_S := h_tens.choose (a_inf ⊗ₜ[ℂ] (⨂ₜ[ℂ] w, g_fin w))
  let f : SchwartzBruhat (Multiplicative 𝔸[F]) := sAdeleSchwartzToGlobal F S₀ φ_S
  have hf_apply (x : 𝔸[F]) :
      f (Multiplicative.ofAdd x) =
        (b (L_inf (m_inf x.1)) : ℂ) *
          Set.indicator {y : 𝔸ᶠ[F] | ∀ w, y w ∈ K w} (fun _ ↦ (1 : ℂ)) x.2 := by
    let Q (w : V) := x.2 w ∈ w.adicCompletionIntegers F
    have hterm := h_tens.choose_spec a_inf g_fin (adeleProjection F S₀ x)
    have hsplit := rectangle_indicator_product S₀ (fun w ↦ x.2 w ∈ K w) Q
      {t : 𝔸ᶠ[F] | ∀ w, t w ∈ K w} x.2 Iff.rfl
      (fun w hw ↦ by simp [K, hw, Q]) (a_inf (Multiplicative.ofAdd x.1))
      (fun w ↦ g_fin w (Multiplicative.ofAdd (x.2 w.val)))
      (fun w hw ↦ (hg_fin w _).trans (Set.indicator_of_mem hw _))
      (fun w hw ↦ (hg_fin w _).trans (Set.indicator_of_notMem hw _))
    exact (sAdeleSchwartzToGlobal_apply F S₀ φ_S x).trans
      ((congrArg (fun v : ℂ ↦ if ∀ w ∉ S₀, Q w then v else 0) hterm).trans hsplit)
  have hf1 : f (Multiplicative.ofAdd (1 : 𝔸[F])) = 1 := by
    rw [hf_apply]
    simp only [Prod.snd_one, Prod.fst_one]
    have h1fin : (1 : 𝔸ᶠ[F]) ∈ {y : 𝔸ᶠ[F] | ∀ w, y w ∈ K w} := fun w ↦ hK_1 w
    rw [Set.indicator_of_mem h1fin, mul_one]
    change (b (L_inf (m_inf (1 : InfiniteAdeleRing F))) : ℂ) = 1
    rw [b.one_of_mem_closedBall (Metric.mem_closedBall_self b.rIn_pos.le), Complex.ofReal_one]
  -- Now show every norm-one idele h in the support of f maps into U under p.
  have hsupp : ∀ h : (ideleNorm F).ker, f (Multiplicative.ofAdd h.val.val) ≠ 0 → p h ∈ U := by
    intro h hfne
    rw [hf_apply] at hfne
    have hne_pair := mul_ne_zero_iff.mp hfne
    have hb_ne : b (L_inf (m_inf h.val.val.1)) ≠ 0 := fun hz ↦ hne_pair.1 (by simp [hz])
    have hball : L_inf (m_inf h.val.val.1) ∈ Metric.ball c₀ r₀ :=
      b.support_eq ▸ Function.mem_support.mpr hb_ne
    have hG := hr₀_sub h.val.val.1 hball
    have hKmem : ∀ w : V, h.val.val.2 w ∈ K w := by
      by_contra hnot
      exact hne_pair.2 (Set.indicator_of_notMem hnot _)
    have hfin_unit : ∀ w : V,
        (e h.val).2 w ∈ (w.adicCompletionIntegers F).units := by
      intro w
      rw [HeightOneSpectrum.adicCompletionIntegers.mem_units_iff_valued_eq_one]
      have hwval : ((e h.val).2 w : w.adicCompletion F) = h.val.val.2 w := (he h.val).2 w
      rw [hwval]
      by_cases hw : w ∈ S₀
      · have hmem := hKmem w
        dsimp only [K] at hmem
        rw [ite_eq_left hw, Set.mem_image] at hmem
        obtain ⟨r, hr, hzr⟩ := hmem
        have hzunit := (hKv_spec w ((e h.val).2 w) ⟨r, hr, hwval.symm ▸ hzr.symm⟩).1
        rw [← hwval]
        exact HeightOneSpectrum.adicCompletionIntegers.mem_units_iff_valued_eq_one.mp hzunit
      · have hmem : h.val.val.2 w ∈ (w.adicCompletionIntegers F : Set _) := by
          simpa [K, hw] using hKmem w
        have hle1 : Valued.v (h.val.val.2 w) ≤ 1 := hmem
        by_contra hne1
        have hlt1 : Valued.v (h.val.val.2 w) < 1 := lt_of_le_of_ne hle1 hne1
        have hne0 : h.val.val.2 w ≠ 0 := by
          have := (he h.val).2 w
          rw [← this]
          exact ((e h.val).2 w).ne_zero
        have hlog : WithZero.log (Valued.v (h.val.val.2 w)) ≤ -1 := by
          have := hlt1
          rw [← WithZero.exp_log (Valued.v.zero_iff.not.mpr hne0)] at this
          have hlt0 : WithZero.log (Valued.v (h.val.val.2 w)) < 0 :=
            WithZero.exp_lt_one_iff.mp this
          omega
        have hnorm_le : ‖h.val.val.2 w‖ ≤ (w.asIdeal.absNorm : ℝ)⁻¹ := by
          have hq1 : (1 : ℝ) ≤ w.asIdeal.absNorm := by
            exact_mod_cast (HeightOneSpectrum.one_lt_absNorm w).le
          rw [FinitePlace.norm_def,
            WithZeroMulInt.toNNReal_neg_apply _ (Valued.v.zero_iff.not.mpr hne0), NNReal.coe_zpow]
          exact (zpow_le_zpow_right₀ hq1 hlog).trans_eq (zpow_neg_one _)
        have hq2 : (2 : ℝ) ≤ w.asIdeal.absNorm := by
          exact_mod_cast HeightOneSpectrum.one_lt_absNorm w
        have hhalf : ‖h.val.val.2 w‖ ≤ 1 / 2 :=
          hnorm_le.trans (inv_le_of_inv_le₀ (by norm_num) (by simpa using hq2))
        have hall_le : ∀ v : V, ‖h.val.val.2 v‖ ≤ 1 := fun v ↦ by
          by_cases hvS : v ∈ S₀
          · have hmem' := hKmem v
            dsimp only [K] at hmem'
            rw [ite_eq_left hvS, Set.mem_image] at hmem'
            obtain ⟨r, hr, hzr⟩ := hmem'
            have hzv := (hKv_spec v ((e h.val).2 v) ⟨r, hr, ((he h.val).2 v).symm ▸ hzr.symm⟩).1
            have := HeightOneSpectrum.adicCompletionIntegers.mem_units_iff_valued_eq_one.mp hzv
            rw [← (he h.val).2 v]
            exact (Valued.toNormedField.norm_eq_one_iff.mpr this).le
          · have hmem' : h.val.val.2 v ∈ (v.adicCompletionIntegers F : Set _) := by
              simpa [K, hvS] using hKmem v
            exact Valued.toNormedField.norm_le_one_iff.mpr hmem'
        have hfin_prod_le : (∏ᶠ v : V, ‖h.val.val.2 v‖) ≤ 1 / 2 := by
          have hsup := (ideleNorm_spec F).1 h.val |>.1
          let S_sup := hsup.toFinset ∪ {w}
          have hmul_eq : (∏ᶠ v : V, ‖h.val.val.2 v‖) = ∏ v ∈ S_sup, ‖h.val.val.2 v‖ := by
            refine finprod_eq_prod_of_mulSupport_subset _ ?_
            intro v hv
            exact Finset.mem_union_left _ (hsup.mem_toFinset.mpr hv)
          rw [hmul_eq, ← Finset.mul_prod_erase S_sup _ (Finset.mem_union_right _ (Finset.mem_singleton_self w))]
          have hrest : ∏ v ∈ S_sup.erase w, ‖h.val.val.2 v‖ ≤ 1 :=
            Finset.prod_le_one₀ (fun v _ ↦ norm_nonneg _) (fun v _ ↦ hall_le v)
          exact (mul_le_mul_of_nonneg_left hrest (norm_nonneg _)).trans (by simpa using hhalf)
        have hnorm1 : ((ideleNorm F h.val : ℝ≥0) : ℝ) = 1 := by
          rw [h.property]; rfl
        rw [(ideleNorm_spec F).1 h.val |>.2] at hnorm1
        have hbad : (∏ w : InfinitePlace F, ‖h.val.val.1 w‖ ^ w.mult) *
            (∏ᶠ v : V, ‖h.val.val.2 v‖) < 2 * (1 / 2) := by
          calc
            (∏ w : InfinitePlace F, ‖h.val.val.1 w‖ ^ w.mult) * (∏ᶠ v : V, ‖h.val.val.2 v‖)
                ≤ (∏ w : InfinitePlace F, ‖h.val.val.1 w‖ ^ w.mult) * (1 / 2) :=
              mul_le_mul_of_nonneg_left hfin_prod_le
                (Finset.prod_nonneg fun _ _ ↦ pow_nonneg (norm_nonneg _) _)
            _ < 2 * (1 / 2) := mul_lt_mul_of_pos_right hG.2 (by norm_num)
        linarith
    have hinf_mem : (e h.val).1 ∈ U_inf := by
      apply hSinf_sub
      intro w hw
      apply hδw_mem w ((e h.val).1 w) _ hw
      simpa [(he h.val).1 w] using hG.1 w
    have hfin_mem : (e h.val).2 ∈ U_fin := by
      let u_fin : Π v : V, (v.adicCompletionIntegers F).units := fun v ↦ ⟨(e h.val).2 v, hfin_unit v⟩
      have hu_mem : u_fin ∈ RestrictedProduct.structureMap (fun v : V ↦ (v.adicCompletion F)ˣ)
          (fun v : V ↦ (v.adicCompletionIntegers F).units) Filter.cofinite ⁻¹' U_fin := by
        apply hS₀_sub
        intro w hw
        have hmem := hKmem w
        change h.val.val.2 w ∈ if w ∈ S₀ then _ else _ at hmem
        rw [ite_eq_left (Finset.mem_coe.mp hw), Set.mem_image] at hmem
        obtain ⟨r, hr, hzr⟩ := hmem
        exact (hKv_spec w ((e h.val).2 w) ⟨r, hr, ((he h.val).2 w).symm ▸ hzr.symm⟩).2
          (Finset.mem_coe.mp hw)
      have hu_eq : RestrictedProduct.structureMap (fun v : V ↦ (v.adicCompletion F)ˣ)
          (fun v : V ↦ (v.adicCompletionIntegers F).units) Filter.cofinite u_fin = (e h.val).2 := by
        ext v; rfl
      rw [← hu_eq]
      exact hu_mem
    have hprod_mem : e h.val ∈ W_prod := hsub_prod (Set.mk_mem_prod hinf_mem hfin_mem)
    have hWI_mem : h.val ∈ W_I := by
      rw [← e.symm_apply_apply h.val]
      exact hprod_mem
    change h ∈ W_N
    rw [← hWI_eq]
    exact hWI_mem
  refine ⟨f, hf1, fun x ↦ ?_, hsupp⟩
  rw [hf_apply]
  by_cases hs : x.2 ∈ {y : 𝔸ᶠ[F] | ∀ w, y w ∈ K w}
  · rw [Set.indicator_of_mem hs, mul_one]
    exact ⟨b.nonneg, rfl⟩
  · rw [Set.indicator_of_notMem hs, mul_zero]
    simp

/-- Every unitary character of `C₁` has a test function with nonzero homogeneous theta value at `1`. -/
private theorem exists_homogeneousAdelicTheta_apply_one_ne_zero (ω : PontryaginDual C₁) :
    ∃ f : SchwartzBruhat (Multiplicative 𝔸[F]), homogeneousAdelicTheta ω f 1 ≠ 0 := by
  classical
  let : MeasurableSpace (IdeleGroup (𝓞 F) F) := borel _
  let : BorelSpace (IdeleGroup (𝓞 F) F) := ⟨rfl⟩
  let : MeasurableSpace (IdeleClassGroup (𝓞 F) F) := borel _
  let : BorelSpace (IdeleClassGroup (𝓞 F) F) := ⟨rfl⟩
  let : T2Space C₁ := (ideleClassGroup_finiteness F).2.2.1
  let : CompactSpace C₁ := (ideleClassGroup_finiteness F).2.1
  let μ₁ := normOneIdeleTamagawaMeasure F
  let : μ₁.IsHaarMeasure := (normOneIdeleTamagawaMeasure_existsUnique F).exists.choose_spec.1
  let p : (ideleNorm F).ker → C₁ := fun x ↦ ⟨QuotientGroup.mk x.val, x.property⟩
  have hp : Continuous p :=
    (QuotientGroup.continuous_mk.comp continuous_subtype_val).subtype_mk _
  obtain ⟨f, hf1, hreal, hsupp⟩ := exists_idele_test_re_pos (F := F) ω
  refine ⟨f, ?_⟩
  change homogeneousAdelicTheta ω f (QuotientGroup.mk (1 : IdeleGroup (𝓞 F) F)) ≠ 0
  rw [homogeneousAdelicTheta_eq_idele_integral]
  have hint := homogeneousAdelicTheta_idele_integrable ω f 1
  let φ : (ideleNorm F).ker → ℂ := fun h ↦
    f (Multiplicative.ofAdd (h.val * (1 : IdeleGroup (𝓞 F) F)).val) * (ω (p h) : ℂ)
  have hfcont : Continuous (fun x : 𝔸[F] ↦ f (Multiplicative.ofAdd x)) :=
    (schwartzBruhat_continuous f).comp continuous_ofAdd
  have hmulcont : Continuous (fun h : (ideleNorm F).ker ↦ (h.val * (1 : IdeleGroup (𝓞 F) F)).val) :=
    Units.continuous_val.comp (continuous_subtype_val.mul_const 1)
  have hcont : Continuous (fun h ↦ (φ h).re) :=
    Complex.continuous_re.comp
      ((hfcont.comp hmulcont).mul (continuous_subtype_val.comp (ω.continuous.comp hp)))
  have hnonneg : ∀ h, 0 ≤ (φ h).re := by
    intro h
    dsimp only [φ]
    rw [mul_one]
    by_cases hzero : f (Multiplicative.ofAdd h.val.val) = 0
    · simp [hzero]
    · have hr := hreal h.val.val
      have hre_pos : 0 < (ω (p h) : ℂ).re := hsupp h hzero
      rw [Complex.mul_re, hr.2, zero_mul, sub_zero]
      exact mul_nonneg hr.1 hre_pos.le
  have h1pos : (φ 1).re ≠ 0 := by
    change (f (Multiplicative.ofAdd ((1 : IdeleGroup (𝓞 F) F) * 1).val) * (ω (p 1) : ℂ)).re ≠ 0
    have hp1 : p 1 = 1 := rfl
    rw [mul_one, Units.val_one, hf1, hp1, map_one, Circle.coe_one, mul_one, Complex.one_re]
    exact one_ne_zero
  have hint_φ : Integrable φ μ₁ := hint
  have hpos : 0 < ∫ h, (φ h).re ∂μ₁ :=
    integral_pos_of_integrable_nonneg_ne_zero hcont hint_φ.re hnonneg h1pos
  intro hz
  have hz_φ : ∫ h, φ h ∂μ₁ = 0 := hz
  exact hpos.ne' ((integral_re hint_φ).trans (congrArg Complex.re hz_φ))

/-- The isotypic average acts on its own isotype by scaling by total measure. -/
private theorem globalThetaIsotypicAverage_apply_isotype (ω : PontryaginDual C₁)
    (u : Θ𝔽) (hu : u ∈ E𝔽(ω)) :
    (existsUnique_globalThetaIsotypicAverage (F := F) ω).exists.choose u =
      ((normOneIdeleClassTamagawaMeasure F).real Set.univ : ℂ) • u := by
  let : T2Space Θ𝔽 := globalAdelicThetaSpace_t2_of_isClosed (adelicTheta_ker_isClosed (F := F))
  let : PolynormableSpace ℂ Θ𝔽 := globalAdelicThetaSpace_polynormable
  let : IsTopologicalAddGroup Θ𝔽 := PolynormableSpace.isTopologicalAddGroup ℂ _
  let : ContinuousSMul ℂ Θ𝔽 := PolynormableSpace.continuousSMul ℂ _
  let : Module ℝ Θ𝔽 := Module.restrictScalars ℝ ℂ _
  let : IsScalarTower ℝ ℂ Θ𝔽 := IsScalarTower.restrictScalars ℝ ℂ _
  let : LocallyConvexSpace ℝ Θ𝔽 := (PolynormableSpace.withSeminorms ℂ Θ𝔽).toLocallyConvexSpace
  let : UniformSpace Θ𝔽 := IsTopologicalAddGroup.rightUniformSpace Θ𝔽
  let : CompleteSpace Θ𝔽 := globalAdelicThetaSpace_complete
  let : MeasurableSpace (IdeleClassGroup (𝓞 F) F) := borel _
  let : BorelSpace (IdeleClassGroup (𝓞 F) F) := ⟨rfl⟩
  let : T2Space C₁ := (ideleClassGroup_finiteness F).2.2.1
  let : CompactSpace C₁ := (ideleClassGroup_finiteness F).2.1
  let μ := normOneIdeleClassTamagawaMeasure F
  let : μ.IsHaarMeasure := (multiplicativeTamagawaMeasures_existsUnique F).exists.choose_spec.2.2.2.1
  exact compactActionAverage_apply_isotype μ ((ρ𝔽).comp (C₁).subtype) ω _
    (existsUnique_globalThetaIsotypicAverage (F := F) ω).exists.choose_spec hu

/-- Distinct characters annihilate each other under the isotypic average. -/
private theorem globalThetaIsotypicAverage_apply_diff (ω ω' : PontryaginDual C₁)
    (hne : ω ≠ ω') (u : Θ𝔽) (hu : u ∈ E𝔽(ω)) :
    (existsUnique_globalThetaIsotypicAverage (F := F) ω').exists.choose u = 0 := by
  let : T2Space Θ𝔽 := globalAdelicThetaSpace_t2_of_isClosed (adelicTheta_ker_isClosed (F := F))
  let : PolynormableSpace ℂ Θ𝔽 := globalAdelicThetaSpace_polynormable
  let : IsTopologicalAddGroup Θ𝔽 := PolynormableSpace.isTopologicalAddGroup ℂ _
  let : ContinuousSMul ℂ Θ𝔽 := PolynormableSpace.continuousSMul ℂ _
  let : Module ℝ Θ𝔽 := Module.restrictScalars ℝ ℂ _
  let : IsScalarTower ℝ ℂ Θ𝔽 := IsScalarTower.restrictScalars ℝ ℂ _
  let : LocallyConvexSpace ℝ Θ𝔽 := (PolynormableSpace.withSeminorms ℂ Θ𝔽).toLocallyConvexSpace
  let : UniformSpace Θ𝔽 := IsTopologicalAddGroup.rightUniformSpace Θ𝔽
  let : CompleteSpace Θ𝔽 := globalAdelicThetaSpace_complete
  let : MeasurableSpace (IdeleClassGroup (𝓞 F) F) := borel _
  let : BorelSpace (IdeleClassGroup (𝓞 F) F) := ⟨rfl⟩
  let : T2Space C₁ := (ideleClassGroup_finiteness F).2.2.1
  let : CompactSpace C₁ := (ideleClassGroup_finiteness F).2.1
  let μ := normOneIdeleClassTamagawaMeasure F
  let : μ.IsHaarMeasure := (multiplicativeTamagawaMeasures_existsUnique F).exists.choose_spec.2.2.2.1
  let ρ₁ := (ρ𝔽).comp (C₁).subtype
  let Q' := (existsUnique_globalThetaIsotypicAverage (F := F) ω').exists.choose
  have hQ' := (existsUnique_globalThetaIsotypicAverage (F := F) ω').exists.choose_spec
  have hex : ∃ g : C₁, ω g ≠ ω' g := by
    by_contra hall
    push Not at hall
    exact hne (DFunLike.ext _ _ hall)
  obtain ⟨g, hg⟩ := hex
  have h1 : Q' (ρ₁ g u) = (ω g : ℂ) • Q' u := by
    rw [(mem_actionIsotype ρ₁ ω u).mp hu g, map_smul]
  have h2 : Q' (ρ₁ g u) = (ω' g : ℂ) • Q' u :=
    compactActionAverage_apply_action μ ρ₁ ω' Q' hQ' g u
  have hdiff : ((ω g : ℂ) - (ω' g : ℂ)) • Q' u = 0 := by
    rw [sub_smul, ← h1, ← h2, sub_self]
  have hneC : (ω g : ℂ) - (ω' g : ℂ) ≠ 0 :=
    sub_ne_zero.mpr (fun heq ↦ hg (Subtype.ext heq))
  exact (smul_eq_zero.mp hdiff).resolve_left hneC

/-- Abstract dense-range criterion for a linear product map equipped with compatible
isotypic projections on the target pieces. -/
private theorem product_denseRange_of_isotypic_proj {ι E : Type*} {T : ι → Type*}
    [AddCommGroup E] [Module ℂ E]
    [∀ ω, AddCommGroup (T ω)] [∀ ω, Module ℂ (T ω)] [∀ ω, TopologicalSpace (T ω)]
    (c : ℂ) (hc : c ≠ 0)
    (P : E → ∀ ω, T ω) (R : ι → E →ₗ[ℂ] E) (E_iso : ι → Submodule ℂ E)
    (e : ∀ ω, T ω ≃ₗ[ℂ] E_iso ω)
    (hPR : ∀ ω x, ((e ω (P x ω) : E_iso ω) : E) = R ω x)
    (hdiag : ∀ ω (u : E_iso ω), R ω (u : E) = c • (u : E))
    (hoff : ∀ ω ω', ω ≠ ω' → ∀ (u : E_iso ω), R ω' (u : E) = 0) :
    DenseRange P := by
  classical
  intro y
  rw [mem_closure_iff_nhds]
  intro U hU
  rw [nhds_pi, Filter.mem_pi'] at hU
  obtain ⟨S, t, ht, hsub⟩ := hU
  let q : E := ∑ ω ∈ S, c⁻¹ • ((e ω (y ω) : E_iso ω) : E)
  refine ⟨P q, hsub fun ω₀ hω₀ ↦ ?_, q, rfl⟩
  have hmatch : P q ω₀ = y ω₀ := by
    apply (e ω₀).injective
    apply Subtype.ext
    rw [hPR ω₀ q]
    dsimp only [q]
    rw [map_sum, Finset.sum_eq_single ω₀]
    · rw [map_smul, hdiag ω₀ (e ω₀ (y ω₀)), smul_smul, inv_mul_cancel₀ hc, one_smul]
    · intro ω _ hne
      rw [map_smul, hoff ω ω₀ hne (e ω (y ω)), smul_zero]
    · intro hn
      exact absurd hω₀ hn
  rw [hmatch]
  exact mem_of_mem_nhds (ht ω₀)

/-- The product map from the global theta quotient has dense range. -/
private theorem globalThetaProduct_denseRange :
    DenseRange (exists_globalThetaToHomogeneousProduct (F := F)).choose := by
  let P := (exists_globalThetaToHomogeneousProduct (F := F)).choose
  have hP := (exists_globalThetaToHomogeneousProduct (F := F)).choose_spec
  let Q (ω : PontryaginDual C₁) := (existsUnique_globalThetaIsotypicAverage (F := F) ω).exists.choose
  let e (ω : PontryaginDual C₁) := (globalThetaIsotypicAverage_equiv (F := F) ω).2.choose
  have he (ω : PontryaginDual C₁) := (globalThetaIsotypicAverage_equiv (F := F) ω).2.choose_spec
  let c : ℂ := ((normOneIdeleClassTamagawaMeasure F).real Set.univ : ℂ)
  have hc0 : c ≠ 0 := by
    let : MeasurableSpace (IdeleClassGroup (𝓞 F) F) := borel _
    let : BorelSpace (IdeleClassGroup (𝓞 F) F) := ⟨rfl⟩
    let : T2Space C₁ := (ideleClassGroup_finiteness F).2.2.1
    let : CompactSpace C₁ := (ideleClassGroup_finiteness F).2.1
    let μ := normOneIdeleClassTamagawaMeasure F
    let : μ.IsHaarMeasure := (multiplicativeTamagawaMeasures_existsUnique F).exists.choose_spec.2.2.2.1
    dsimp [c]
    exact_mod_cast (MeasureTheory.measureReal_univ_pos (μ := μ)).ne'
  have hPR : ∀ (ω : PontryaginDual C₁) (x : Θ𝔽),
      ((e ω (P x ω) : E𝔽(ω)) : Θ𝔽) = Q ω x := by
    intro ω x
    obtain ⟨f, rfl⟩ := Submodule.Quotient.mk_surjective (p := LinearMap.ker (adelicThetaLinearMap F)) x
    have hP_f : P (Submodule.Quotient.mk f) ω =
        (LinearMap.ker (homogeneousAdelicThetaLinearMap F ω)).mkQ f := hP.2 f ω
    have he_f := he ω f
    rw [hP_f]
    exact he_f
  with_reducible_and_instances
    exact product_denseRange_of_isotypic_proj c hc0 P (fun ω ↦ (Q ω).toLinearMap) (fun ω ↦ E𝔽(ω))
      (fun ω ↦ (e ω).toLinearEquiv) hPR
      (fun ω u ↦ globalThetaIsotypicAverage_apply_isotype ω u.1 u.2)
      (fun ω ω' hne u ↦ globalThetaIsotypicAverage_apply_diff ω ω' hne u.1 u.2)

end GlobalThetaProduct

/-- Paper: Remark 6.2.1.4(2), p. 298.
The global theta quotient has nonclosed image in the product of its homogeneous
quotients.
Deviation: The earlier continuous injection in (5.2.3.13) identifies the product map. -/
theorem globalThetaToHomogeneousProduct_not_isClosed_range :
    ¬ IsClosed (Set.range (exists_globalThetaToHomogeneousProduct (F := F)).choose) := by
  classical
  intro hclosed
  let P := (exists_globalThetaToHomogeneousProduct (F := F)).choose
  have hP := (exists_globalThetaToHomogeneousProduct (F := F)).choose_spec
  have hsurj : Surjective P := by
    intro y
    change y ∈ Set.range P
    rw [← hclosed.closure_eq]
    exact globalThetaProduct_denseRange (F := F) y
  let : Infinite (PontryaginDual C₁) := infinite_pontryaginDual_normOneIdeleClassGroup
  let ι : ℕ → PontryaginDual C₁ := Infinite.natEmbedding (PontryaginDual C₁)
  have hι : Injective ι := (Infinite.natEmbedding (PontryaginDual C₁)).injective
  have hne := fun n : ℕ ↦ exists_homogeneousAdelicTheta_apply_one_ne_zero (F := F) (ι n)
  choose g hg using hne
  let y : ∀ ω : PontryaginDual C₁, Θ𝔽ω(ω) := fun ω ↦
    if h : ∃ n : ℕ, ι n = ω then
      let n := h.choose
      ((n : ℂ) / homogeneousAdelicTheta (ι n) (g n) 1) •
        (LinearMap.ker (homogeneousAdelicThetaLinearMap F ω)).mkQ (g n)
    else 0
  obtain ⟨q, hq⟩ := hsurj y
  obtain ⟨f, rfl⟩ := Submodule.Quotient.mk_surjective
    (p := LinearMap.ker (adelicThetaLinearMap F)) q
  let : MeasurableSpace (IdeleClassGroup (𝓞 F) F) := borel _
  let : BorelSpace (IdeleClassGroup (𝓞 F) F) := ⟨rfl⟩
  let : T2Space C₁ := (ideleClassGroup_finiteness F).2.2.1
  let : CompactSpace C₁ := (ideleClassGroup_finiteness F).2.1
  let μ := normOneIdeleClassTamagawaMeasure F
  let : μ.IsHaarMeasure := (multiplicativeTamagawaMeasures_existsUnique F).exists.choose_spec.2.2.2.1
  let B : ℝ := ∫ h : C₁, ‖adelicTheta f h.val‖ ∂μ
  obtain ⟨n, hnB⟩ := exists_nat_gt B
  have hqn : P (Submodule.Quotient.mk f) (ι n) = y (ι n) := congrFun hq (ι n)
  have hP2 : P (Submodule.Quotient.mk f) (ι n) =
      (LinearMap.ker (homogeneousAdelicThetaLinearMap F (ι n))).mkQ f :=
    hP.2 f (ι n)
  rw [hP2] at hqn
  have hex : ∃ m : ℕ, ι m = ι n := ⟨n, rfl⟩
  have hm : hex.choose = n := hι hex.choose_spec
  have hyn : y (ι n) = ((n : ℂ) / homogeneousAdelicTheta (ι n) (g n) 1) •
      (LinearMap.ker (homogeneousAdelicThetaLinearMap F (ι n))).mkQ (g n) := by
    dsimp only [y]
    rw [dite_eq_left_of_eq_true (eq_true hex), hm]
  rw [hyn, ← map_smul] at hqn
  simp only [Submodule.mkQ_apply, Submodule.Quotient.eq, LinearMap.mem_ker] at hqn
  have heval1 := congrArg (fun φ : C((IdeleClassGroup (𝓞 F) F), ℂ) ↦ φ 1) hqn
  rw [map_sub, map_smul, ContinuousMap.sub_apply, homogeneousAdelicThetaLinearMap_apply,
    ContinuousMap.smul_apply, homogeneousAdelicThetaLinearMap_apply, ContinuousMap.zero_apply,
    sub_eq_zero, smul_eq_mul, div_mul_cancel₀ _ (hg n)] at heval1
  have hnorm_eq : ‖homogeneousAdelicTheta (ι n) f 1‖ = (n : ℝ) := by
    rw [heval1, Complex.norm_natCast]
  have hbound : ‖homogeneousAdelicTheta (ι n) f 1‖ ≤ B := by
    change ‖∫ h : C₁, adelicTheta f (h.val * 1) * ((ι n h : Circle) : ℂ) ∂μ‖ ≤
      ∫ h : C₁, ‖adelicTheta f h.val‖ ∂μ
    refine (norm_integral_le_integral_norm _).trans_eq (integral_congr_ae (.of_forall fun h ↦ ?_))
    dsimp only
    rw [mul_one, norm_mul, Circle.norm_coe, mul_one]
  linarith

/-- Paper: Remark 6.2.1.4(2), p. 298.
The topology on the global theta quotient induced by the product of homogeneous
quotients is strictly coarser than its intrinsic topology.
Deviation: The earlier continuous injection in (5.2.3.13) identifies the product map. -/
theorem globalThetaToHomogeneousProduct_not_isInducing :
    ¬ IsInducing (exists_globalThetaToHomogeneousProduct (F := F)).choose := by
  intro h
  let P := (exists_globalThetaToHomogeneousProduct (F := F)).choose
  let : UniformSpace Θ𝔽 := IsTopologicalAddGroup.rightUniformSpace _
  let : IsUniformAddGroup Θ𝔽 := isUniformAddGroup_of_addCommGroup
  let : CompleteSpace Θ𝔽 := globalAdelicThetaSpace_complete
  let (ω : PontryaginDual C₁) : UniformSpace (Θ𝔽ω(ω)) := IsTopologicalAddGroup.rightUniformSpace _
  let (ω : PontryaginDual C₁) : IsUniformAddGroup (Θ𝔽ω(ω)) := isUniformAddGroup_of_addCommGroup
  let (ω : PontryaginDual C₁) : T2Space (Θ𝔽ω(ω)) := by
    have : IsClosed (LinearMap.ker (homogeneousAdelicThetaLinearMap F ω) :
        Set (SchwartzBruhat (Multiplicative 𝔸[F]))) :=
      homogeneousAdelicTheta_ker_isClosed ω
    infer_instance
  exact globalThetaToHomogeneousProduct_not_isClosed_range (F := F)
    (AddMonoidHom.isUniformInducing_of_isInducing (f := P.toAddMonoidHom) h).isComplete_range.isClosed

end IsotypicSums

section StandardFunctions

local notation "L(" v ")" => HeightOneSpectrum.adicCompletion (R := 𝓞 F) F v
local notation "O(" v ")" => HeightOneSpectrum.adicCompletionIntegers (R := 𝓞 F) F v
local notation "U(" v ")" => ((O(v)).units : Set (L(v))ˣ)
local notation "μ(" v ")" => finiteLocalMultiplicativeTamagawaMeasure F v

local instance finiteIdeleMeasurableSpaceSec2 (v : V) : MeasurableSpace (L(v))ˣ := borel _

open Classical in
/-- Paper: Theorem 6.2.2.1, p. 298.
In the ramified case the zeta integral is the integer-unit mass for matching unit
characters and zero for all others. Compact support in the multiplicative group
gives integrability for every local quasi-character. -/
theorem finiteStandardGaussian_zeta_of_ramified (v : V) (c d : QuasiCharacter (L(v))ˣ)
    (_hc : ∃ u ∈ U(v), c u ≠ 1) :
    Integrable (fun g : (L(v))ˣ ↦ finiteStandardGaussian v c
      (Multiplicative.ofAdd g.val) * d g) (μ(v)) ∧
    (localIdelicZetaIntegral (μ(v)) (fun x ↦ finiteStandardGaussian v c
      (Multiplicative.ofAdd x)) d =
      if (∀ u ∈ U(v), d u = c u) then ((μ(v)) (U(v))).toReal else 0) := by
  classical
  let : BorelSpace (L(v))ˣ := ⟨rfl⟩
  let : (μ(v)).IsHaarMeasure := finiteLocalMultiplicativeTamagawaMeasure_isHaarMeasure v
  let q (g : (L(v))ˣ) := d g / c g
  have hc (g : (L(v))ˣ) : c g ≠ 0 := ((Group.isUnit g).map c).ne_zero
  have hram : ¬ ∀ u ∈ U(v), c u = 1 := fun h ↦
    _hc.elim fun u hu ↦ hu.2 (h u hu.1)
  have hfun : (fun g : (L(v))ˣ ↦ finiteStandardGaussian v c (Multiplicative.ofAdd g.val) * d g) =
      (U(v)).indicator q := by
    funext g
    by_cases hg : g ∈ U(v)
    · rw [Set.indicator_of_mem hg, finiteStandardGaussian_integerUnit v c g hg]
      exact (mul_comm _ _).trans (div_eq_mul_inv _ _).symm
    · rw [Set.indicator_of_notMem hg]
      have hv : g.val ∉ Units.val '' U(v) := fun ⟨u, hu, h⟩ ↦ hg ((Units.ext h) ▸ hu)
      have hz : finiteStandardGaussian v c (Multiplicative.ofAdd g.val) = 0 :=
        (ite_eq_right hram).trans (Set.indicator_of_notMem hv _)
      rw [hz, zero_mul]
  have hopen : IsOpen (U(v)) := Submonoid.isOpen_units (Valued.isOpen_valuationSubring _)
  have hcompact : IsCompact (U(v)) := Submonoid.units_isCompact
    (isCompact_iff_compactSpace.mpr (compactSpace_adicCompletionIntegers v))
  have hq : Continuous q := d.continuous.div c.continuous hc
  constructor
  · rw [hfun, integrable_indicator_iff hopen.measurableSet]
    exact hq.continuousOn.integrableOn_compact hcompact
  · change (∫ g : (L(v))ˣ, finiteStandardGaussian v c (Multiplicative.ofAdd g.val) * d g ∂μ(v)) = _
    rw [hfun, integral_indicator hopen.measurableSet]
    split_ifs with hmatch
    · have eqOne : Set.EqOn q (fun _ ↦ (1 : ℂ)) (U(v)) := fun u hu ↦
        (div_eq_one_iff_eq (hc u)).mpr (hmatch u hu)
      rw [setIntegral_congr_fun hopen.measurableSet eqOne, setIntegral_const]
      simp [measureReal_def]
    · push Not at hmatch
      obtain ⟨a, ha, hne⟩ := hmatch
      have hpre : (fun y : (L(v))ˣ ↦ a * y) ⁻¹' U(v) = U(v) := by
        ext y
        exact (O(v)).units.mul_mem_cancel_left ha
      have hI := (measurePreserving_mul_left (μ(v)) a).setIntegral_preimage_emb
        (Homeomorph.mulLeft a).toMeasurableEquiv.measurableEmbedding q (U(v))
      rw [hpre] at hI
      change (∫ y in U(v), q (a * y) ∂μ(v)) = ∫ y in U(v), q y ∂μ(v) at hI
      have hmul (y : (L(v))ˣ) : q (a * y) = q a * q y := by
        simp only [q, map_mul, mul_div_mul_comm]
      simp_rw [hmul] at hI
      rw [integral_const_mul, ← sub_eq_zero, ← sub_one_mul] at hI
      exact (mul_eq_zero.mp hI).resolve_left
        (sub_ne_zero.mpr (fun h ↦ hne ((div_eq_one_iff_eq (hc a)).mp h)))

/-- Paper: Theorem 6.2.2.1, p. 298.
Tensoring an archimedean test with the fixed standard tests at the finite places
gives a linear map into the S-adelic test space.
Deviation: The tensor identification uses the inductive topology of §2.1.4. -/
def sLocalStandardThetaTensor (c : QuasiCharacter Jₛ(S)) : ℬ∞ →ₗ[ℂ] ℬₛ(S) :=
  let e := (sAdeleSchwartz_inductiveTensor_equiv F S).choose
  let W := FinestLocallyConvex (⨂[ℂ] v : S, ℬ(L(v.val)))
  let g : W := ⨂ₜ[ℂ] v : S, finiteStandardGaussian v.val (sLocalFiniteRestriction v c)
  e.toLinearMap.comp ((TensorProduct.mk ℂ ℬ∞ W).flip g)

/-- Paper: Theorem 6.2.2.1, p. 298.
Evaluation on an S-adele multiplies the archimedean test value by the standard
finite test value at each finite coordinate. -/
theorem sLocalStandardThetaTensor_apply (c : QuasiCharacter Jₛ(S)) (f : ℬ∞)
    (x : SAdeleRing F S) :
    sLocalStandardThetaTensor c f (Multiplicative.ofAdd x) =
      f (Multiplicative.ofAdd x.1) * ∏ v : S, finiteStandardGaussian v.val
        (sLocalFiniteRestriction v c) (Multiplicative.ofAdd (x.2 v)) := by
  let factors (v : S) : ℬ(L(v.val)) :=
    finiteStandardGaussian (F := F) v.val (sLocalFiniteRestriction (F := F) v c)
  let W := FinestLocallyConvex (⨂[ℂ] v : S, ℬ(L(v.val)))
  let b : W := ⨂ₜ[ℂ] v : S, factors v
  let e := (sAdeleSchwartz_inductiveTensor_equiv F S).choose
  have slice {X Y Z : Type _} [AddCommGroup X] [Module ℂ X] [TopologicalSpace X]
      [AddCommGroup Y] [Module ℂ Y] [TopologicalSpace Y]
      [AddCommGroup Z] [Module ℂ Z] [TopologicalSpace Z]
      (E : InductiveTensor X Y ≃L[ℂ] Z) (a : X) (b : Y) (p : Z → ℂ) (r : ℂ)
      (h : p (E (a ⊗ₜ[ℂ] b)) = r) :
      p (E.toLinearMap.comp ((TensorProduct.mk ℂ X Y).flip b) a) = r := h
  have hx := (sAdeleSchwartz_inductiveTensor_equiv F S).choose_spec f factors x
  unfold sLocalStandardThetaTensor
  with_reducible_and_instances
    exact slice (X := ℬ∞) (Y := W) (Z := ℬₛ(S)) e f b
      (fun φ : ℬₛ(S) ↦ φ (Multiplicative.ofAdd x)) _ hx

/-- Paper: Theorem 6.2.2.1, p. 298.
For trivial S-integer Picard group, the archimedean test space maps continuously,
surjectively and openly onto the global isotype after tensoring with the standard tests.
Deviation: The existence of the stated descent requires unramifiedness outside S.
The fixed finite tensor factor identifies its domain with the archimedean test space. -/
theorem sLocalStandardThetaTensor_toGlobal_openQuotient
    (_hPic : Subsingleton Picₛ(S)) {ω : PontryaginDual C₁}
    (hω : NormOneCharacterUnramifiedOutside ω S) :
    let c := sIdeleRestriction F S hω.choose
    let χ := sLocalNormOneCharacter S ω hω
    IsOpenQuotientMap (fun f : ℬ∞ ↦ sLocalHomogeneousThetaToGlobal (ω := ω) hω
      ((Kₛω(S, χ)).mkQ (sLocalStandardThetaTensor (F := F) (S := S) c f))) := by sorry

local notation "I∞" => (InfiniteAdeleRing F)ˣ
local notation "N∞" => Nₛ((∅ : Finset V))
local notation "archPart(" D ")" => Units.map (RingHom.fst (InfiniteAdeleRing F)
  (∀ v : D, L(v.val))).toMonoidHom
local notation "archInsert(" D ")" =>
  Units.map (MonoidHom.inl (InfiniteAdeleRing F) (∀ v : D, L(v.val)))

/-- Paper: (6.2.2.3), p. 298.
Every term of the archimedean integral is absolutely integrable. The norm-one
archimedean measure is the Tamagawa measure for the stage with no finite places. -/
theorem infiniteStandardThetaAverage_integrable (χ : PontryaginDual Iₛ(S))
    (f : ℬ∞) (a x : I∞) :
    Integrable (fun g : N∞ ↦
      f (Multiplicative.ofAdd ((a * archPart((∅ : Finset V)) g.val)⁻¹ * x).val) *
        (χ (archInsert(S) (a * archPart((∅ : Finset V)) g.val)) : ℂ))
      (sNormOneIdeleTamagawaMeasure F ∅) := by sorry

/-- Paper: (6.2.2.3), p. 298.
The sum of archimedean integrals specifies a continuous linear map into the
continuous functions on the archimedean ideles. -/
theorem exists_infiniteStandardThetaAverage (χ : PontryaginDual Iₛ(S))
    (r : Fin (classNumber F) → Nₛ(S)) :
    ∃ A : ℬ∞ →L[ℂ] C(I∞, ℂ), ∀ f x,
      A f x = ∑ k, ∫ g : N∞,
        let a := archPart(S) (r k).val * archPart((∅ : Finset V)) g.val
        f (Multiplicative.ofAdd (a⁻¹ * x).val) * (χ (archInsert(S) a) : ℂ)
        ∂sNormOneIdeleTamagawaMeasure F ∅ := by sorry

/-- Paper: (6.2.2.3), p. 298.
The archimedean operator sums the character-weighted integrals over the
norm-one archimedean ideles, one translate for each entry of the supplied family.
Deviation: The analytic formula works for arbitrary entries. To obtain the printed sum,
choose ideal class representatives with the identity representing the principal class. -/
def infiniteStandardThetaAverage (χ : PontryaginDual Iₛ(S))
    (r : Fin (classNumber F) → Nₛ(S)) : ℬ∞ →L[ℂ] C(I∞, ℂ) :=
  (exists_infiniteStandardThetaAverage χ r).choose

/-- Paper: (6.2.2.3), p. 298.
Evaluation on an archimedean idele gives the finite sum in the paper. -/
theorem infiniteStandardThetaAverage_apply (χ : PontryaginDual Iₛ(S))
    (r : Fin (classNumber F) → Nₛ(S)) (f : ℬ∞) (x : I∞) :
    infiniteStandardThetaAverage χ r f x = ∑ k, ∫ g : N∞,
      let a := archPart(S) (r k).val * archPart((∅ : Finset V)) g.val
      f (Multiplicative.ofAdd (a⁻¹ * x).val) * (χ (archInsert(S) a) : ℂ)
      ∂sNormOneIdeleTamagawaMeasure F ∅ :=
  (exists_infiniteStandardThetaAverage χ r).choose_spec f x

-- In §5.3.1 the punctured-field tests are additive tests vanishing at zero.
-- Local constancy makes these vanish on a neighborhood of zero.
/-- Paper: (6.2.2.4), p. 299.
The punctured-field tests form the subspace of additive Schwartz–Bruhat functions with
value zero at the origin, equipped with its induced topology as in §5.3.1. -/
def finitePuncturedThetaTestSpace (v : V) : Submodule ℂ ℬ(L(v)) :=
  LinearMap.ker ((LinearMap.proj (Multiplicative.ofAdd (0 : L(v)))).comp
    (schwartzBruhatSubmodule (Multiplicative (L(v)))).subtype)

/-- Paper: (6.2.2.4), p. 299.
An additive test belongs to the punctured-field subspace exactly when it vanishes at zero. -/
theorem mem_finitePuncturedThetaTestSpace (v : V) (f : ℬ(L(v))) :
    f ∈ finitePuncturedThetaTestSpace v ↔ f (Multiplicative.ofAdd (0 : L(v))) = 0 := Iff.rfl

local notation "ℬ₀(" v ")" => ↥(finitePuncturedThetaTestSpace v)

/-- A locally constant compactly supported field test vanishing at zero is integrable
after inverse translation on the unit group and multiplication by a continuous factor. -/
private theorem finiteStandardThetaAverage_integrable_of_locallyConstant
    {K : Type*} [NormedField K] [MeasurableSpace Kˣ] [BorelSpace Kˣ]
    (μ : Measure Kˣ) [IsFiniteMeasureOnCompacts μ] (test : K → ℂ)
    (hloc : IsLocallyConstant test) (hcompact : HasCompactSupport test) (hzero : test 0 = 0)
    (c : Kˣ → ℂ) (hc : Continuous c) (x : Kˣ) :
    Integrable (fun g : Kˣ ↦ test (g⁻¹ * x).val * c g) μ := by
  have hclosed : IsClosed (Function.support test) := (hloc.isClopen_fiber 0).2.isClosed_compl
  have hrange : tsupport test ⊆ Set.range (Units.val : Kˣ → K) := by
    intro y hy
    have hmem : y ∈ Function.support test := by
      rwa [tsupport, hclosed.closure_eq] at hy
    have hy0 : y ≠ 0 := by
      rintro rfl
      exact hmem hzero
    exact ⟨Units.mk0 y hy0, rfl⟩
  have hpre : IsCompact (Units.val ⁻¹' tsupport test : Set Kˣ) := by
    rw [(Units.isEmbedding_val₀ (G₀ := K)).isCompact_iff,
      Set.image_preimage_eq_of_subset hrange]
    exact hcompact
  let unitTest : Kˣ → ℂ := test ∘ Units.val
  have hsupport : HasCompactSupport unitTest :=
    hpre.of_isClosed_subset (isClosed_tsupport _)
      (tsupport_comp_subset_preimage test Units.continuous_val)
  let shift : Kˣ ≃ₜ Kˣ := (Homeomorph.inv Kˣ).trans (Homeomorph.mulRight x)
  have hcont : Continuous (unitTest ∘ shift) :=
    (hloc.continuous.comp Units.continuous_val).comp shift.continuous
  change Integrable (fun g : Kˣ ↦ (unitTest ∘ shift) g * c g) μ
  exact (hcont.mul hc).integrable_of_hasCompactSupport (hsupport.comp_homeomorph shift).mul_right

/-- Paper: (6.2.2.4), p. 299.
The finite-place integral of a compactly supported test on the punctured field is absolutely
integrable for every translation and unitary character. -/
theorem finiteStandardThetaAverage_integrable (v : V) (χ : PontryaginDual (L(v))ˣ)
    (f : ℬ₀(v)) (x : (L(v))ˣ) :
    Integrable (fun g : (L(v))ˣ ↦ f.val (Multiplicative.ofAdd (g⁻¹ * x).val) * (χ g : ℂ)) (μ(v)) := by
  let test (y : L(v)) : ℂ := f.val (Multiplicative.ofAdd y)
  have htest : IsLocallyConstant test ∧ HasCompactSupport test :=
    (mem_finitePlaceSchwartz_iff F v test).mp ⟨f.val, fun _ ↦ rfl⟩
  have hzero : test 0 = 0 := (mem_finitePuncturedThetaTestSpace v f.val).mp f.property
  have hχ : Continuous (fun g : (L(v))ˣ ↦ (χ g : ℂ)) :=
    continuous_subtype_val.comp χ.continuous
  let : BorelSpace (L(v))ˣ := ⟨rfl⟩
  let : (μ(v)).IsHaarMeasure := finiteLocalMultiplicativeTamagawaMeasure_isHaarMeasure v
  exact finiteStandardThetaAverage_integrable_of_locallyConstant (μ(v)) test htest.1 htest.2 hzero
    (fun g : (L(v))ˣ ↦ (χ g : ℂ)) hχ x

/-- On a group with a left-invariant measure, convolving against a character
factors as the character times the value at the identity. -/
private theorem exists_finiteStandardThetaAverage_factor {G : Type*} [Group G]
    [MeasurableSpace G] [MeasurableMul G] (ν : Measure G) [ν.IsMulLeftInvariant]
    (φ : G → ℂ) (c : G →* Circle) (x : G) :
    (∫ g, φ (g⁻¹ * x) * (c g : ℂ) ∂ν) = (c x : ℂ) * ∫ g, φ g⁻¹ * (c g : ℂ) ∂ν := by
  rw [← integral_mul_left_eq_self (fun g ↦ φ (g⁻¹ * x) * (c g : ℂ)) x, ← integral_const_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun g ↦ ?_)
  simp only [mul_inv_rev, inv_mul_cancel_right, map_mul, Circle.coe_mul]
  ring

/-- Convolution against a character, on a subspace of a space where every linear functional
is continuous, is a continuous linear map into the continuous functions: it is the character
times the value of a linear functional. -/
private theorem exists_finiteStandardThetaAverage_abstract {B G : Type*} [AddCommGroup B]
    [Module ℂ B] [TopologicalSpace B] (p : Submodule ℂ B)
    (hB : ∀ L : B →ₗ[ℂ] ℂ, Continuous L) [Group G] [TopologicalSpace G]
    {_ : MeasurableSpace G} [MeasurableMul G] (ν : Measure G) [ν.IsMulLeftInvariant]
    (χ : G →* Circle) (hχ : Continuous χ) (ev : p →ₗ[ℂ] G → ℂ)
    (hint : ∀ f, Integrable (fun g ↦ ev f g⁻¹ * (χ g : ℂ)) ν) :
    ∃ A : p →L[ℂ] C(G, ℂ), ∀ f x, A f x = ∫ g, ev f (g⁻¹ * x) * (χ g : ℂ) ∂ν := by
  let c₀ : p →ₗ[ℂ] ℂ :=
    { toFun := fun f ↦ ∫ g, ev f g⁻¹ * (χ g : ℂ) ∂ν
      map_add' := fun f h ↦ by
        simp only [map_add, Pi.add_apply, add_mul]
        exact integral_add (hint f) (hint h)
      map_smul' := fun a f ↦ by
        simp only [map_smul, Pi.smul_apply, smul_eq_mul, mul_assoc, RingHom.id_apply]
        exact integral_const_mul a _ }
  obtain ⟨P, hP⟩ := LinearMap.exists_leftInverse_of_injective p.subtype p.ker_subtype
  have hc₀ : Continuous c₀ :=
    ((hB (c₀.comp P)).comp continuous_subtype_val).congr fun f ↦
      congrArg c₀ (LinearMap.congr_fun hP f)
  let χC : C(G, ℂ) := ⟨fun g ↦ (χ g : ℂ), continuous_subtype_val.comp hχ⟩
  refine ⟨(ContinuousLinearMap.mk c₀ hc₀).smulRight χC, fun f x ↦ ?_⟩
  rw [exists_finiteStandardThetaAverage_factor ν (ev f) χ x, mul_comm]
  rfl

/-- Paper: (6.2.2.4), p. 299.
The finite-place convolution formula specifies a continuous linear map on
locally constant, compactly supported functions on the punctured field. -/
theorem exists_finiteStandardThetaAverage (v : V) (χ : PontryaginDual (L(v))ˣ) :
    ∃ A : ℬ₀(v) →L[ℂ] C((L(v))ˣ, ℂ), ∀ f x,
      A f x = ∫ g : (L(v))ˣ, f.val (Multiplicative.ofAdd (g⁻¹ * x).val) * (χ g : ℂ) ∂μ(v) := by
  let : BorelSpace (L(v))ˣ := ⟨rfl⟩
  let : (μ(v)).IsHaarMeasure := finiteLocalMultiplicativeTamagawaMeasure_isHaarMeasure v
  let ev : ℬ₀(v) →ₗ[ℂ] (L(v))ˣ → ℂ :=
    (LinearMap.funLeft ℂ ℂ fun y : (L(v))ˣ ↦ Multiplicative.ofAdd y.val).comp
      (((schwartzBruhatSubmodule (Multiplicative (L(v)))).subtype : ℬ(L(v)) →ₗ[ℂ] _).comp
        (finitePuncturedThetaTestSpace v).subtype)
  have hB (L : ℬ(L(v)) →ₗ[ℂ] ℂ) : Continuous L :=
    (congrArg (fun t ↦ @Continuous ℬ(L(v)) ℂ t _ L)
      (finitePlaceSchwartz_finestTopology F v)).mpr
      (continuous_of_finestLocallyConvex ℬ(L(v)) L)
  have hint (f : ℬ₀(v)) : Integrable (fun g ↦ ev f g⁻¹ * (χ g : ℂ)) (μ(v)) :=
    (finiteStandardThetaAverage_integrable v χ f 1).congr
      (Filter.Eventually.of_forall fun g ↦ congrArg (fun y : (L(v))ˣ ↦ ev f y * (χ g : ℂ))
        (mul_one g⁻¹))
  exact exists_finiteStandardThetaAverage_abstract (finitePuncturedThetaTestSpace v) hB (μ(v))
    χ.toMonoidHom χ.continuous ev hint

/-- Paper: (6.2.2.4), p. 299.
The finite operator convolves a compactly supported punctured-field test with the local
character against multiplicative Tamagawa measure. The inverse in the test gives the
Mellin functional for the inverse character at the identity. -/
def finiteStandardThetaAverage (v : V) (χ : PontryaginDual (L(v))ˣ) :
    ℬ₀(v) →L[ℂ] C((L(v))ˣ, ℂ) :=
  (exists_finiteStandardThetaAverage v χ).choose

/-- Paper: (6.2.2.4), p. 299.
At the identity, the finite convolution integrates the inverse pullback of the test
against the local character. -/
theorem finiteStandardThetaAverage_one (v : V) (χ : PontryaginDual (L(v))ˣ)
    (f : ℬ₀(v)) :
    finiteStandardThetaAverage v χ f 1 =
      ∫ g : (L(v))ˣ, f.val (Multiplicative.ofAdd (g⁻¹).val) * (χ g : ℂ) ∂μ(v) := by
  have h := (exists_finiteStandardThetaAverage v χ).choose_spec f 1
  simpa [finiteStandardThetaAverage] using h

/-- Paper: (6.2.2.11), p. 301.
The finite convolution is the character times the Mellin integral with the inverse character.
Deviation: On the test χ times the unit indicator, the coefficient is the integer-unit mass. -/
theorem finiteStandardThetaAverage_eq_character_mul_integral (v : V)
    (χ : PontryaginDual (L(v))ˣ) (f : ℬ₀(v)) (x : (L(v))ˣ) :
    finiteStandardThetaAverage v χ f x = (χ x : ℂ) *
      ∫ y : (L(v))ˣ, f.val (Multiplicative.ofAdd y.val) * (χ y : ℂ)⁻¹ ∂μ(v) := by
  let : BorelSpace (L(v))ˣ := ⟨rfl⟩
  let : (μ(v)).IsHaarMeasure := finiteLocalMultiplicativeTamagawaMeasure_isHaarMeasure v
  let : ProperSpace (L(v)) := properSpace_adicCompletion v
  let : LocallyCompactSpace (L(v))ˣ :=
    (IsOpenUnits.isOpenEmbedding_unitsVal (M := L(v))).locallyCompactSpace
  have : (μ(v)).IsInvInvariant := by
    constructor
    unfold finiteLocalMultiplicativeTamagawaMeasure
    rw [Measure.inv_def, Measure.map_smul, Measure.map_inv_eq_self]
    exact measurable_inv.aemeasurable
  have factor {G : Type _} [CommGroup G] [MeasurableSpace G] [MeasurableMul G] [MeasurableInv G]
      (ν : Measure G) [ν.IsInvInvariant] [ν.IsMulLeftInvariant]
      (φ : G → ℂ) (c : G →* Circle) (x : G) :
      (∫ g, φ (g⁻¹ * x) * (c g : ℂ) ∂ν) = (c x : ℂ) * ∫ y, φ y * (c y : ℂ)⁻¹ ∂ν := by
    let k (g : G) := φ (g⁻¹ * x) * (c g : ℂ)
    refine (integral_div_left_eq_self k ν x).symm.trans ?_
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with y
    change φ ((x / y)⁻¹ * x) * (c (x / y) : ℂ) = _
    rw [inv_div, div_mul_cancel, map_div, Circle.coe_div, div_eq_mul_inv]
    ring
  exact ((exists_finiteStandardThetaAverage v χ).choose_spec f x).trans
    (factor (μ(v)) (fun y ↦ f.val (Multiplicative.ofAdd y.val)) χ.toMonoidHom x)

/-- Paper: Theorem 6.2.2.1(1), p. 299.
The kernel of the archimedean operator is closed in the archimedean test space. -/
theorem infiniteStandardThetaAverage_isClosed_ker (χ : PontryaginDual Iₛ(S))
    (r : Fin (classNumber F) → Nₛ(S)) :
    IsClosed ((infiniteStandardThetaAverage χ r).ker : Set ℬ∞) :=
  ContinuousLinearMap.isClosed_ker _

/-- Paper: Theorem 6.2.2.1(1), p. 299.
The kernel of the finite convolution is closed in the multiplicative test space. -/
theorem finiteStandardThetaAverage_isClosed_ker (v : V) (χ : PontryaginDual (L(v))ˣ) :
    IsClosed ((finiteStandardThetaAverage v χ).ker : Set (ℬ₀(v))) :=
  ContinuousLinearMap.isClosed_ker _

-- TODO(paper-gap): The tensor agreement in Theorem 6.2.2.1(1), p. 299, fails.
-- For ℚ at S = {∞, p} with trivial character, take a finite test 1_{pℤₚˣ}
-- and a nonnegative even archimedean bump at ±1 supported away from ±p.
-- At the identity the full norm-one integral is zero, because the finite
-- support forces the absolute value of the inverse real component to be p.
-- The product of the separate integrals is strictly positive.

/-- Paper: Theorem 6.2.2.1(1), p. 299.
Integrating over a single archimedean norm fibre gives the archimedean factor of the
Mellin transform with the character convention of §5.2.
Deviation: (6.2.2.3) uses the inverse argument and sums translates over ideal classes.
The product formula of §3.3 uses one fibre with the positive argument. -/
theorem exists_infiniteStandardThetaMellinAverage (χ : PontryaginDual Iₛ(S)) :
    ∃ A : ℬ∞ →L[ℂ] C(I∞, ℂ), ∀ f x,
      A f x = ∫ g : N∞,
        let h := archPart((∅ : Finset V)) g.val
        f (Multiplicative.ofAdd (h * x).val) * (χ (archInsert(S) h) : ℂ)
        ∂sNormOneIdeleTamagawaMeasure F ∅ := by
  let D : Finset V := ∅
  let (w : InfinitePlace F) : MeasurableSpace w.Completion := borel _
  let (v : V) : MeasurableSpace (v.adicCompletion F) := borel _
  let (w : InfinitePlace F) : BorelSpace w.Completion := ⟨rfl⟩
  let (v : V) : BorelSpace (v.adicCompletion F) := ⟨rfl⟩
  let (w : InfinitePlace F) : SecondCountableTopology w.Completion :=
    (InfinitePlace.Completion.isometry_extensionEmbedding w).isEmbedding.secondCountableTopology
  let (v : V) : ProperSpace (v.adicCompletion F) := properSpace_adicCompletion v
  let : MeasurableSpace (SAdeleRing F D) := inferInstanceAs
    (MeasurableSpace (((w : InfinitePlace F) → w.Completion) × ((v : D) → v.val.adicCompletion F)))
  let : BorelSpace (SAdeleRing F D) := inferInstanceAs
    (BorelSpace (((w : InfinitePlace F) → w.Completion) × ((v : D) → v.val.adicCompletion F)))
  let : BorelSpace Iₛ(D) := by
    refine ⟨?_⟩
    rw [(sIdeleGroup_description F D).1.eq_induced, borel_comap, ← BorelSpace.measurable_eq]
    rfl
  let ν := sNormOneIdeleTamagawaMeasure F (∅ : Finset V)
  let : LocallyCompactSpace Iₛ((∅ : Finset V)) := (sIdeleGroup_description F ∅).2.2.1
  have hn : Continuous (sIdeleNorm F (∅ : Finset V)) :=
    (isProperMap_sIdeleQuotientNorm F ∅).continuous.comp continuous_quotient_mk'
  have hK : IsClosed (N∞ : Set Iₛ((∅ : Finset V))) :=
    isClosed_eq hn continuous_const
  let : LocallyCompactSpace N∞ := hK.locallyCompactSpace
  let : ν.IsHaarMeasure := (sNormOneIdeleTamagawaMeasure_existsUnique F ∅).exists.choose_spec.1
  let : ν.Regular := (sNormOneIdeleTamagawaMeasure_existsUnique F ∅).exists.choose_spec.2.1
  obtain ⟨A, hA⟩ := exists_infiniteStandardThetaAverage χ⁻¹ (fun _ ↦ 1)
  refine ⟨(classNumber F : ℂ)⁻¹ • A, fun f x ↦ ?_⟩
  let K (g : N∞) := f (Multiplicative.ofAdd ((archPart((∅ : Finset V)) g.val) * x).val) *
    (χ (archInsert(S) (archPart((∅ : Finset V)) g.val)) : ℂ)
  have hf := hA f x
  have hi : (∫ g : N∞, K g⁻¹ ∂ν) = ∫ g : N∞, K g ∂ν := integral_inv_eq_self K ν
  have hj : A f x = (classNumber F : ℂ) * ∫ g : N∞, K g ∂ν := by
    rw [hf, ← hi]
    simp only [OneMemClass.coe_one, map_one, one_mul, K, InvMemClass.coe_inv, map_inv,
      Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    rfl
  change (classNumber F : ℂ)⁻¹ * A f x = ∫ g : N∞, K g ∂ν
  rw [hj, ← mul_assoc, inv_mul_cancel₀ (Nat.cast_ne_zero.mpr (classNumber_pos F).ne'), one_mul]

/-- Paper: Theorem 6.2.2.1(1), p. 299.
The archimedean Mellin average integrates the positive translate against the given character.
Deviation: This uses the single norm fibre occurring in the Mellin integral of §3.3. -/
def infiniteStandardThetaMellinAverage (χ : PontryaginDual Iₛ(S)) : ℬ∞ →L[ℂ] C(I∞, ℂ) :=
  (exists_infiniteStandardThetaMellinAverage χ).choose

/-- Paper: Theorem 6.2.2.1(1), p. 299.
At each idele the Mellin average evaluates to the character-weighted norm-fibre integral.
Deviation: The factors follow the homogeneous transform of §5.2. -/
theorem infiniteStandardThetaMellinAverage_apply (χ : PontryaginDual Iₛ(S)) (f : ℬ∞)
    (x : I∞) :
    infiniteStandardThetaMellinAverage χ f x = ∫ g : N∞,
      let h := archPart((∅ : Finset V)) g.val
      f (Multiplicative.ofAdd (h * x).val) * (χ (archInsert(S) h) : ℂ)
      ∂sNormOneIdeleTamagawaMeasure F ∅ :=
  (exists_infiniteStandardThetaMellinAverage χ).choose_spec f x

/-- Paper: Theorem 6.2.2.1(1), p. 299.
Tensoring with the standard finite test identifies the local homogeneous quotient with
the archimedean quotient by the kernel of the archimedean Mellin average.
Deviation: This kernel uses the character orientation of §5.2 and the single norm fibre
of §3.3. The fixed tensor factor is expressed by insertion. -/
theorem sLocalStandardThetaTensor_quotient_equiv
    (_hPic : Subsingleton Picₛ(S)) {ω : PontryaginDual C₁}
    (hω : NormOneCharacterUnramifiedOutside ω S) (χ : PontryaginDual Iₛ(S))
    (_hχ : ∀ (g : Nₛ(S)) (y : J₁(S)), y.val = QuotientGroup.mk g.val →
      χ g.val = sLocalNormOneCharacter S ω hω y) :
    let c := sIdeleRestriction F S hω.choose
    let χS := sLocalNormOneCharacter S ω hω
    let K := (infiniteStandardThetaMellinAverage χ).ker
    ∃ e : (ℬ∞ ⧸ K) ≃L[ℂ] Θₛω(S, χS), ∀ f : ℬ∞,
      e (K.mkQ f) = (Kₛω(S, χS)).mkQ (sLocalStandardThetaTensor c f) := by sorry

-- TODO(paper-gap): The archimedean output need not be constant on norm fibres
-- for nontrivial characters. Use a norm section for the logarithmic profile.
-- At norm zero the paper only obtains logarithmic growth, so a Schwartz
-- profile without a positive weight would fail even over ℚ with a Gaussian.

/-- Paper: Theorem 6.2.2.1(2), p. 299.
The archimedean operator has forward semi-exponential decay along the norm
coordinate, including all logarithmic derivatives.
Deviation: The profile is evaluated on the canonical norm section. Every strictly
positive norm weight gives a Schwartz profile, as allowed by the growth in (6.2.2.12). -/
theorem infiniteStandardThetaAverage_forwardDecay (χ : PontryaginDual Iₛ(S))
    (r : Fin (classNumber F) → Nₛ(S)) (f : ℬ∞) :
    (fun t : ℝ ↦
      let u : ℝ≥0ˣ := Units.mk0 (Real.toNNReal (Real.exp t))
        (Real.toNNReal_eq_zero.not.mpr (not_le_of_gt (Real.exp_pos t)))
      let x := Units.map (RingHom.fst (InfiniteAdeleRing F)
        (FiniteAdeleRing (𝓞 F) F)).toMonoidHom (canonicalIdeleNormSection F u)
      infiniteStandardThetaAverage χ r f x) ∈ logExponentialDecaySubmodule (Set.Ioi 0) := by sorry

/-- Paper: (6.2.2.12), p. 302.
Near norm zero, the archimedean operator grows at most as the logarithm to the
power of the number of archimedean places minus one. -/
theorem infiniteStandardThetaAverage_logBound (χ : PontryaginDual Iₛ(S))
    (r : Fin (classNumber F) → Nₛ(S)) (f : ℬ∞) :
    ∃ C ε : ℝ, 0 < C ∧ 0 < ε ∧ ∀ x : I∞,
      ((infiniteIdeleNorm F x).val : ℝ) < ε →
      ‖infiniteStandardThetaAverage χ r f x‖ ≤
        C * |Real.log (infiniteIdeleNorm F x).val| ^ (Fintype.card (InfinitePlace F) - 1) := by sorry

end StandardFunctions

/-- Pullback along the unique real coordinate identifies real Schwartz functions with
the rational adelic test functions at the stage with no finite places. -/
private theorem ratTrivialHomogeneousTheta_quotient_realEquiv :
    ∃ E : SchwartzMap ℝ ℂ ≃L[ℂ] ℬ(SAdeleRing ℚ ∅),
      ∀ (f : SchwartzMap ℝ ℂ) (x : SAdeleRing ℚ ∅),
        E f (Multiplicative.ofAdd x) = f (InfinitePlace.Completion.ringEquivRealOfIsReal
          Rat.isReal_infinitePlace (x.1 Rat.infinitePlace)) := by
  let D : Type := (v : (∅ : Finset (HeightOneSpectrum (𝓞 ℚ)))) → v.val.adicCompletion ℚ
  let _ : Unique D := uniqueOfSubsingleton 0
  let real : Rat.infinitePlace.Completion ≃ᵢ ℝ :=
    InfinitePlace.Completion.isometryEquivRealOfIsReal Rat.isReal_infinitePlace
  let coord : SAdeleRing ℚ ∅ ≃ₜ ℝ := (Homeomorph.prodUnique (InfiniteAdeleRing ℚ) D).trans
    ((Homeomorph.piUnique (fun v : InfinitePlace ℚ ↦ v.Completion)).trans real.toHomeomorph)
  let e : Multiplicative (SAdeleRing ℚ ∅) ≃ₜ* Multiplicative ℝ :=
    ContinuousMulEquiv.mk' coord fun x y ↦
      (InfinitePlace.Completion.ringEquivRealOfIsReal Rat.isReal_infinitePlace).map_add
        (x.toAdd.1 Rat.infinitePlace) (y.toAdd.1 Rat.infinitePlace)
  with_reducible refine realSchwartzBruhat_equiv.elim fun R hR ↦ ?_
  refine ⟨R.trans (schwartzBruhatPullbackEquiv e), ?_⟩
  intro f x
  exact hR f (coord x)

/-- Paper: Example 6.2.2.2, p. 299.
The trivial homogeneous theta space over the rationals is a topological linear
quotient of real Schwartz functions, inserted with the integer indicator at every finite place. -/
theorem ratTrivialHomogeneousTheta_quotient :
    ∃ q : SchwartzMap ℝ ℂ →L[ℂ] GlobalHomogeneousThetaSpace ℚ 1,
      IsOpenQuotientMap q ∧
      ∀ (f : SchwartzMap ℝ ℂ) (g : ℬ(InfiniteAdeleRing ℚ)),
        (∀ x : InfiniteAdeleRing ℚ, g (Multiplicative.ofAdd x) =
          f (InfinitePlace.Completion.ringEquivRealOfIsReal Rat.isReal_infinitePlace
            (x Rat.infinitePlace))) →
        q f = (LinearMap.ker (homogeneousAdelicThetaLinearMap ℚ 1)).mkQ
          (sAdeleSchwartzToGlobal ℚ ∅ (sLocalStandardThetaTensor (F := ℚ) (S := ∅) 1 g)) := by
  have hω : NormOneCharacterUnramifiedOutside (F := ℚ) 1 ∅ := by
    refine ⟨⟨1, (mem_unramifiedOutside_iff ℚ ∅ 1).mpr (fun _ _ _ ↦ rfl)⟩, fun _ ↦ ?_⟩
    rfl
  with_reducible refine ratTrivialHomogeneousTheta_quotient_realEquiv.elim fun E hE ↦ ?_
  with_reducible refine (sLocalHomogeneousThetaToGlobal_equiv_of_unramified
    (F := ℚ) (S := ∅) (ω := 1) ?_ hω).elim fun T hT ↦ ?_
  · rw [Finset.coe_empty, integer_empty]
    let e := (Algebra.botEquivOfInjective (IsFractionRing.injective (𝓞 ℚ) ℚ)).toRingEquiv
    let i := Rat.ringOfIntegersEquiv.symm.trans e.symm
    let := IsPrincipalIdealRing.of_surjective i i.surjective
    infer_instance
  let K := (sLocalHomogeneousAdelicThetaLinearMap ℚ ∅
    (sLocalNormOneCharacter (F := ℚ) ∅ 1 hω)).ker
  refine ⟨T.toContinuousLinearMap.comp (K.mkQL.comp E.toContinuousLinearMap), ?_, ?_⟩
  · change IsOpenQuotientMap (T.toHomeomorph ∘ (K.mkQL ∘ E.toHomeomorph))
    exact T.toHomeomorph.isOpenQuotientMap.comp
      (K.isOpenQuotientMap_mkQL.comp E.toHomeomorph.isOpenQuotientMap)
  intro f g hg
  have hfg : E f = sLocalStandardThetaTensor (F := ℚ) (S := ∅) 1 g := by
    refine Subtype.ext (funext fun (x : Multiplicative (SAdeleRing ℚ ∅)) ↦ ?_)
    have h := sLocalStandardThetaTensor_apply (F := ℚ) (S := ∅) 1 g x.toAdd
    have ht : sLocalStandardThetaTensor (F := ℚ) (S := ∅) 1 g x =
        g (Multiplicative.ofAdd x.toAdd.1) :=
      h.trans ((congrArg (g (Multiplicative.ofAdd x.toAdd.1) * ·)
        (Fintype.prod_empty _)).trans (mul_one _))
    exact ((hE f x.toAdd).trans (hg x.toAdd.1).symm).trans ht.symm
  let t := sLocalStandardThetaTensor (F := ℚ) (S := ∅) 1 g
  change T.toLinearMap (K.mkQ (E f)) = _
  have hrep := sLocalHomogeneousThetaToGlobal_mk (F := ℚ) (S := ∅) (ω := 1) hω t
  have hglobal := LinearMap.congr_fun hT (K.mkQ t)
  with_reducible exact (congrArg (fun b ↦ T.toLinearMap (K.mkQ b)) hfg).trans (hglobal.trans hrep)

end RiemannMasullo
