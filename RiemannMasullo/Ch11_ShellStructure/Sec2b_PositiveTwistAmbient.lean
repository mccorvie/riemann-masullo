module

public import RiemannMasullo.Ch10_TraceSpectral.Sec1

/-! # Ambient S-local theta vectors at positive twist -/

@[expose] public noncomputable section

open Filter IsDedekindDomain MeasureTheory NumberField
open scoped NNReal NumberField.AdeleRing

namespace RiemannMasullo

set_option quotPrecheck false

variable {F : Type*} [Field F] [NumberField F]
variable {S : Finset (HeightOneSpectrum (𝓞 F))}

local notation "Bₛ" => SchwartzBruhat (Multiplicative (SAdeleRing F S))
local notation "Jₛ" => SIdeleQuotient F S
local notation "J₁" => (sIdeleQuotientNorm F S).ker
local notation "mₛ" => continuousSIdeleQuotientNorm F S
local notation "μₛ" => sLocalQuotientTamagawaMeasure F S
local notation "ν(" s ")" => intervalSobolevMeasure μₛ (logSIdeleQuotientNorm F S) 0 0 s

local instance : MeasurableSpace Jₛ := borel _

/-- Paper: (11.2.1.6), p. 488. At positive twist, a homogeneous S-local theta
function belongs to the ambient logarithmically weighted L² space.
Deviation: This ambient membership holds for every Schwartz–Bruhat test. The
level in the paper is generated by polar-free tests with Fourier support
restricted to the band. -/
theorem sLocalHomogeneousTheta_memLp_positiveTwist {a s : ℝ} (ha : 0 < a)
    (ω : PontryaginDual J₁) (f : Bₛ) :
    MemLp (modulationWeight mₛ a (sLocalHomogeneousAdelicThetaLinearMap F S ω f)) 2 ν(s) := by
  let : BorelSpace Jₛ := ⟨rfl⟩
  let r (g : Jₛ) : ℝ := (mₛ g).val
  let θ := sLocalHomogeneousAdelicThetaLinearMap F S ω f
  let b := a / 2
  let t := max s 0
  have hb : 0 < b := half_pos ha
  have hbb : b + b = a := add_halves a
  have hr (g : Jₛ) : 0 < r g := NNReal.coe_pos.mpr (Units.zero_lt _)
  have hc : Continuous r := NNReal.continuous_coe.comp (Units.continuous_val.comp (mₛ).continuous)
  obtain ⟨j, -, -, hj⟩ := exists_sLocalHomogeneousThetaSobolevInclusion (F := F) (S := S)
    hb (le_refl b) (show 0 ≤ t from le_max_right _ _) hb ω
  have hi := (globalThetaSobolev_norm_aux μₛ r hr hc.measurable b b b t θ
    (j (Submodule.Quotient.mk f)).val.val (hj f).2).1
  rw [hbb] at hi
  let d (g : Jₛ) := intervalSobolevDensity 0 0 t (Real.log (r g))
  have hd (g : Jₛ) : 0 ≤ d g := by dsimp [d, intervalSobolevDensity]; positivity
  have hm : Measurable d := by dsimp [d, intervalSobolevDensity]; fun_prop
  let Z (g : Jₛ) : ℂ := ((r g ^ a : ℝ) : ℂ) * θ g
  have hZ : Continuous Z :=
    (Complex.continuous_ofReal.comp (hc.rpow_const fun g ↦ Or.inl (hr g).ne')).mul θ.continuous
  have hmem : MemLp Z 2 ((μₛ).withDensity fun g ↦ ENNReal.ofReal (d g)) := by
    apply (memLp_two_iff_integrable_sq_norm hZ.aestronglyMeasurable).2
    apply (integrable_withDensity_iff_integrable_smul' (ENNReal.measurable_ofReal.comp hm)
      (.of_forall fun _ ↦ ENNReal.ofReal_lt_top)).2
    refine hi.congr (.of_forall fun g ↦ ?_)
    change ‖θ g‖ ^ 2 * intervalSobolevDensity a a t (Real.log (r g)) =
      (ENNReal.ofReal (d g)).toReal • ‖Z g‖ ^ 2
    rw [ENNReal.toReal_ofReal (hd g), smul_eq_mul]
    simp only [Z, d, norm_mul, mul_pow, Complex.norm_real,
      Real.rpow_def_of_pos (hr g), Real.norm_of_nonneg (Real.exp_pos _).le]
    have he := globalThetaSobolev_norm_density a 0 0 t (Real.log (r g))
    simp only [add_zero] at he
    rw [← he, mul_comm (Real.log (r g)) a]
    ring
  apply hmem.mono_measure (withDensity_mono (.of_forall fun g ↦ ?_))
  apply ENNReal.ofReal_le_ofReal
  unfold d intervalSobolevDensity
  apply mul_le_mul_of_nonneg_left _ (le_trans (Real.exp_pos _).le (le_max_left _ _))
  exact Real.rpow_le_rpow_of_exponent_le (by nlinarith [sq_nonneg (Real.log (r g))])
    (div_le_div_of_nonneg_right (le_max_left s 0) (by norm_num))

end RiemannMasullo
