section FinitePlace

local notation "V(" F ")" => HeightOneSpectrum (𝓞 F)
local notation "K(" F ", " v ")" => HeightOneSpectrum.adicCompletion F v

/-- Paper: (5.3.1.3), p. 240. For each unramified quasi-character at a finite place,
there exists a unique eigendistribution taking value one on the integer-unit indicator.
The shell indicator is the difference of the integer-ring indicator and its translate
by any uniformizer. The repaired statement is `finiteEigendistribution_unitShell`.
See ERRATA F45. -/
def Printed.finiteEigendistribution_unitShell : Prop :=
  ∀ (F : Type) [Field F] [NumberField F] (v : V(F)) (π : K(F, v)ˣ),
    (Valued.v : Valuation K(F, v) (WithZero (Multiplicative ℤ))).IsUniformizer π.val →
    ∀ (c : QuasiCharacter K(F, v)ˣ),
      (∀ u ∈ (HeightOneSpectrum.adicCompletionIntegers F v).units, c u = 1) →
      ∃! T : StrongDual ℂ (SchwartzBruhat (Multiplicative K(F, v))),
        T ∈ schwartzBruhatEigendistributions c ∧
          T (finitePlaceDifference v π (finiteStandardGaussian v 1)) = 1

/-- Paper: (5.3.1.3), p. 240. Take the 3-adic place of ℚ and the trivial quasi-character.
Every invariant functional takes the same value on the integer-ring indicator and its
translate by 3. By linearity its value on their difference is zero, so no functional
satisfies the asserted normalization. -/
theorem Printed.finiteEigendistribution_unitShell_false :
    ¬ Printed.finiteEigendistribution_unitShell := by
  sorry

end FinitePlace

open Classical in
/-- Paper: Theorem 5.3.2.1(1), p. 243. As printed: The finest locally convex topologies on
ℂ[X] and ℂ[X,Y] are generated by families of seminorms indexed by N that equal the coefficient
maxima on the corresponding degree stages in (5.3.2.2) and (5.3.2.12), the latter in Theorem
5.3.2.5(1), p. 246. The repaired statements are
`realDiracDerivatives_polynomialEquiv` and `complexDiracDerivatives_polynomialEquiv`.
See ERRATA F46. -/
def Printed.diracPolynomials_coefficientSeminorms : Prop :=
  let realStageMax : SeminormFamily ℂ (Polynomial ℂ) ℕ := fun N ↦
    (Finset.range (N + 1)).sup fun k ↦ (normSeminorm ℂ ℂ).comp (Polynomial.lcoeff ℂ k)
  let complexStageMax : SeminormFamily ℂ (MvPolynomial (Fin 2) ℂ) ℕ := fun N ↦
    (Finset.univ.filter fun k : Fin (N + 1) × Fin (N + 1) ↦ k.1.val + k.2.val ≤ N).sup
      fun k ↦ (normSeminorm ℂ ℂ).comp (MvPolynomial.lcoeff ℂ
        (Finsupp.equivFunOnFinite.symm ![k.1.val, k.2.val]))
  ∃ (p : SeminormFamily ℂ (Polynomial ℂ) ℕ) (q : SeminormFamily ℂ (MvPolynomial (Fin 2) ℂ) ℕ),
    (∀ N P, P.natDegree ≤ N → p N P = realStageMax N P) ∧
    (∀ N P, P.totalDegree ≤ N → q N P = complexStageMax N P) ∧
    p.moduleFilterBasis.topology =
      inferInstanceAs (TopologicalSpace (FinestLocallyConvex (Polynomial ℂ))) ∧
    q.moduleFilterBasis.topology =
      inferInstanceAs (TopologicalSpace (FinestLocallyConvex (MvPolynomial (Fin 2) ℂ)))

/-- Paper: Theorem 5.3.2.1(1), p. 243. For the truncation extension, Xⁿ converges to zero
for every fixed coefficient maximum, while the sum of absolute coefficients is continuous
in the finest locally convex topology and has value one on each Xⁿ. For any extension p,
scale Xⁿ by λₙ = ((n + 1)(1 + max_{k ≤ n} pₖ(Xⁿ)))⁻¹. All pₖ tend to zero on
λₙXⁿ, while the seminorm summing absolute coefficients with weights 1/|λₙ| takes value
one on each λₙXⁿ. The same argument applies to Theorem 5.3.2.5(1), p. 246. -/
theorem Printed.diracPolynomials_coefficientSeminorms_false :
    ¬ Printed.diracPolynomials_coefficientSeminorms := by
  sorry

section CoordinatePlane

local notation "Eᵣ(" ι ")" => EuclideanSpace ℝ ι
local notation "𝒟(" ι ")" => 𝓓((⊤ : Opens Eᵣ(ι)), ℂ)
local notation "𝒟'(" ι ")" => StrongDual ℂ 𝒟(ι)
local notation "indices(" I ", " N ")" =>
  {α : I → Fin (N + 1) // (∑ i, (α i : ℕ)) ≤ N}

open Classical in
/-- Paper: Theorem 5.3.2.3(2), p. 245. As printed: The coefficient family in (5.3.2.4)
has Nᵐ slots, one for each multi-index of total degree at most N in m dimensions.
Here the ambient coordinates are split into a nonempty normal set and its complement.
The repaired statement is `distribution_coordinatePlane_decomposition`. See ERRATA F47. -/
def Printed.distribution_coordinatePlane_coefficientCount : Prop :=
  ∀ (ι κ : Type) [Fintype ι] [Fintype κ] [Nonempty ι] (N : ℕ),
    Fintype.card (indices(ι ⊕ κ, N)) = N ^ Fintype.card (ι ⊕ κ)

/-- Paper: Theorem 5.3.2.3(2), p. 245. Take one normal coordinate, no tangential
coordinates and N = 0. The zero multi-index is the sole slot and supplies the
coefficient for the point mass at zero. The printed count is 0¹. -/
theorem Printed.distribution_coordinatePlane_coefficientCount_false :
    ¬ Printed.distribution_coordinatePlane_coefficientCount := by
  sorry

local notation "multi(" α ")" => (fun i ↦ (((α).val i).val : ℕ))
local notation "degree(" β ")" => (∑ i, β i)
local notation "∂𝒟[" I ", " β "]" =>
  coordinateDerivative (fun i : I ↦ LineDeriv.lineDerivOpCLM ℂ 𝒟(I)
    (WithLp.toLp 2 (Pi.single i (1 : ℝ)) : Eᵣ(I))) β
local notation "insertPlane" y =>
  WithLp.toLp 2 (Sum.elim (fun _ ↦ (0 : ℝ)) (fun j ↦ y j))
local notation "restriction(" ι ", " κ ")" =>
  (exists_testFunction_coordinatePlaneRestriction (ι := ι) (κ := κ)).choose
local notation "exactOrder(" T ", " N ")" =>
  (DistributionOrderLE T N ∧ ∀ k < N, ¬ DistributionOrderLE T k)

open Classical in
/-- Paper: Theorem 5.3.2.3(2), p. 245. Reading “of order” as the least order, a distribution
of order N with compact support contained in the coordinate plane admits coefficients
in (5.3.2.4) of exact order N − |α|, each with compact support.
The repaired statement is `distribution_coordinatePlane_decomposition`. See ERRATA F48. -/
def Printed.distribution_coordinatePlane_coefficientOrder : Prop :=
  ∀ (ι κ : Type) [Fintype ι] [Fintype κ] [Nonempty ι] (T : 𝒟'(ι ⊕ κ)) (N : ℕ),
    exactOrder(T, N) → IsCompact (Distribution.dsupport (⇑T)) →
    Distribution.dsupport (⇑T) ⊆
      Set.range (fun y : Eᵣ(κ) ↦ (insertPlane y : Eᵣ(ι ⊕ κ))) →
    ∃ A : indices(ι ⊕ κ, N) → 𝒟'(κ),
      (∀ α, exactOrder(A α, N - degree(multi(α))) ∧
        IsCompact (Distribution.dsupport (⇑(A α)))) ∧
      ∀ f : 𝒟(ι ⊕ κ), T f = ∑ α : indices(ι ⊕ κ, N),
        A α (restriction(ι, κ) (∂𝒟[ι ⊕ κ, multi(α)] f))

/-- On a one-point space every distribution has order zero: each test is its value
times the constant test one. -/
private theorem distribution_coordinatePlane_coefficientOrder_false_point
    {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [Subsingleton E]
    (A : StrongDual ℂ 𝓓((⊤ : Opens E), ℂ)) : DistributionOrderLE (⇑A) 0 := by
  intro K
  let g : 𝓓((⊤ : Opens E), ℂ) :=
    ⟨fun _ ↦ 1, contDiff_const, (Set.toFinite _).isCompact, by simp⟩
  refine ⟨‖A g‖, norm_nonneg _, fun f _ B _ hB ↦ ?_⟩
  have hf : f = f 0 • g := TestFunction.ext fun x ↦ by
    rw [Subsingleton.elim x 0]
    simp only [FunLike.coe_smul, Pi.smul_apply, smul_eq_mul]
    exact (mul_one _).symm
  have h0 := hB 0 le_rfl 0
  rw [norm_iteratedFDeriv_zero] at h0
  rw [hf, map_smul, smul_eq_mul, norm_mul, mul_comm]
  exact mul_le_mul_of_nonneg_left h0 (norm_nonneg _)

/-- The derivative at zero along a unit vector `e` has exact order one and is supported
at zero. Its order-one bound is the operator norm of the derivative. The tests
`χₙ(x)⟪e, x⟫`, with `χₙ` a bump equal to one near zero and supported in the ball of
radius `1/(n + 1)`, have sup norm at most `1/(n + 1)` but derivative one along `e`. -/
private theorem distribution_coordinatePlane_coefficientOrder_false_deriv
    {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (e : E) (he : ‖e‖ = 1) :
    ∃ T : StrongDual ℂ 𝓓((⊤ : Opens E), ℂ),
      DistributionOrderLE (⇑T) 1 ∧ ¬ DistributionOrderLE (⇑T) 0 ∧
        Distribution.dsupport (⇑T) ⊆ {0} := by
  let D : 𝓓((⊤ : Opens E), ℂ) →L[ℂ] 𝓓((⊤ : Opens E), ℂ) := TestFunction.lineDerivCLM ℂ e
  let T : StrongDual ℂ 𝓓((⊤ : Opens E), ℂ) :=
    (BoundedContinuousFunction.evalCLM ℂ (0 : E)).comp
      ((TestFunction.toBoundedContinuousFunctionCLM ℂ).comp D)
  have hT : ∀ f : 𝓓((⊤ : Opens E), ℂ), T f = fderiv ℝ (f : E → ℂ) 0 e := by
    intro f
    show (D f : E → ℂ) 0 = _
    rw [TestFunction.lineDerivCLM_eq_fderivCLM, TestFunction.fderivCLM_apply]
    split_ifs with hk
    · rfl
    · exact absurd le_top hk
  refine ⟨T, ?_, ?_, ?_⟩
  · intro K
    refine ⟨1, zero_le_one, fun f _ B _ hB ↦ ?_⟩
    have h1 := hB 1 le_rfl 0
    rw [norm_iteratedFDeriv_one] at h1
    rw [hT, one_mul]
    calc ‖fderiv ℝ (f : E → ℂ) 0 e‖ ≤ ‖fderiv ℝ (f : E → ℂ) 0‖ * ‖e‖ :=
          ContinuousLinearMap.le_opNorm _ _
      _ = ‖fderiv ℝ (f : E → ℂ) 0‖ := by rw [he, mul_one]
      _ ≤ B := h1
  · intro hT0
    obtain ⟨C, -, hC⟩ := hT0 ⟨Metric.closedBall 0 1, isCompact_closedBall 0 1⟩
    obtain ⟨n, hn⟩ := exists_nat_gt C
    set r : ℝ := 1 / ((n : ℝ) + 1) with hr
    have hr0 : 0 < r := by positivity
    have hr1 : r ≤ 1 := by
      rw [hr, div_le_one (by positivity)]
      linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
    let χ : ContDiffBump (0 : E) := ⟨r / 2, r, by positivity, by linarith⟩
    let L : E →L[ℝ] ℂ := Complex.ofRealCLM.comp (innerSL ℝ e)
    have hL : ∀ x, L x = ((inner ℝ e x : ℝ) : ℂ) := fun x ↦ rfl
    let φ : E → ℂ := fun x ↦ (χ x : ℂ) * L x
    have hφc : ContDiff ℝ ∞ φ :=
      (Complex.ofRealCLM.contDiff.comp χ.contDiff).mul L.contDiff
    have hχs : tsupport (fun x ↦ (χ x : ℂ)) ⊆ Metric.closedBall 0 r := by
      refine (tsupport_comp_subset Complex.ofReal_zero _).trans ?_
      rw [χ.tsupport_eq]
    have hφs : tsupport φ ⊆ Metric.closedBall 0 r :=
      (tsupport_mul_subset_left).trans hχs
    let f : 𝓓((⊤ : Opens E), ℂ) :=
      ⟨φ, hφc, (isCompact_closedBall 0 r).of_isClosed_subset (isClosed_tsupport _) hφs,
        by simp⟩
    have hfK : tsupport (f : E → ℂ) ⊆ Metric.closedBall 0 1 :=
      hφs.trans (Metric.closedBall_subset_closedBall hr1)
    have hbound : ∀ j ≤ 0, ∀ x, ‖iteratedFDeriv ℝ j (f : E → ℂ) x‖ ≤ r := by
      intro j hj x
      obtain rfl : j = 0 := by omega
      rw [norm_iteratedFDeriv_zero]
      show ‖(χ x : ℂ) * L x‖ ≤ r
      rw [norm_mul, hL, Complex.norm_real, Complex.norm_real]
      by_cases hx : x ∈ Metric.ball (0 : E) r
      · have hχ1 : ‖χ x‖ ≤ 1 := by
          rw [Real.norm_eq_abs, abs_of_nonneg (χ.nonneg)]
          exact χ.le_one
        have hin : ‖inner ℝ e x‖ < r := by
          calc ‖inner ℝ e x‖ ≤ ‖e‖ * ‖x‖ := norm_inner_le_norm e x
            _ = ‖x‖ := by rw [he, one_mul]
            _ < r := by simpa using hx
        calc ‖χ x‖ * ‖inner ℝ e x‖ ≤ 1 * r :=
              mul_le_mul hχ1 hin.le (norm_nonneg _) zero_le_one
          _ = r := one_mul r
      · have hχ0 : χ x = 0 := by
          rw [← Function.notMem_support, χ.support_eq]
          exact hx
        rw [hχ0, norm_zero, zero_mul]
        exact hr0.le
    have hloc : (f : E → ℂ) =ᶠ[nhds 0] L := by
      filter_upwards [Metric.ball_mem_nhds (0 : E) (half_pos hr0)] with x hx
      show (χ x : ℂ) * L x = L x
      rw [χ.one_of_mem_closedBall (Metric.ball_subset_closedBall hx), Complex.ofReal_one, one_mul]
    have hTf : T f = 1 := by
      rw [hT, hloc.fderiv_eq, L.fderiv, hL, real_inner_self_eq_norm_sq, he]
      norm_num
    have := hC f hfK r hr0.le hbound
    rw [hTf, norm_one] at this
    have hCr : C * r < 1 := by
      rw [hr, mul_one_div, div_lt_one (by positivity)]
      linarith
    linarith
  · intro x hx
    by_contra hx0
    refine (Distribution.notMem_dsupport_iff x).2
      ⟨{0}ᶜ, fun ψ hψ ↦ ?_, isOpen_compl_singleton, hx0⟩ hx
    have h0 : (ψ : E → ℂ) =ᶠ[nhds 0] 0 :=
      notMem_tsupport_iff_eventuallyEq.1 fun h ↦ hψ h rfl
    rw [hT, h0.fderiv_eq, fderiv_zero]
    rfl

/-- Paper: Theorem 5.3.2.3(2), p. 245. Take one normal coordinate, no tangential
coordinates, N = 1 and T = δ₀ + δ₀′. A compactly supported test equal to one near zero
forces the zero-index coefficient to send one to one. Every distribution on a point has
order at most zero, while the formula requires exact order one for that coefficient. -/
theorem Printed.distribution_coordinatePlane_coefficientOrder_false :
    ¬ Printed.distribution_coordinatePlane_coefficientOrder := by
  intro h
  have : Subsingleton Eᵣ(Empty) := ⟨fun x y ↦ PiLp.ext fun i ↦ i.elim⟩
  obtain ⟨e, he⟩ := exists_norm_eq Eᵣ(Unit ⊕ Empty) zero_le_one
  obtain ⟨T, h1, h0, hsupp⟩ := distribution_coordinatePlane_coefficientOrder_false_deriv e he
  have hplane : (0 : Eᵣ(Unit ⊕ Empty)) ∈
      Set.range (fun y : Eᵣ(Empty) ↦ (insertPlane y : Eᵣ(Unit ⊕ Empty))) :=
    ⟨0, PiLp.ext fun i ↦ by rcases i with _ | i <;> simp⟩
  obtain ⟨A, hA, -⟩ := h Unit Empty T 1
    ⟨h1, fun k hk ↦ by obtain rfl : k = 0 := (by omega); exact h0⟩
    ((Set.finite_singleton 0).subset hsupp).isCompact
    (hsupp.trans (Set.singleton_subset_iff.2 hplane))
  let α₀ : indices(Unit ⊕ Empty, 1) := ⟨fun _ ↦ 0, by simp⟩
  exact (hA α₀).1.2 0 (by simp [α₀])
    (distribution_coordinatePlane_coefficientOrder_false_point (A α₀))

open Classical in
/-- Paper: Theorem 5.3.2.3(4), p. 245. As printed: The coefficients of (5.3.2.4)
give the unsigned tensor expansion (5.3.2.6) with distributional derivatives on the
Dirac and coefficient factors. The repaired statement is
`distribution_coordinatePlane_decomposition_eq_sum`. See ERRATA F49. -/
def Printed.distribution_coordinatePlane_decomposition_eq_sum : Prop :=
  ∀ (ι κ : Type) [Fintype ι] [Fintype κ] [Nonempty ι] (T : 𝒟'(ι ⊕ κ)) (N : ℕ),
    exactOrder(T, N) → IsCompact (Distribution.dsupport (⇑T)) →
    Distribution.dsupport (⇑T) ⊆
      Set.range (fun y : Eᵣ(κ) ↦ (insertPlane y : Eᵣ(ι ⊕ κ))) →
    ∀ (A : indices(ι ⊕ κ, N) → 𝒟'(κ)),
      (∀ α, exactOrder(A α, N - degree(multi(α))) ∧
        IsCompact (Distribution.dsupport (⇑(A α)))) →
      (∀ f : 𝒟(ι ⊕ κ), T f = ∑ α : indices(ι ⊕ κ, N),
        A α (restriction(ι, κ) (∂𝒟[ι ⊕ κ, multi(α)] f))) →
      T = ∑ α : indices(ι ⊕ κ, N),
        let normal := fun i : ι ↦ multi(α) (.inl i)
        let tangent := fun j : κ ↦ multi(α) (.inr j)
        coordinatePlaneDiracTensor normal
          ((-1 : ℂ) ^ degree(tangent) • (A α).comp ∂𝒟[κ, tangent])

/-- Paper: Theorem 5.3.2.3(4), p. 245. With normal coordinate x, tangential coordinate y
and N = 1, take A₍₀,₀₎(g) = g′(0) and A₍₁,₀₎ = A₍₀,₁₎ = δ₀. These have the printed
exact orders, and (5.3.2.4) gives T(f) = ∂ₓf(0,0) + 2∂ᵧf(0,0). A product of compactly
supported tests equal to x near (0,0) gives one for T and minus one for (5.3.2.6). -/
theorem Printed.distribution_coordinatePlane_decomposition_eq_sum_false :
    ¬ Printed.distribution_coordinatePlane_decomposition_eq_sum := by
  sorry

local notation "factors(" f ", " g ", " x ")" =>
  f (WithLp.toLp 2 (fun i ↦ x (.inl i))) * g (WithLp.toLp 2 (fun j ↦ x (.inr j)))

/-- Paper: Remark 5.3.2.4, p. 246. As printed: The product of test functions induces a
linear homeomorphism from the inductive tensor product onto the ambient test space.
The repaired statement is `testFunction_inductiveTensor_equiv`. See ERRATA F50. -/
def Printed.testFunction_inductiveTensor_equiv : Prop :=
  ∀ (ι κ : Type) [Fintype ι] [Fintype κ] [Nonempty ι],
    ∃ e : InductiveTensor 𝒟(ι) 𝒟(κ) ≃L[ℂ] 𝒟(ι ⊕ κ),
      ∀ (f : 𝒟(ι)) (g : 𝒟(κ)) (x : Eᵣ(ι ⊕ κ)), e (f ⊗ₜ[ℂ] g) x = factors(f, g, x)

/-- Paper: Remark 5.3.2.4, p. 246. Take one normal and one tangential coordinate and
a smooth compactly supported real bump χ equal to one near zero. The test
χ(x)χ(y) exp(xy) has x-derivatives at zero equal to the linearly independent functions
χ(y)yʲ. For a finite sum of pure products all these derivatives lie in the finite span
of the tangential factors. -/
theorem Printed.testFunction_inductiveTensor_equiv_false :
    ¬ Printed.testFunction_inductiveTensor_equiv := by
  sorry

/-- Paper: Remark 5.3.2.4, p. 246. As printed: The product of test functions induces no
linear homeomorphism for either the projective or the injective tensor topology. The set of
normal coordinates may be the entire coordinate set. The corresponding repaired statement is
`testFunction_no_projectiveTensor_product`. See ERRATA F51. -/
def Printed.testFunction_no_projectiveOrInjectiveTensor_equiv : Prop :=
  ∀ (ι κ : Type) [Fintype ι] [Fintype κ] [Nonempty ι],
    (¬ ∃ e : ProjectiveTensor 𝒟(ι) 𝒟(κ) ≃L[ℂ] 𝒟(ι ⊕ κ),
      ∀ (f : 𝒟(ι)) (g : 𝒟(κ)) (x : Eᵣ(ι ⊕ κ)), e (f ⊗ₜ[ℂ] g) x = factors(f, g, x)) ∧
    (¬ ∃ e : InjectiveTensor 𝒟(ι) 𝒟(κ) ≃L[ℂ] 𝒟(ι ⊕ κ),
      ∀ (f : 𝒟(ι)) (g : 𝒟(κ)) (x : Eᵣ(ι ⊕ κ)), e (f ⊗ₜ[ℂ] g) x = factors(f, g, x))

/-- Paper: Remark 5.3.2.4, p. 246. Take one normal coordinate and no tangential
coordinates. The tangential test space is ℂ by evaluation at its single point. For both
tensor topologies the product map is the scalar isomorphism f ⊗ a ↦ af. -/
theorem Printed.testFunction_no_projectiveOrInjectiveTensor_equiv_false :
    ¬ Printed.testFunction_no_projectiveOrInjectiveTensor_equiv := by
  sorry

end CoordinatePlane

