module

public import RiemannMasullo.Ch09_HardySobolev.Sec2

/-! # §9.2.2 assertions that are false as printed -/

@[expose] public noncomputable section

open Filter MeasureTheory Set Topology
open scoped ENNReal

namespace RiemannMasullo

local notation "AS" => SchwartzBergman (univ : Set ℝ)

/-- Paper: Definition 9.2.2.3, p. 414. The topology generated by the vertical
derivative norms in (9.2.2.19), with the order range made explicit on p. 417.
The generating open sets are the balls in each of the individual norms. -/
@[instance_reducible]
def Printed.sampledHardySobolevTopology (s : ℝ) (c : ℕ → ℝ) : TopologicalSpace AS :=
  TopologicalSpace.generateFrom {U | ∃ (n k : ℕ), k ≤ Nat.floor (s / 2) ∧
    ∃ (v : AS) (ε : ℝ≥0∞), 0 < ε ∧ U = {u | (eLpNorm
      (fun y : ℝ ↦ iteratedDeriv k (u - v).val ((c n : ℂ) + (y : ℂ) * Complex.I))
      2 volume) / ENNReal.ofReal (2 * Real.pi) < ε}}

/-- Paper: Proposition 9.2.2.4(1), p. 414. As printed: For every nonempty closed
base interval and every nonnegative degree, the topology on the entire test space is
independent of the sequence of lines accumulating at the boundary. This is the
sequence-independence clause. See `scalarIntervalSobolev_mellin_endpoints` and ERRATA F233. -/
def Printed.sampledHardySobolevTopology_independent : Prop :=
  ∀ (I : Set ℝ), IsClosed I → OrdConnected I → I.Nonempty → ∀ (s : ℝ), 0 ≤ s →
    ∀ (c d : ℕ → ℝ), (∀ b ∈ frontier I, MapClusterPt b atTop c) →
      (∀ b ∈ frontier I, MapClusterPt b atTop d) →
      Printed.sampledHardySobolevTopology s c = Printed.sampledHardySobolevTopology s d

/-- Paper: Proposition 9.2.2.4(1), p. 414. Take degree zero and base [−1, 1]. Let
`c` interleave the lines with abscissas 1 − 1/(n+2) and −1 + 1/(n+2), and let `d`
prepend the line at 1 to `c`. For a nonzero smooth bump `h` supported in (0, 1),
take the Mellin transforms of the log profiles exp(−n) h(x−n). At each fixed
abscissa σ of `c` the order-zero line norm is a constant times exp((σ−1)n).
At the prepended line the norm is the fixed positive norm of the transform of
x ↦ exp(x) h(x), with the normalization of (9.2.2.19). -/
theorem Printed.sampledHardySobolevTopology_independent_false :
    ¬ Printed.sampledHardySobolevTopology_independent := by sorry

/-- Paper: Corollary 9.2.2.5(2), p. 414. As printed: At each boundary point of a
nonempty closed base interval, the order-k evaluation is continuous exactly when
k is at most the floor of (s−1)/2. Continuity on the completion is expressed by
continuity of the evaluation on its dense entire test space with the sampled topology.
See `scalarIntervalSobolev_eval_boundary_iff` and ERRATA F237. -/
def Printed.sampledHardySobolev_eval_boundary_iff : Prop :=
  ∀ (I : Set ℝ), IsClosed I → OrdConnected I → I.Nonempty → ∀ (s : ℝ), 0 ≤ s →
    ∀ (c : ℕ → ℝ), (∀ b ∈ frontier I, MapClusterPt b atTop c) →
      ∀ (z : ℂ), z.re ∈ I → z.re ∈ frontier I → ∀ k : ℕ,
        @Continuous AS ℂ (Printed.sampledHardySobolevTopology s c) inferInstance
          (fun u ↦ iteratedDeriv k u.val z) ↔ (k : ℤ) ≤ Int.floor ((s - 1) / 2)

/-- Paper: Corollary 9.2.2.5(2), p. 414. Take base [−1, 1], s = 1, z = 1 and k = 0.
Interleave the interior abscissas 1 − 1/(n+2) and −1 + 1/(n+2). For a nonnegative
nonzero smooth bump `h` supported in (0, 1), the Mellin transforms of the log profiles
exp(−n) h(x−n) tend to zero on every sampled line. Their values at 1 are the same
positive number ∫ exp(x) h(x) dx, although the printed floor allows k = 0. -/
theorem Printed.sampledHardySobolev_eval_boundary_iff_false :
    ¬ Printed.sampledHardySobolev_eval_boundary_iff := by sorry

end RiemannMasullo
