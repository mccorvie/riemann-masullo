module

public import RiemannMasullo.ForMathlib.NumberTheory.NumberField.GaussianPlaces
public import RiemannMasullo.Ch07_SchauderBasesZeta.Sec3a
public import Mathlib.NumberTheory.Padics.HeightOneSpectrum

/-!
# Saturation of the Gaussian stage at three and five

The stage consists of the entire fiber at three and both members of the fiber at five.
Its ring of S-integers has trivial class group and Picard group.
-/

public section

namespace NumberField.Gaussian

open IsDedekindDomain RiemannMasullo

local notation "K" => CyclotomicField 4 ℚ
local notation "Places" => HeightOneSpectrum (𝓞 K)
local notation "ratPlaceOfPrime" => Equiv.symm (Rat.HeightOneSpectrum.primesEquiv (R := 𝓞 ℚ))
local notation "ratThree" => ratPlaceOfPrime ⟨3, by decide⟩
local notation "ratFive" => ratPlaceOfPrime ⟨5, by decide⟩

private theorem under_eq_prime_iff_mem (w : Places) (p : Nat.Primes) :
    w.under (𝓞 ℚ) = ratPlaceOfPrime p ↔ (p.val : 𝓞 K) ∈ w.asIdeal := by
  let q := ratPlaceOfPrime p
  have hq : q.asIdeal = Ideal.span {(p.val : 𝓞 ℚ)} := by
    change (Ideal.span {(p.val : ℤ)}).map (Rat.IsIntegralClosure.intEquiv (𝓞 ℚ)).symm = _
    rw [Ideal.map_span, Set.image_singleton]
    simp
  have hcast : (p.val : 𝓞 ℚ) ∈ (w.under (𝓞 ℚ)).asIdeal ↔ (p.val : 𝓞 K) ∈ w.asIdeal := by
    change (algebraMap (𝓞 ℚ) (𝓞 K)) (p.val : 𝓞 ℚ) ∈ w.asIdeal ↔ _
    rw [map_natCast]
  rw [← hcast]
  change w.under (𝓞 ℚ) = q ↔ _
  constructor
  · intro hw
    rw [hw, hq]
    exact Ideal.mem_span_singleton_self _
  · intro hp
    apply HeightOneSpectrum.ext_iff.mpr
    have hle : q.asIdeal ≤ (w.under (𝓞 ℚ)).asIdeal := by
      rwa [hq, Ideal.span_singleton_le_iff_mem]
    exact (q.isMaximal.eq_of_le (w.under (𝓞 ℚ)).isPrime.ne_top hle).symm

private theorem eq_iff_gen_mem (w v : Places) (x : 𝓞 K) (hv : v.asIdeal = Ideal.span {x}) :
    w = v ↔ x ∈ w.asIdeal := by
  constructor
  · rintro rfl
    rw [hv]
    exact Ideal.mem_span_singleton_self _
  · intro hx
    apply HeightOneSpectrum.ext_iff.mpr
    have hle : v.asIdeal ≤ w.asIdeal := by rwa [hv, Ideal.span_singleton_le_iff_mem]
    exact (v.isMaximal.eq_of_le w.isPrime.ne_top hle).symm

/-- The full fiber of the Gaussian field at the rational prime three consists of its inert place. -/
theorem under_eq_three_iff (w : Places) : w.under (𝓞 ℚ) = ratThree ↔ w = threePlace := by
  refine (under_eq_prime_iff_mem w ⟨3, by decide⟩).trans ?_
  have h3 : integersEquiv (3 : GaussianInt) = 3 := map_natCast integersEquiv 3
  have hspan : threePlace.asIdeal = Ideal.span {(3 : 𝓞 K)} := by
    simpa only [coe_threeMember, gen_threeMember, h3] using asIdeal_eq_span_gen threeMember
  exact (eq_iff_gen_mem w threePlace 3 hspan).symm

/-- The full fiber of the Gaussian field at five comprises the two conjugate places. -/
theorem under_eq_five_iff (w : Places) :
    w.under (𝓞 ℚ) = ratFive ↔ w = plusPlace ∨ w = minusPlace := by
  refine (under_eq_prime_iff_mem w ⟨5, by decide⟩).trans ?_
  change (5 : 𝓞 K) ∈ w.asIdeal ↔ _
  have hprod :
      integersEquiv (⟨2, 1⟩ : GaussianInt) * integersEquiv (⟨2, -1⟩ : GaussianInt) = 5 := by
    have hg : (⟨2, 1⟩ : GaussianInt) * ⟨2, -1⟩ = 5 := by decide
    exact (map_mul integersEquiv _ _).symm.trans ((congrArg integersEquiv hg).trans
      (map_natCast integersEquiv 5))
  rw [← hprod, w.isPrime.mul_mem_iff_mem_or_mem]
  exact or_congr (eq_iff_gen_mem w plusPlace _ (by simpa using asIdeal_eq_span_gen plusMember)).symm
    (eq_iff_gen_mem w minusPlace _ (by simpa using asIdeal_eq_span_gen minusMember)).symm

private theorem under_threePlace_ne {w : Places} (hw : threePlace ≠ w) :
    threePlace.under (𝓞 ℚ) ≠ w.under (𝓞 ℚ) := by
  intro h
  exact hw ((under_eq_three_iff w).mp (h.symm.trans ((under_eq_three_iff _).mpr rfl))).symm

/-- The inert place and the place generated by `2+i` have different rational primes below them. -/
theorem under_threePlace_ne_under_plusPlace :
    threePlace.under (𝓞 ℚ) ≠ plusPlace.under (𝓞 ℚ) :=
  under_threePlace_ne threePlace_ne_plusPlace

/-- The inert place and the place generated by `2-i` have different rational primes below them. -/
theorem under_threePlace_ne_under_minusPlace :
    threePlace.under (𝓞 ℚ) ≠ minusPlace.under (𝓞 ℚ) :=
  under_threePlace_ne threePlace_ne_minusPlace

/-- The Gaussian stage contains exactly the places over the rational primes three and five. -/
theorem mem_finitePlaces_iff_under (w : Places) :
    w ∈ finitePlaces ↔ w.under (𝓞 ℚ) = ratThree ∨ w.under (𝓞 ℚ) = ratFive := by
  rw [mem_finitePlaces, under_eq_three_iff, under_eq_five_iff]

/-- The three selected finite places form a saturated stage in Situation 7.3.1.1. -/
theorem isSaturatedPlaceSet_finitePlaces : IsSaturatedPlaceSet finitePlaces := by
  intro v w hv hw
  rwa [mem_finitePlaces_iff_under, hw, ← mem_finitePlaces_iff_under]

open Classical in
/-- The primary parts of the stage are the inert singleton at three and the split pair at five. -/
theorem primaryPlaces_finitePlaces :
    sLocalPrimaryPlaces finitePlaces ratThree = {threePlace} ∧
      sLocalPrimaryPlaces finitePlaces ratFive = {plusPlace, minusPlace} := by
  constructor
  · ext w
    simp only [mem_sLocalPrimaryPlaces, mem_finitePlaces, under_eq_three_iff, Finset.mem_singleton]
    exact ⟨And.right, fun h ↦ ⟨Or.inl h, h⟩⟩
  · ext w
    simp only [mem_sLocalPrimaryPlaces, mem_finitePlaces, under_eq_five_iff, Finset.mem_insert,
      Finset.mem_singleton]
    exact ⟨And.right, fun h ↦ ⟨Or.inr h, h⟩⟩

/-- Each primary part of the Gaussian stage is saturated as a set of finite places. -/
theorem isSaturatedPlaceSet_primary_finitePlaces (p : HeightOneSpectrum (𝓞 ℚ)) :
    IsSaturatedPlaceSet (sLocalPrimaryPlaces finitePlaces p) := by
  intro v w hv hw
  rw [mem_sLocalPrimaryPlaces] at hv ⊢
  exact ⟨isSaturatedPlaceSet_finitePlaces hv.1 hw, hw.trans hv.2⟩

/-- Every ideal in this stage's S-integer ring is principal. -/
theorem isPrincipalIdealRing_finitePlaces :
    IsPrincipalIdealRing ((finitePlaces : Set Places).integer K) := by
  let : IsPrincipalIdealRing (𝓞 K) :=
    IsPrincipalIdealRing.of_surjective integersEquiv.toRingHom integersEquiv.surjective
  let : Fact (IsMulTorsion (ClassGroup (𝓞 K))) :=
    ⟨fun x ↦ by rw [Subsingleton.elim x 1]; exact IsOfFinOrder.one⟩
  let A := (finitePlaces : Set Places).integer K
  constructor
  intro I
  rw [← IsLocalization.map_under (Localization.submonoid (finitePlaces : Set Places)) A I]
  exact (IsPrincipalIdealRing.principal _).map_ringHom _

/-- The class group of the S-integers in the three-place Gaussian stage is trivial. -/
theorem subsingleton_classGroup_finitePlaces :
    Subsingleton (ClassGroup ((finitePlaces : Set Places).integer K)) := by
  let := isPrincipalIdealRing_finitePlaces
  infer_instance

/-- The Picard hypothesis of Theorem 7.3.1.2 holds for the three-place Gaussian stage. -/
theorem subsingleton_pic_finitePlaces :
    Subsingleton (CommRing.Pic ((finitePlaces : Set Places).integer K)) := by
  let A := (finitePlaces : Set Places).integer K
  let : Subsingleton (ClassGroup A) := subsingleton_classGroup_finitePlaces
  exact Equiv.subsingleton (ClassGroup.equivPic A).symm.toEquiv

end NumberField.Gaussian
