module

public import Mathlib.NumberTheory.NumberField.Basic
public import Mathlib.RingTheory.Ideal.Norm.AbsNorm
public import Mathlib.RingTheory.PrincipalIdealDomain

/-!
# Ideals of the ring of integers of `ℚ`

Every ideal of `𝓞 ℚ` is generated by a natural number `n`, and its absolute norm is `n`.
-/

@[expose] public section

namespace RiemannMasullo

open NumberField

namespace RatRingOfIntegers

/-- Every element of `𝓞 ℚ` is an integer. -/
theorem exists_intCast (a : 𝓞 ℚ) : ∃ z : ℤ, a = z :=
  ⟨Rat.ringOfIntegersEquiv a, by
    conv_lhs => rw [← Rat.ringOfIntegersEquiv.symm_apply_apply a]
    exact map_intCast Rat.ringOfIntegersEquiv.symm _⟩

theorem finrank_int : Module.finrank ℤ (𝓞 ℚ) = 1 := by
  rw [Rat.ringOfIntegersEquiv.toAddEquiv.toIntLinearEquiv.finrank_eq, Module.finrank_self]

theorem absNorm_span_intCast (z : ℤ) :
    Ideal.absNorm (Ideal.span {(z : 𝓞 ℚ)}) = z.natAbs := by
  have h : ((z : ℤ) : 𝓞 ℚ) = algebraMap ℤ (𝓞 ℚ) z := (eq_intCast (algebraMap ℤ (𝓞 ℚ)) z).symm
  rw [Ideal.absNorm_span_singleton, h, Algebra.norm_algebraMap, finrank_int, pow_one]

theorem absNorm_span_natCast (n : ℕ) :
    Ideal.absNorm (Ideal.span {(n : 𝓞 ℚ)}) = n := by
  simpa using absNorm_span_intCast n

instance : IsPrincipalIdealRing (𝓞 ℚ) :=
  IsPrincipalIdealRing.of_surjective Rat.ringOfIntegersEquiv.symm.toRingHom
    Rat.ringOfIntegersEquiv.symm.surjective

/-- Every ideal of `𝓞 ℚ` is generated by a natural number. -/
theorem exists_eq_span_natCast (I : Ideal (𝓞 ℚ)) : ∃ n : ℕ, I = Ideal.span {(n : 𝓞 ℚ)} := by
  obtain ⟨a, rfl⟩ := (IsPrincipalIdealRing.principal I).principal
  obtain ⟨z, rfl⟩ := exists_intCast a
  refine ⟨z.natAbs, Ideal.span_singleton_eq_span_singleton.mpr ?_⟩
  simpa using (Int.associated_natAbs z).map (Int.castRingHom (𝓞 ℚ))

theorem natCast_ne_zero {n : ℕ} (hn : n ≠ 0) : (n : 𝓞 ℚ) ≠ 0 := by
  intro h
  have := congrArg Rat.ringOfIntegersEquiv h
  simp [hn] at this

theorem prime_natCast_iff {p : ℕ} : Prime (p : 𝓞 ℚ) ↔ p.Prime := by
  rw [← MulEquiv.prime_iff Rat.ringOfIntegersEquiv.toMulEquiv, Nat.prime_iff_prime_int]
  simp

end RatRingOfIntegers

end RiemannMasullo
