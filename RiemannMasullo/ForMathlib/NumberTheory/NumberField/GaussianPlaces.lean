module

public import RiemannMasullo.ForMathlib.NumberTheory.NumberField.Gaussian
public import RiemannMasullo.ForMathlib.NumberTheory.GaussianInt.PrimeIdeals

/-!
# The Gaussian places above three and five

The three places correspond to \(3\), \(2+i\), and \(2-i\) in the oriented Gaussian
integer ring. Their respective principal generators form a section on this finite stage.
-/

@[expose] public noncomputable section

namespace NumberField.Gaussian
open IsDedekindDomain

local notation "K" => CyclotomicField 4 ℚ
local notation "Places" => HeightOneSpectrum (𝓞 K)

/-- The height-one prime of the Gaussian number field generated by a Gaussian prime. -/
def placeOfGaussianPrime (z : GaussianInt) (hz : z ≠ 0) (hp : (Ideal.span {z}).IsPrime) :
    Places :=
  HeightOneSpectrum.equivOfRingEquiv integersEquiv
    ⟨Ideal.span {z}, hp, fun h ↦ hz (Ideal.span_singleton_eq_bot.mp h)⟩

theorem placeOfGaussianPrime_asIdeal (z : GaussianInt) (hz : z ≠ 0)
    (hp : (Ideal.span {z}).IsPrime) :
    (placeOfGaussianPrime z hz hp).asIdeal = Ideal.span {integersEquiv z} := by
  change (Ideal.span {z}).comap integersEquiv.symm = _
  rw [Ideal.comap_symm, Ideal.map_span, Set.image_singleton]

private theorem placeOfGaussianPrime_ne {x y : GaussianInt} (hx : x ≠ 0) (hy : y ≠ 0)
    (hpx : (Ideal.span {x}).IsPrime) (hpy : (Ideal.span {y}).IsPrime)
    (hne : Ideal.span {x} ≠ Ideal.span {y}) :
    placeOfGaussianPrime x hx hpx ≠ placeOfGaussianPrime y hy hpy := by
  intro he
  exact hne (congrArg HeightOneSpectrum.asIdeal
    ((HeightOneSpectrum.equivOfRingEquiv integersEquiv).injective he))

private theorem placeOfGaussianPrime_absNorm (z : GaussianInt) (hz : z ≠ 0)
    (hp : (Ideal.span {z}).IsPrime) :
    (placeOfGaussianPrime z hz hp).asIdeal.absNorm = (Ideal.span {z}).absNorm := by
  change ((Ideal.span {z}).comap integersEquiv.symm).absNorm = _
  rw [Ideal.comap_symm]
  exact Ideal.absNorm_map_ringEquiv integersEquiv _

/-- The inert Gaussian place with generator three. -/
def threePlace : Places := placeOfGaussianPrime 3 (by decide) GaussianInt.isPrime_span_three

/-- The Gaussian place with generator \(2+i\). -/
def plusPlace : Places :=
  placeOfGaussianPrime ⟨2, 1⟩ (by decide) GaussianInt.isPrime_span_two_add_i

/-- The Gaussian place with generator \(2-i\). -/
def minusPlace : Places :=
  placeOfGaussianPrime ⟨2, -1⟩ (by decide) GaussianInt.isPrime_span_two_sub_i

theorem threePlace_ne_plusPlace : threePlace ≠ plusPlace := placeOfGaussianPrime_ne _ _ _ _
  GaussianInt.span_three_ne_span_two_add_i

theorem threePlace_ne_minusPlace : threePlace ≠ minusPlace := placeOfGaussianPrime_ne _ _ _ _
  GaussianInt.span_three_ne_span_two_sub_i

theorem plusPlace_ne_minusPlace : plusPlace ≠ minusPlace := placeOfGaussianPrime_ne _ _ _ _
  GaussianInt.span_two_add_i_ne_span_two_sub_i

@[simp] theorem absNorm_threePlace : threePlace.asIdeal.absNorm = 9 :=
  (placeOfGaussianPrime_absNorm _ _ _).trans GaussianInt.absNorm_span_three

@[simp] theorem absNorm_plusPlace : plusPlace.asIdeal.absNorm = 5 :=
  (placeOfGaussianPrime_absNorm _ _ _).trans GaussianInt.absNorm_span_two_add_i

@[simp] theorem absNorm_minusPlace : minusPlace.asIdeal.absNorm = 5 :=
  (placeOfGaussianPrime_absNorm _ _ _).trans GaussianInt.absNorm_span_two_sub_i

/-- The finite Gaussian stage containing the inert place at three and both places at five. -/
def finitePlaces : Finset Places := open Classical in {threePlace, plusPlace, minusPlace}

@[simp] theorem mem_finitePlaces (v : Places) :
    v ∈ finitePlaces ↔ v = threePlace ∨ v = plusPlace ∨ v = minusPlace := by
  classical simp [finitePlaces]

@[simp] theorem card_finitePlaces : finitePlaces.card = 3 := by
  classical
  simp [finitePlaces, threePlace_ne_plusPlace, threePlace_ne_minusPlace, plusPlace_ne_minusPlace]

/-- The place at three viewed as a member of the finite stage. -/
def threeMember : finitePlaces := ⟨threePlace, (mem_finitePlaces _).mpr (Or.inl rfl)⟩

/-- The place at \(2+i\) viewed as a member of the finite stage. -/
def plusMember : finitePlaces := ⟨plusPlace, (mem_finitePlaces _).mpr (Or.inr (Or.inl rfl))⟩

/-- The place at \(2-i\) viewed as a member of the finite stage. -/
def minusMember : finitePlaces := ⟨minusPlace, (mem_finitePlaces _).mpr (Or.inr (Or.inr rfl))⟩

@[simp] theorem coe_threeMember : threeMember.val = threePlace := rfl
@[simp] theorem coe_plusMember : plusMember.val = plusPlace := rfl
@[simp] theorem coe_minusMember : minusMember.val = minusPlace := rfl

/-- The chosen integral generator is three, \(2+i\), or \(2-i\), according to the place. -/
def gen (v : finitePlaces) : 𝓞 K :=
  open Classical in
  if v.val = threePlace then integersEquiv 3
  else if v.val = plusPlace then integersEquiv ⟨2, 1⟩ else integersEquiv ⟨2, -1⟩

@[simp] theorem gen_threeMember : gen threeMember = integersEquiv (3 : GaussianInt) := by
  simp [gen, threeMember]

@[simp] theorem gen_plusMember : gen plusMember = integersEquiv (⟨2, 1⟩ : GaussianInt) := by
  simp [gen, plusMember, Ne.symm threePlace_ne_plusPlace]

@[simp] theorem gen_minusMember : gen minusMember = integersEquiv (⟨2, -1⟩ : GaussianInt) := by
  simp [gen, minusMember, Ne.symm threePlace_ne_minusPlace, Ne.symm plusPlace_ne_minusPlace]

/-- Every indicated finite Gaussian place is generated by its chosen element. -/
theorem asIdeal_eq_span_gen (v : finitePlaces) : v.val.asIdeal = Ideal.span {gen v} := by
  obtain hv | hv | hv := (mem_finitePlaces v.val).mp v.prop
  · obtain rfl : v = threeMember := Subtype.ext hv
    rw [gen_threeMember]
    exact placeOfGaussianPrime_asIdeal 3 (by decide) GaussianInt.isPrime_span_three
  · obtain rfl : v = plusMember := Subtype.ext hv
    rw [gen_plusMember]
    exact placeOfGaussianPrime_asIdeal ⟨2, 1⟩ (by decide) GaussianInt.isPrime_span_two_add_i
  · obtain rfl : v = minusMember := Subtype.ext hv
    rw [gen_minusMember]
    exact placeOfGaussianPrime_asIdeal ⟨2, -1⟩ (by decide) GaussianInt.isPrime_span_two_sub_i

end NumberField.Gaussian
