module

public import Mathlib.NumberTheory.Zsqrtd.QuadraticReciprocity
public import Mathlib.RingTheory.Ideal.Norm.AbsNorm
import Mathlib.LinearAlgebra.Basis.Fin
import Mathlib.LinearAlgebra.Matrix.Determinant.Basic

/-!
# Three prime ideals of the Gaussian integers

The rational prime three is inert, and five splits at the two nonassociate factors
`2 + i` and `2 - i`. The norm formula below also computes the size of every
principal quotient of the Gaussian integers.
-/

public section

namespace GaussianInt

private def coordEquiv : GaussianInt ≃+ ℤ × ℤ where
  toFun z := (z.re, z.im)
  invFun z := ⟨z.1, z.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl

private noncomputable def intBasis : Module.Basis (Fin 2) ℤ GaussianInt :=
  (Module.Basis.finTwoProd ℤ).map coordEquiv.toIntLinearEquiv.symm

private theorem intBasis_zero : intBasis 0 = ⟨1, 0⟩ := by
  rw [intBasis, Module.Basis.map_apply, Module.Basis.finTwoProd_zero]
  rfl

private theorem intBasis_one : intBasis 1 = ⟨0, 1⟩ := by
  rw [intBasis, Module.Basis.map_apply, Module.Basis.finTwoProd_one]
  rfl

private theorem intBasis_repr_zero (z : GaussianInt) : intBasis.repr z 0 = z.re := by
  change (Module.Basis.finTwoProd ℤ).repr (z.re, z.im) 0 = _
  exact congrFun (Module.Basis.coe_finTwoProd_repr (z.re, z.im)) 0

private theorem intBasis_repr_one (z : GaussianInt) : intBasis.repr z 1 = z.im := by
  change (Module.Basis.finTwoProd ℤ).repr (z.re, z.im) 1 = _
  exact congrFun (Module.Basis.coe_finTwoProd_repr (z.re, z.im)) 1

/-- The absolute norm of a principal Gaussian ideal is the norm of its generator. -/
theorem absNorm_span (z : GaussianInt) : (Ideal.span {z}).absNorm = z.norm.natAbs := by
  let : Module.Free ℤ GaussianInt := Module.Free.of_basis intBasis
  let : Module.Finite ℤ GaussianInt := Module.Finite.of_basis intBasis
  rw [Ideal.absNorm_span_singleton, Algebra.norm_eq_matrix_det intBasis, Matrix.det_fin_two]
  simp only [Algebra.leftMulMatrix_eq_repr_mul, intBasis_zero, intBasis_one, intBasis_repr_zero,
    intBasis_repr_one, Zsqrtd.re_mul, Zsqrtd.im_mul, Zsqrtd.norm_def]
  congr 1
  ring

/-- The quotient by a principal Gaussian ideal has as many elements as the norm of its
generator, with `Nat.card = 0` for the infinite quotient by the zero ideal. -/
theorem natCard_quotient_span (z : GaussianInt) :
    Nat.card (GaussianInt ⧸ Ideal.span {z}) = z.norm.natAbs := by
  let : Infinite GaussianInt :=
    Infinite.of_injective (fun n : ℤ ↦ (⟨n, 0⟩ : GaussianInt)) fun _ _ h ↦ congrArg Zsqrtd.re h
  rw [← Ideal.absNorm_eq_natCard, absNorm_span]

/-- The ideal above three has norm nine. -/
theorem absNorm_span_three : (Ideal.span {(3 : GaussianInt)}).absNorm = 9 := by
  rw [absNorm_span]
  decide

/-- The ideal generated by `2 + i` has norm five. -/
theorem absNorm_span_two_add_i : (Ideal.span {(⟨2, 1⟩ : GaussianInt)}).absNorm = 5 := by
  rw [absNorm_span]
  decide

/-- The ideal generated by `2 - i` has norm five. -/
theorem absNorm_span_two_sub_i : (Ideal.span {(⟨2, -1⟩ : GaussianInt)}).absNorm = 5 := by
  rw [absNorm_span]
  decide

/-- Three remains prime in the Gaussian integers. -/
theorem isPrime_span_three : (Ideal.span {(3 : GaussianInt)}).IsPrime := by
  let : Fact (Nat.Prime 3) := ⟨by decide⟩
  exact Ideal.isPrime_span_singleton_of_prime (prime_of_nat_prime_of_mod_four_eq_three 3 (by decide))

/-- The Gaussian factor `2 + i` generates a prime ideal. -/
theorem isPrime_span_two_add_i : (Ideal.span {(⟨2, 1⟩ : GaussianInt)}).IsPrime := by
  apply Ideal.isPrime_of_irreducible_absNorm
  rw [absNorm_span_two_add_i]
  exact (Nat.prime_iff.mp (by decide : Nat.Prime 5)).irreducible

/-- The Gaussian factor `2 - i` generates a prime ideal. -/
theorem isPrime_span_two_sub_i : (Ideal.span {(⟨2, -1⟩ : GaussianInt)}).IsPrime := by
  apply Ideal.isPrime_of_irreducible_absNorm
  rw [absNorm_span_two_sub_i]
  exact (Nat.prime_iff.mp (by decide : Nat.Prime 5)).irreducible

/-- The inert prime above three differs from the prime generated by `2 + i`. -/
theorem span_three_ne_span_two_add_i :
    Ideal.span {(3 : GaussianInt)} ≠ Ideal.span {(⟨2, 1⟩ : GaussianInt)} := by
  intro h
  have hn := congrArg Ideal.absNorm h
  rw [absNorm_span_three, absNorm_span_two_add_i] at hn
  contradiction

/-- The inert prime above three differs from the prime generated by `2 - i`. -/
theorem span_three_ne_span_two_sub_i :
    Ideal.span {(3 : GaussianInt)} ≠ Ideal.span {(⟨2, -1⟩ : GaussianInt)} := by
  intro h
  have hn := congrArg Ideal.absNorm h
  rw [absNorm_span_three, absNorm_span_two_sub_i] at hn
  contradiction

/-- The conjugate Gaussian factors of five generate distinct prime ideals. -/
theorem span_two_add_i_ne_span_two_sub_i :
    Ideal.span {(⟨2, 1⟩ : GaussianInt)} ≠ Ideal.span {(⟨2, -1⟩ : GaussianInt)} := by
  intro h
  have hm : (⟨2, 1⟩ : GaussianInt) ∈ Ideal.span {(⟨2, -1⟩ : GaussianInt)} :=
    h ▸ Ideal.mem_span_singleton_self _
  obtain ⟨⟨a, b⟩, hab⟩ := Ideal.mem_span_singleton.mp hm
  have ha := congrArg Zsqrtd.re hab
  have hb := congrArg Zsqrtd.im hab
  norm_num [Zsqrtd.re_mul, Zsqrtd.im_mul] at ha hb
  omega

/-- Every Gaussian integer unit is a fourth root of unity. -/
theorem unit_pow_four (u : GaussianIntˣ) : u ^ 4 = 1 := by
  have aux (z : GaussianInt) (hz : IsUnit z) : z ^ 4 = 1 := by
    obtain ⟨a, b⟩ := z
    have h : a ^ 2 + b ^ 2 = 1 := by
      have hn := (Zsqrtd.norm_eq_one_iff' (d := -1) (by decide) _).mpr hz
      simpa [Zsqrtd.norm_def, pow_two] using hn
    by_cases ha : a = 0
    · subst a
      have hb : b = 1 ∨ b = -1 := sq_eq_one_iff.mp (by simpa using h)
      rcases hb with rfl | rfl <;> decide
    · have hapos : 0 < a ^ 2 := sq_pos_of_ne_zero ha
      have hb : b = 0 := by
        by_contra hb
        have hbpos : 0 < b ^ 2 := sq_pos_of_ne_zero hb
        omega
      subst b
      have ha' : a = 1 ∨ a = -1 := sq_eq_one_iff.mp (by simpa using h)
      rcases ha' with rfl | rfl <;> decide
  exact Units.ext (by simpa using aux (u : GaussianInt) u.isUnit)

end GaussianInt

/-- A ring isomorphism preserves the absolute norms of ideals in Dedekind domains. -/
theorem Ideal.absNorm_map_ringEquiv {R S : Type*} [CommRing R] [CommRing S] [IsDedekindDomain R]
    [IsDedekindDomain S] (e : R ≃+* S) (I : Ideal R) :
    (I.map e.toRingHom).absNorm = I.absNorm := by
  obtain rfl | hI := eq_or_ne I ⊥
  · simp
  have hmap : I.map e.toRingHom ≠ ⊥ :=
    (Ideal.map_eq_bot_iff_of_injective e.injective).not.mpr hI
  rw [Ideal.absNorm_of_ne_bot hmap, Ideal.absNorm_of_ne_bot hI, Submodule.cardQuot_apply,
    Submodule.cardQuot_apply]
  exact Nat.card_congr (Ideal.quotientEquiv I _ e rfl).symm.toEquiv
