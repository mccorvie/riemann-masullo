module

public import RiemannMasullo.ForMathlib.NumberTheory.GaussianInt.PrimeIdeals
public import RiemannMasullo.ForMathlib.NumberTheory.NumberField.Gaussian

/-!
# Gaussian ideal norms in the fourth cyclotomic field

The identification of the Gaussian integers with the full ring of integers transports each
ideal of a prescribed absolute norm. Consequently the ideal-counting coefficients of the
field's Dedekind zeta function can be computed in the coordinate ring `GaussianInt`.
-/

@[expose] public noncomputable section

namespace RiemannMasullo

open NumberField

local notation "K" => CyclotomicField 4 ℚ

/-- Extension along the Gaussian integer-ring isomorphism identifies the ideals of norm `n`. -/
def gaussianNumberField_idealNormFiberEquiv (n : ℕ) :
    {I : Ideal GaussianInt // I.absNorm = n} ≃ {I : Ideal (𝓞 K) // I.absNorm = n} :=
  Gaussian.integersEquiv.idealComapOrderIso.symm.toEquiv.subtypeEquiv fun I ↦ by
    change I.absNorm = n ↔ (I.map Gaussian.integersEquiv.toRingHom).absNorm = n
    rw [Ideal.absNorm_map_ringEquiv]

/-- The number of ideals of norm `n` in the Gaussian number field equals the coordinate count. -/
theorem gaussianNumberField_idealNormFiber_card (n : ℕ) :
    Nat.card {I : Ideal (𝓞 K) // I.absNorm = n} =
      Nat.card {I : Ideal GaussianInt // I.absNorm = n} :=
  Nat.card_congr (gaussianNumberField_idealNormFiberEquiv n).symm

/-- The principal ideal generated by a Gaussian integer in the full integer ring has its
coordinate norm. -/
theorem gaussianNumberField_absNorm_span (z : GaussianInt) :
    (Ideal.span {Gaussian.integersEquiv z}).absNorm = z.norm.natAbs := by
  have h := Ideal.absNorm_map_ringEquiv Gaussian.integersEquiv (Ideal.span {z})
  rw [Ideal.map_span, Set.image_singleton] at h
  exact h.trans (GaussianInt.absNorm_span z)

end RiemannMasullo
